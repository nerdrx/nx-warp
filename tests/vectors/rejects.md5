r18_h22_not_one a03af651f79c682363a2233fa159c3b0 BITSTREAM warp_ext h22 != 2^29
r19_entry_range 644f470d0a6c61a16d7959befb83353e BITSTREAM a warp_ext entry beyond kEntryMax
