# NX Warp v1 rejection vectors.  Generated by tests/ref/vectors.cpp.
# Each stream MUST be refused with exactly the named status, with no
# decoded output.  See docs/SYNTAX.md 12 and Appendix A item 30.
# name  md5  expected_status  why
r01_bad_magic 2b0761ec85434c7f066ce3610f58e75f VERSION magic is not 'NXV1'
r02_unknown_tool 47c0586bc579df0282cc3c14161d9fc7 VERSION a mandatory tool bit the decoder lacks
r03_bit_depth_10 ea5a46e2d190c2921ec076d32a83bdfc UNSUPPORTED bit_depth 10 is reserved in v1
r04_tile_size_32 2891c9ffa4d64aeaa3aed7006de734ad UNSUPPORTED 32x32 tiles are a reserved profile
r05_payload_past_row c13eacbaefbc1a05e7ea9123a9feecca TRUNCATED payload_len runs past the frame
r06_res_level3 de95fa77303049bc0d3e59d12b0b56ec BITSTREAM res_level 3 is reserved
r07_truncated_rans da6227d1c55a47827d876ebb596e6d00 TRUNCATED the tile payload is cut short
r08_skip_bitmap aad16b1a29f75d62cadf324923a2f4d7 BITSTREAM a skip bit for a column past the picture
r09_reserved_tile_bit 65af412f7f4a176b8d597439c425b93b BITSTREAM tile word1 bit 28 is reserved
r10_mode_inter e0094757eabb8b30af39e649cd3da4e4 UNSUPPORTED an INTER tile in a Phase 1 stream
r11_wm_id_no_tool 9c7b00e50d3582d383cfe649ce126d9f BITSTREAM wm_id != 0 without the WM_ID tool bit
r12_row_index_wrong b5853d01562f36d902c8164673a34194 BITSTREAM row_index does not match its position
r13_frame_bytes_short a55f4d7fd29befcfc33d415cbaa11c5c TRUNCATED frame_bytes below the header size
r14_dir_layer_no_tool 6ef4dea53ae8c40d2b8999c5f86d50a9 BITSTREAM frame flags bit 2 without INTRA_DIR
r15_ycocgr_420 f230e23d61601b0265d8fb902af667eb BITSTREAM YCoCg-R declared with 4:2:0 chroma
r16_ctx_v2_short_table 37d3b5732145071db61c6b3ed7eca444 BITSTREAM CTX_V2 table set overruns the tile rows
r17_lossless_sign_hide 3db1a2700262fafdf1593788573e7fde BITSTREAM LOSSLESS and SIGN_HIDE together
# --- Phase 2 (Annex D D-21)
r18_h22_not_one 45abc931d352433e7f3fcfc5fdacae44 BITSTREAM warp_ext h22 != 2^29
r19_entry_range b4c4d747ce5ecc69570588ff698203da BITSTREAM a warp_ext entry beyond kEntryMax
r20_den_range e692af5006b3ffb66339ad7f8af7d7f5 BITSTREAM den leaves [2^28, 2^30) at a picture corner
r21_warp_no_flag 3dc8846d566854cbd076b5f9e11b9cef BITSTREAM a WARP_MV tile with warp_present == 0
r22_mode_reserved dcb5ac76985ee340bd2a0b3f4c41cadf BITSTREAM mode 5 is reserved
r23_intra_ref_sel d4719a5bcb26ffe23ea5cf9b13c0298f BITSTREAM ref_sel != 0 on an INTRA tile
r24_ref_sel_three a10e25b63fe6bfb8fee32136e82ed46c BITSTREAM ref_sel == 3 is reserved
r25_ref_slots_wrong a712cd4942c80e17bfc27af02a5e6ad9 BITSTREAM ref_slots != 1 << (frame_number mod 4)
r26_tool_catmullrom 08767b6937bc81d3d6cb4890f3824e8a VERSION tool bit 23 FILTER_CATMULL_ROM in v1
r27_warp_without_inter 27a88a5d281c3d6aadbdaefd0f602a00 BITSTREAM the WARP tool bit without INTER
r28_stereo_left_eye 16ae46ecec845225051f3fd4fdcbe7fa BITSTREAM mode STEREO on the left eye
r29_disparity_reserved d933c2d46fa3fa3cd5920a676dc9cf76 BITSTREAM disparity bits 15:12 are not zero
