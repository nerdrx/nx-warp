# NX Warp v1 rejection vectors.  Generated by tests/ref/vectors.cpp.
# Each stream MUST be refused with exactly the named status, with no
# decoded output.  See docs/SYNTAX.md 12 and Appendix A item 30.
# name  md5  expected_status  why
r01_bad_magic 19a16ce046dcddf7ba0a7d05b4079865 VERSION magic is not 'NXV1'
r02_unknown_tool 880fb43fd123f6a3c01236d05c660152 VERSION a mandatory tool bit the decoder lacks
r03_bit_depth_10 f6d64a0987cf7bb170ff4582df725acd UNSUPPORTED bit_depth 10 is reserved in v1
r04_tile_size_32 0119a8dd97a4c89f144e6a4b48b496b3 UNSUPPORTED 32x32 tiles are a reserved profile
r05_payload_past_row ca71a68d50361f0f5f3b0c710a19d7b8 TRUNCATED payload_len runs past the frame
r06_res_level3 1f02ec8f9e7cc977b4ff8576534c5f6d BITSTREAM res_level 3 is reserved
r07_truncated_rans 9888673e003b26d753277b1ffb3bf185 TRUNCATED the tile payload is cut short
r08_skip_bitmap dc83361fe81dcf7cb7d31344f4073f45 BITSTREAM a skip bit for a column past the picture
r09_reserved_tile_bit bff37d1a50f246e36f770d114b7883ef BITSTREAM tile word1 bit 28 is reserved
r10_mode_inter e819438ae967da2523ab160cf2736d25 UNSUPPORTED an INTER tile in a Phase 1 stream
r11_wm_id_no_tool 304c920eb74656a1dd1535fccff821f9 BITSTREAM wm_id != 0 without the WM_ID tool bit
r12_row_index_wrong e9c9f69d6606c2f0f06a2a7ab5631e2e BITSTREAM row_index does not match its position
r13_frame_bytes_short 1e3234af219081feba3899acc7a91406 TRUNCATED frame_bytes below the header size
r14_dir_layer_no_tool ddbde9c8488ab809cd60dc88ff0b0823 BITSTREAM frame flags bit 2 without INTRA_DIR
r15_ycocgr_420 770ac5c31279381a6a967386e2120500 BITSTREAM YCoCg-R declared with 4:2:0 chroma
r16_ctx_v2_short_table cd572ff8aca95ee0d34f512dce207221 BITSTREAM CTX_V2 table set overruns the tile rows
r17_lossless_sign_hide f8cfd2ffaea204fa0b71e4755124e7f7 BITSTREAM LOSSLESS and SIGN_HIDE together
# --- Phase 2 (Annex D D-21)
r18_h22_not_one 464c5bbc50f467264d7f3bc8d4363186 BITSTREAM warp_ext h22 != 2^29
r19_entry_range 7f1eec84fa3575cbb2cc9d67678ef2e9 BITSTREAM a warp_ext entry beyond kEntryMax
r20_den_range a66f55491a3c9fc3b9bdddb411d59ba1 BITSTREAM den leaves [2^28, 2^30) at a picture corner
r21_warp_no_flag 57e5a696b34324048ca52141bfbbb50a BITSTREAM a WARP_MV tile with warp_present == 0
r22_mode_reserved e30c72b730fd0927ded99c2ee34a489d BITSTREAM mode 5 is reserved
r23_intra_ref_sel 69be6bccce4caffc12647487e2167ab1 BITSTREAM ref_sel != 0 on an INTRA tile
r24_ref_sel_three 45a30bf01a24c98946581f9cbb796fe8 BITSTREAM ref_sel == 3 is reserved
r25_ref_slots_wrong 7754bf63ead0be8e2efa6518eb624505 BITSTREAM ref_slots != 1 << (frame_number mod 4)
r26_tool_catmullrom 6af99486d9e7b82c8939b6ef731c025d VERSION tool bit 23 FILTER_CATMULL_ROM in v1
r27_warp_without_inter 411fa0a8dfdc9118e8e7b403f21255bb BITSTREAM the WARP tool bit without INTER
r28_stereo_left_eye d39ae5e535763c7d5112ab04a43cf8e2 BITSTREAM mode STEREO on the left eye
r29_disparity_reserved 9631d8bdda8410f3ed6e69b31f5a7497 BITSTREAM disparity bits 15:12 are not zero
