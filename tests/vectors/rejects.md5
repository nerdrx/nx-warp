# NX Warp v1 rejection vectors.  Generated by tests/ref/vectors.cpp.
# Each stream MUST be refused with exactly the named status, with no
# decoded output.  See docs/SYNTAX.md 12 and Appendix A item 30.
# name  md5  expected_status  why
r01_bad_magic 0febb9b2dc175cfd22463dc1f29edf4b VERSION magic is not 'NXV1'
r02_unknown_tool 029a8465fdddb5a0b23055dd35b6bd45 VERSION a mandatory tool bit the decoder lacks
r03_bit_depth_10 f4a1c5bf6626c8dd63c5cea3103e9528 UNSUPPORTED bit_depth 10 is reserved in v1
r04_tile_size_32 e42de31baa5f903861a5352e7d80420a UNSUPPORTED 32x32 tiles are a reserved profile
r05_payload_past_row 3a20966982f373036e8e38000dfc397e TRUNCATED payload_len runs past the frame
r06_res_level3 fb8c6f549beb974f4e030588bce3d812 BITSTREAM res_level 3 is reserved
r07_truncated_rans f37b4f2a60f043db29391d5d40859f12 TRUNCATED the tile payload is cut short
r08_skip_bitmap c49987ed7695f3bc5850a758e823e6a7 UNSUPPORTED a skip bit for a column past the picture
r09_reserved_tile_bit 9e23e34ff94a6523fd85a2b8ab347b6c BITSTREAM tile word1 bit 28 is reserved
r10_mode_inter 65f9f11b834aa1da74f4b2cc2eae897f UNSUPPORTED an INTER tile in a Phase 1 stream
r11_wm_id_no_tool 5bca6e182068a07b74467ea27c9c96b4 BITSTREAM wm_id != 0 without the WM_ID tool bit
r12_row_index_wrong ae90d19b402821081fb0972f9908e24f BITSTREAM row_index does not match its position
r13_frame_bytes_short 5ff32850b3fee3b66c21d7199941354d TRUNCATED frame_bytes below the header size
