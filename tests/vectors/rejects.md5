# NX Warp v1 rejection vectors.  Generated by tests/ref/vectors.cpp.
# Each stream MUST be refused with exactly the named status, with no
# decoded output.  See docs/SYNTAX.md 12 and Appendix A item 30.
# name  md5  expected_status  why
r01_bad_magic c3d3b1c009d54711997ede685f43963c VERSION magic is not 'NXV1'
r02_unknown_tool 6baa878ac49e8636f00c78a1b6a8be07 VERSION a mandatory tool bit the decoder lacks
r03_bit_depth_10 6ff59f5db8acfd9c72e5727b4cba9252 UNSUPPORTED bit_depth 10 is reserved in v1
r04_tile_size_32 0b658a3edbb40a05c2233bd8f8d1072a UNSUPPORTED 32x32 tiles are a reserved profile
r05_payload_past_row de628b45ae5fb08085c3ef7e5ed36298 TRUNCATED payload_len runs past the frame
r06_res_level3 d39f04f8d142abdc5a820e0eb27d8904 BITSTREAM res_level 3 is reserved
r07_truncated_rans 6b267522bf3bd103583e145a58895949 TRUNCATED the tile payload is cut short
r08_skip_bitmap 3bbae345f2d2909857f39874f615d90e BITSTREAM a skip bit for a column past the picture
r09_reserved_tile_bit b191be811e8f30dd2b3c21f704c619eb BITSTREAM tile word1 bit 28 is reserved
r10_mode_inter 861bd76ea9bcb20863506f76f258af31 UNSUPPORTED an INTER tile in a Phase 1 stream
r11_wm_id_no_tool bf144bafb7929efd98ddb81d11b859a5 BITSTREAM wm_id != 0 without the WM_ID tool bit
r12_row_index_wrong 684e11d424d37f139f5e94c387a19e81 BITSTREAM row_index does not match its position
r13_frame_bytes_short a62ed57c4a3fdeb40d55a9a203676d2b TRUNCATED frame_bytes below the header size
r14_dir_layer_no_tool 44d71db11595769afea54d9bc5cd69ef BITSTREAM frame flags bit 2 without INTRA_DIR
r15_ycocgr_420 e33ceec9a35a36c89e31e4d2d96e0bc5 BITSTREAM YCoCg-R declared with 4:2:0 chroma
r16_ctx_v2_short_table c7414927e169b6fead32ae327df86e9e BITSTREAM CTX_V2 table set overruns the tile rows
r17_lossless_sign_hide 78a41980bec206fe30494e9a146e1d45 BITSTREAM LOSSLESS and SIGN_HIDE together
# --- Phase 2 (Annex D D-21)
r18_h22_not_one 45abc931d352433e7f3fcfc5fdacae44 BITSTREAM warp_ext h22 != 2^29
r19_entry_range b4c4d747ce5ecc69570588ff698203da BITSTREAM a warp_ext entry beyond kEntryMax
r20_den_range e692af5006b3ffb66339ad7f8af7d7f5 BITSTREAM den leaves [2^28, 2^30) at a picture corner
r21_warp_no_flag 3dc8846d566854cbd076b5f9e11b9cef BITSTREAM a WARP_MV tile with warp_present == 0
r22_mode_reserved dcb5ac76985ee340bd2a0b3f4c41cadf BITSTREAM mode 5 is reserved
r23_intra_ref_sel d4719a5bcb26ffe23ea5cf9b13c0298f BITSTREAM ref_sel != 0 on an INTRA tile
r24_ref_sel_three a10e25b63fe6bfb8fee32136e82ed46c BITSTREAM ref_sel == 3 is reserved
r25_ref_slots_wrong a712cd4942c80e17bfc27af02a5e6ad9 BITSTREAM ref_slots != 1 << (frame_number mod 4)
r26_tool_catmullrom 08767b6937bc81d3d6cb4890f3824e8a VERSION tool bit 23 FILTER_CATMULL_ROM in v1
r27_warp_without_inter 27a88a5d281c3d6aadbdaefd0f602a00 BITSTREAM the WARP tool bit without INTER
r28_stereo_left_eye 16ae46ecec845225051f3fd4fdcbe7fa BITSTREAM mode STEREO on the left eye
r29_disparity_reserved d933c2d46fa3fa3cd5920a676dc9cf76 BITSTREAM disparity bits 15:12 are not zero
