# NX Warp v1 rejection vectors.  Generated by tests/ref/vectors.cpp.
# Each stream MUST be refused with exactly the named status, with no
# decoded output.  See docs/SYNTAX.md 12 and Appendix A item 30.
# name  md5  expected_status  why
r01_bad_magic 0febb9b2dc175cfd22463dc1f29edf4b VERSION magic is not 'NXV1'
r02_unknown_tool 029a8465fdddb5a0b23055dd35b6bd45 VERSION a mandatory tool bit the decoder lacks
r03_bit_depth_10 f4a1c5bf6626c8dd63c5cea3103e9528 UNSUPPORTED bit_depth 10 is reserved in v1
r04_tile_size_32 e42de31baa5f903861a5352e7d80420a UNSUPPORTED 32x32 tiles are a reserved profile
r05_payload_past_row 3a20966982f373036e8e38000dfc397e TRUNCATED payload_len runs past the frame
r06_res_level3 fb8c6f549beb974f4e030588bce3d812 BITSTREAM res_level 3 is reserved
r07_truncated_rans f37b4f2a60f043db29391d5d40859f12 TRUNCATED the tile payload is cut short
r08_skip_bitmap c49987ed7695f3bc5850a758e823e6a7 BITSTREAM a skip bit for a column past the picture
r09_reserved_tile_bit db9109f67891476c016bd09023c8f938 BITSTREAM tile word1 bit 31 is reserved
r10_mode_inter 65f9f11b834aa1da74f4b2cc2eae897f UNSUPPORTED an INTER tile in a Phase 1 stream
r11_wm_id_no_tool 5bca6e182068a07b74467ea27c9c96b4 BITSTREAM wm_id != 0 without the WM_ID tool bit
r12_row_index_wrong ae90d19b402821081fb0972f9908e24f BITSTREAM row_index does not match its position
r13_frame_bytes_short 5ff32850b3fee3b66c21d7199941354d TRUNCATED frame_bytes below the header size
r14_dir_layer_no_tool 85a9217c99ca1fc8514b5e1856fb79d2 BITSTREAM frame flags bit 2 without INTRA_DIR
r15_ycocgr_420 432322575b1b0f2bb3432b23bc97f790 BITSTREAM YCoCg-R declared with 4:2:0 chroma
r16_ctx_v2_short_table 53e88018c062a097aea2542fdd209d74 BITSTREAM CTX_V2 table set overruns the tile rows
r17_lossless_sign_hide bcf5ebac6266f02562f1252da3cee9ea BITSTREAM LOSSLESS and SIGN_HIDE together
r30_cfl_no_dir_ctx a36804309d44b2e406eb81bc94c943e7 BITSTREAM INTRA_CFL without INTRA_DIR and CTX_V2
r31_split_no_tool 9e23e34ff94a6523fd85a2b8ab347b6c BITSTREAM tile split4x4 without XFORM_4X4_SPLIT
r32_split_with_tskip b563f9bcf2ad24ddada7327a4acb5414 BITSTREAM tile split4x4 together with tskip
r33_tab_v2_no_tables 8393c5da1fe16275edfaf13e35920d95 BITSTREAM TAB_V2 without CUSTOM_TABLES
r34_ctx_v3_no_v2 aa3dc7303646b5e17dbeec43f6153a41 BITSTREAM CTX_V3 without CTX_V2
r35_ctx_v3_short_table b6ee2bef56884815241e5058176e3c8a BITSTREAM CTX_V3 table set overruns the tile rows
r36_xform_size_three 55eab3d38ca3357fe8f9a1a11e4fbe33 BITSTREAM xform_size 3 is reserved
r37_xform_no_tool b7387d7bd7eea4c6e73cfa2294018558 BITSTREAM xform_size != 0 without XFORM_LARGE
r38_xform_with_tskip d92a67d73d2c6b454cba15c72661cb72 BITSTREAM xform_size != 0 on a transform-skip tile
r39_split_with_xform b0f9d5b001b67bdc3db4edf98a0a2c85 BITSTREAM split4x4 with xform_size != 8
# --- Phase 2 (Annex D D-21)
r18_h22_not_one 7f74cfb23676864d7322d1742ca5c25f BITSTREAM warp_ext h22 != 2^29
r19_entry_range a4e233fdd08565efe19368e7a85f8a6c BITSTREAM a warp_ext entry beyond kEntryMax
r20_den_range 9d9670bc3fda56c853478b918108edaf BITSTREAM den leaves [2^28, 2^30) at a picture corner
r21_warp_no_flag 193415e7929e48e4668f908bb2ab620f BITSTREAM a WARP_MV tile with warp_present == 0
r22_mode_reserved 4418d940cddc63a70a2603e0cbc0a7df BITSTREAM mode 5 is reserved
r23_intra_ref_sel 62e8a99deb43210e987f623582a7a7b2 BITSTREAM ref_sel != 0 on an INTRA tile
r24_ref_sel_three b64f957f9215791fafd1f05a995e0ef4 BITSTREAM ref_sel == 3 is reserved
r25_ref_slots_wrong 19cd58f1b44dd2eaf6139752698142b8 BITSTREAM ref_slots != 1 << (frame_number mod 4)
r26_tool_catmullrom 82ab43fa95bee73376064e77b3edf7fd VERSION tool bit 23 FILTER_CATMULL_ROM in v1
r27_warp_without_inter ca8fd45f6cf1a686f0ee2bedd3f37c6f BITSTREAM the WARP tool bit without INTER
r28_stereo_left_eye acf145ec0eb2d7ab249e805421e02ca1 BITSTREAM mode STEREO on the left eye
r29_disparity_reserved 0f994519df8b87dc5d87e9f72ac98efc BITSTREAM disparity bits 15:12 are not zero
