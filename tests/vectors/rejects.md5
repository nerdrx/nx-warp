# NX Warp v1 rejection vectors.  Generated by tests/ref/vectors.cpp.
# Each stream MUST be refused with exactly the named status, with no
# decoded output.  See docs/SYNTAX.md 12 and Appendix A item 30.
# name  md5  expected_status  why
r01_bad_magic ef7725d8eb7838aad8d7320a142595e1 VERSION magic is not 'NXV1'
r02_unknown_tool ce5fc2b2ba022ed9a6ee168f9931a4d8 VERSION a mandatory tool bit the decoder lacks
r03_bit_depth_10 2928721f1b91f3f60a27658949729e33 UNSUPPORTED bit_depth 10 is reserved in v1
r04_tile_size_32 01f60e0cae3abfad86d2998e38e93c85 UNSUPPORTED 32x32 tiles are a reserved profile
r05_payload_past_row f5aaf0300813b665c729e414df800a5d TRUNCATED payload_len runs past the frame
r06_res_level3 8ebb4a0d3364ffa6c37dc3b06aea25d5 BITSTREAM res_level 3 is reserved
r07_truncated_rans 601291c1844fbba389418b008ec679c7 TRUNCATED the tile payload is cut short
r08_skip_bitmap 2710d8565db305b47faee483d7a26581 BITSTREAM a skip bit for a column past the picture
r09_reserved_tile_bit 5a6f5cc7de08122d93f03b7766d0d23c BITSTREAM tile word1 bit 31 is reserved
r10_mode_inter 44a0daeb156a3761966eb4463f80d8e9 UNSUPPORTED an INTER tile in a Phase 1 stream
r11_wm_id_no_tool 011d912790273a0d09c3b67ee39caa9d BITSTREAM wm_id != 0 without the WM_ID tool bit
r12_row_index_wrong 8ca5372647d6225b39607585c45bd930 BITSTREAM row_index does not match its position
r13_frame_bytes_short 02b1c438b1df7931c618bb4b8ec5c507 TRUNCATED frame_bytes below the header size
r14_dir_layer_no_tool 136e81915b8c51591e082b78e6e7c33b BITSTREAM frame flags bit 2 without INTRA_DIR
r15_ycocgr_420 fba29b325abf6b03a17cfba294828c61 BITSTREAM YCoCg-R declared with 4:2:0 chroma
r16_ctx_v2_short_table 4f4f830245607cd5972664a4fd03c316 BITSTREAM CTX_V2 table set overruns the tile rows
r17_lossless_sign_hide 1c46abbc80aded77e02a8071d0a98337 BITSTREAM LOSSLESS and SIGN_HIDE together
r30_cfl_no_dir_ctx 0dcfc2e202af1f4100629ad76ad2f97a BITSTREAM INTRA_CFL without INTRA_DIR and CTX_V2
r31_split_no_tool 986d63e52461e01d5f2d0f38b46667a5 BITSTREAM tile split4x4 without XFORM_4X4_SPLIT
r32_split_with_tskip a2115f557ec9a23887d08e2558f973ec BITSTREAM tile split4x4 together with tskip
r33_tab_v2_no_tables b75db6ef44b06d1b76a44cdf4409a67d BITSTREAM TAB_V2 without CUSTOM_TABLES
r34_ctx_v3_no_v2 c1ac52a1a59f71b07611d5cdb6699838 BITSTREAM CTX_V3 without CTX_V2
r35_ctx_v3_short_table c23986a197d2dc51c7eaccb2d049d6e4 BITSTREAM CTX_V3 table set overruns the tile rows
r36_xform_size_three 0730eca7adccfc5942f58436a11f232b BITSTREAM xform_size 3 is reserved
r37_xform_no_tool a1cf4bf2f4557af1ab87bafdf0a1076d BITSTREAM xform_size != 0 without XFORM_LARGE
r38_xform_with_tskip adfe74bb75f97ececa16b5adc58a5440 BITSTREAM xform_size != 0 on a transform-skip tile
r39_split_with_xform a53380c8941c69766352ee8e9ae90d84 BITSTREAM split4x4 with xform_size != 8
