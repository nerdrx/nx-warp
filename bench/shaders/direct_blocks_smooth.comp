#version 450
// Direct-block sampling surrogate. One output write, no reconstructed source image.
// Real integration must call sampleBlock() from the presentation fragment shader.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,std430) readonly buffer Tiles { uint tile[]; };
layout(set=0,binding=1,std430) readonly buffer Blocks { uint block[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { uint pixel[]; };
layout(push_constant) uniform Push { uint width; uint height; } pc;
uvec3 rgb565(uint v) {
    uvec3 c = uvec3((v>>11)&31u,(v>>5)&63u,v&31u);
    return uvec3((c.r<<3)|(c.r>>2),(c.g<<2)|(c.g>>4),(c.b<<3)|(c.b>>2));
}
uvec3 sampleBlock(uvec2 p) {
    uint descriptor=tile[(p.y/32u)*(pc.width/32u)+p.x/32u];
    uint shift=descriptor>>30;
    uvec2 q=(p%32u)>>shift;
    uint blocksPerRow=4u>>shift;
    uint offset=(descriptor&0x3fffffffu)+5u*((q.y/8u)*blocksPerRow+q.x/8u);
    uint endpoints=block[offset];
    uint index=(q.y%8u)*8u+q.x%8u;
    uint selector=(block[offset+1u+index/16u]>>(2u*(index%16u)))&3u;
    return ((3u-selector)*rgb565(endpoints&65535u)+selector*rgb565(endpoints>>16)+1u)/3u;
}
uvec3 softSample(uvec2 p) {
    uint descriptor=tile[(p.y/32u)*(pc.width/32u)+p.x/32u];
    uint scale=1u<<(descriptor>>30);
    if(scale==1u) return sampleBlock(p); // full-sampling centre stays untouched
    int den=int(scale)*2;
    ivec2 pos=ivec2(p)*2+1-int(scale);
    ivec2 base=ivec2(floor(vec2(pos)/float(den)));
    uvec2 f=uvec2(pos-base*den);
    uvec3 c=uvec3(0);
    for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        ivec2 q=(base+ivec2(x,y))*int(scale);
        // Prevent sampling across the stereo seam.
        int eyeWidth=int(pc.width)/2;
        int eye=int(p.x)/eyeWidth;
        q.x=clamp(q.x,eye*eyeWidth,(eye+1)*eyeWidth-1);
        q.y=clamp(q.y,0,int(pc.height)-1);
        uint wx=x==0?uint(den)-f.x:f.x;
        uint wy=y==0?uint(den)-f.y:f.y;
        c+=sampleBlock(uvec2(q))*wx*wy;
    }
    return (c+uint(den*den)/2u)/uint(den*den);
}
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(p.x>=pc.width || p.y>=pc.height) return;
    uvec3 c=softSample(p);
    pixel[p.y*pc.width+p.x]=c.r|(c.g<<8)|(c.b<<16)|0xff000000u;
}
