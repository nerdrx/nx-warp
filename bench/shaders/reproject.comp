#version 460
// The dummy reprojection pass: one sampler tap and one store per pixel over
// 2 x 2160^2, submitted every vsync so the decoder kernels compete with
// realistic co-tenant work (PAPER 3.4). Shaped after WiVRn's reprojection.glsl.
// Not normative, not timed as a kernel -- it is the load, not the subject.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uSrc;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uDst;

layout(push_constant) uniform Push {
    ivec2 size;
    vec2  jitter;    // varies per frame so nothing can be hoisted or cached away
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y)
        return;

    vec2 uv = (vec2(p) + vec2(0.5) + pc.jitter) / vec2(pc.size);
    imageStore(uDst, p, textureLod(uSrc, uv, 0.0));
}
