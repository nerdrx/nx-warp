diff --git a/tests/bitrate_bbr_nominal_test.cpp b/tests/bitrate_bbr_nominal_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/bitrate_bbr_nominal_test.cpp
@@ -0,0 +1,198 @@
+#include "driver/bitrate_controller.h"
+
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+
+#define require(condition) do { if (!(condition)) { std::fprintf(stderr, "FAIL: %s\n", #condition); std::abort(); } } while (0)
+
+
+using controller = wivrn::bitrate_controller;
+using time_point = controller::clock::time_point;
+constexpr int64_t period = 11'111'111;
+constexpr uint32_t ceiling = 500'000'000;
+
+static uint32_t run(bool nominal, uint32_t wire_bytes, int64_t wire_ns, bool loss = false,
+                    bool scene_change = false, bool duplicate_feedback = false,
+                    bool pass_nominal = true, bool late = false)
+{
+	if (nominal)
+		setenv("NX_DIRECT_NOMINAL_BBR", "1", 1);
+	else
+		unsetenv("NX_DIRECT_NOMINAL_BBR");
+	controller c;
+	c.configure({.enabled = true}, ceiling, true, false, controller::mode::bbr);
+	time_point now = time_point{} + std::chrono::hours(1);
+	for (uint64_t i = 0; i < 360; ++i)
+	{
+		const uint32_t frame_wire = scene_change ? (i & 1 ? 60'000u : 180'000u) : wire_bytes;
+		c.on_frame_bytes(i, 0, frame_wire, now, nominal && pass_nominal ? 694'444u : 0u);
+		wivrn::from_headset::feedback fb{};
+		fb.frame_index = i;
+		fb.stream_index = 0;
+		const XrTime base = 1'000'000'000 + XrTime(i) * period;
+		fb.received_first_packet = base;
+		if (!loss)
+		{
+			fb.received_last_packet = base + wire_ns;
+			fb.sent_to_decoder = base + wire_ns;
+			fb.received_from_decoder = base + wire_ns + period;
+			if (!late)
+			{
+				fb.blitted = base + wire_ns + 2 * period;
+				fb.times_displayed = 1;
+			}
+		}
+		c.on_feedback(fb, period, true, now);
+		if (duplicate_feedback && i == 0)
+			c.on_feedback(fb, period, true, now);
+		now += std::chrono::nanoseconds(period);
+	}
+	return c.current();
+}
+
+static uint32_t physical_estimate(bool nominal)
+{
+	if (nominal)
+		setenv("NX_DIRECT_NOMINAL_BBR", "1", 1);
+	else
+		unsetenv("NX_DIRECT_NOMINAL_BBR");
+	controller c;
+	c.configure({.enabled = true}, ceiling, true, false, controller::mode::bbr);
+	time_point now = time_point{} + std::chrono::hours(1);
+	for (uint64_t i = 0; i < 360; ++i)
+	{
+		c.on_frame_bytes(i, 0, 115'000, now, nominal ? 694'444u : 0u);
+		wivrn::from_headset::feedback fb{};
+		fb.frame_index = i;
+		fb.stream_index = 0;
+		const XrTime base = 1'000'000'000 + XrTime(i) * period;
+		fb.received_first_packet = base;
+		fb.received_last_packet = base + 4'000'000;
+		fb.sent_to_decoder = fb.received_last_packet;
+		fb.received_from_decoder = fb.received_last_packet + period;
+		fb.blitted = fb.received_last_packet + 2 * period;
+		fb.times_displayed = 1;
+		c.on_feedback(fb, period, true, now);
+		now += std::chrono::nanoseconds(period);
+	}
+	return c.bandwidth_estimate();
+}
+
+static void nominal_acute_clamp()
+{
+	setenv("NX_DIRECT_NOMINAL_BBR", "1", 1);
+	controller c;
+	c.configure({.enabled = true}, ceiling, true, false, controller::mode::bbr);
+	time_point now = time_point{} + std::chrono::hours(1);
+	// First establish a low operating point.
+	for (uint64_t i = 0; i < 360; ++i)
+	{
+		c.on_frame_bytes(i, 0, 115'000, now, 694'444u);
+		wivrn::from_headset::feedback fb{};
+		fb.frame_index = i;
+		fb.stream_index = 0;
+		const XrTime base = 1'000'000'000 + XrTime(i) * period;
+		fb.received_first_packet = base;
+		fb.received_last_packet = base + 20'000'000;
+		fb.sent_to_decoder = fb.received_last_packet;
+		fb.received_from_decoder = fb.received_last_packet + period;
+		fb.blitted = fb.received_last_packet + 2 * period;
+		fb.times_displayed = 1;
+		c.on_feedback(fb, period, true, now);
+		now += std::chrono::nanoseconds(period);
+	}
+	const uint32_t before = c.current();
+	now += std::chrono::seconds(3);
+	// Four late, very large nominal samples create an inflated fresh estimate while
+	// retaining an acute congestion signal. The old path could turn that into growth.
+	for (uint64_t i = 360; i < 390; ++i)
+	{
+		c.on_frame_bytes(i, 0, 115'000, now, 4'000'000u);
+		wivrn::from_headset::feedback fb{};
+		fb.frame_index = i;
+		fb.stream_index = 0;
+		const XrTime base = 2'000'000'000 + XrTime(i) * period;
+		fb.received_first_packet = base;
+		fb.received_last_packet = base + 20'000'000;
+		fb.sent_to_decoder = fb.received_last_packet;
+		fb.received_from_decoder = fb.received_last_packet + period;
+		// No blitted timestamp: this feedback is late by construction.
+		c.on_feedback(fb, period, true, now);
+		now += std::chrono::nanoseconds(period);
+	}
+	const uint32_t after = c.current();
+	std::printf("nominal acute clamp before=%u after=%u\n", before, after);
+	require(before < ceiling);
+	require(after <= before);
+}
+
+static void dynamic_replay()
+{
+	setenv("NX_DIRECT_NOMINAL_BBR", "1", 1);
+	controller c;
+	c.configure({.enabled = true}, ceiling, true, false, controller::mode::bbr);
+	time_point now = time_point{} + std::chrono::hours(1);
+	uint32_t healthy = c.current(), bottleneck = healthy;
+	for (uint64_t i = 0; i < 900; ++i)
+	{
+		const uint32_t capacity = i < 180 ? 200'000'000u : (i < 540 ? 20'000'000u : 200'000'000u);
+		const uint32_t nominal = uint32_t(double(c.current()) * double(period) / 1e9 / 8.0 / 1.25);
+		const uint32_t wire = std::max(1u, nominal / 5u);
+		const int64_t receive_ns = std::max<int64_t>(3'000'000, int64_t(double(wire) * 8e9 / capacity));
+		c.on_frame_bytes(i, 0, wire, now, nominal);
+		wivrn::from_headset::feedback fb{};
+		fb.frame_index = i;
+		fb.stream_index = 0;
+		const XrTime base = 2'000'000'000 + XrTime(i) * period;
+		fb.received_first_packet = base;
+		fb.received_last_packet = base + receive_ns;
+		fb.sent_to_decoder = base + receive_ns;
+		fb.received_from_decoder = base + receive_ns + period;
+		fb.blitted = base + receive_ns + 2 * period;
+		fb.times_displayed = 1;
+		c.on_feedback(fb, period, true, now);
+		now += std::chrono::nanoseconds(period);
+		if (i == 179) healthy = c.current();
+		if (i == 539) bottleneck = c.current();
+	}
+	const uint32_t recovered = c.current();
+	std::printf("dynamic nominal trace healthy=%u bottleneck=%u recovered=%u\n", healthy, bottleneck, recovered);
+	require(healthy > 400'000'000);
+	require(bottleneck < healthy / 2);
+	require(recovered > bottleneck);
+}
+
+int main()
+{
+	const uint32_t legacy = run(false, 115'000, 4'000'000);
+	const uint32_t nominal = run(true, 115'000, 4'000'000);
+	require(nominal > legacy);
+	require(nominal > 400'000'000);
+	// Public estimate stays physical in nominal mode: 115 kB over 4 ms is about 230 Mbps,
+	// while the internal codec-budget sample is deliberately much larger.
+	const uint32_t wire_legacy = physical_estimate(false);
+	const uint32_t wire_nominal = physical_estimate(true);
+	require(wire_legacy > 200'000'000 && wire_legacy < 260'000'000);
+	require(wire_nominal > 200'000'000 && wire_nominal < 260'000'000);
+	nominal_acute_clamp();
+
+	// Compression ratio changes do not change nominal quality budget.
+	const uint32_t scene = run(true, 120'000, 4'000'000, false, true);
+	require(scene > 400'000'000);
+	const uint32_t nominal_repeat = run(true, 115'000, 4'000'000);
+	const uint32_t nominal_duplicate = run(true, 115'000, 4'000'000, false, false, true);
+	require(nominal_repeat == nominal_duplicate);
+
+	// Real overload still backs off with nominal accounting.
+	const uint32_t overload = run(true, 115'000, 20'000'000);
+	const uint32_t loss_late = run(true, 115'000, 4'000'000, true, false, false, true, true);
+	require(overload < 400'000'000);
+	require(loss_late < 400'000'000);
+
+	// Ordinary codecs pass zero nominal bytes and retain legacy accounting.
+	const uint32_t ordinary = run(true, 115'000, 4'000'000, false, false, false, false);
+	require(ordinary == legacy);
+	dynamic_replay();
+}
