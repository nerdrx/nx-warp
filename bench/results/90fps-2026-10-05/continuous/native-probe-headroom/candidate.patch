+void native_late_feedback_holds_new_probes()
+{
+	std::printf("Native BBR: display drops hold new probes without loss backoff\n");
+	harness h(mode::bbr, 24e6);
+	const uint32_t steady = h.quiet();
+	uint32_t low = steady, high = steady;
+	for (int i = 0; i < 1800; ++i)
+	{
+		h.feed_frame(false, true);
+		low = std::min(low, h.current());
+		high = std::max(high, h.current());
+	}
+	// Rounding of modeled bytes can move the estimate by a few bits per second.
+	CHECK(high <= steady + 100);
+	CHECK(low + 100 >= steady);
+
+	// Do not latch the hold: clean feedback and returned capacity still recover.
+	h.capacity = 48e6;
+	h.seconds(20);
+	CHECK(near(h.quiet(), settled(48e6)));
+
+	// Decoder-input feedback has times_displayed == 0 too; it is not a drop.
+	harness early(mode::bbr, 24e6);
+	const uint32_t early_steady = early.quiet();
+	uint32_t early_high = early_steady;
+	for (int i = 0; i < 1800; ++i)
+	{
+		const auto bytes = early.frame_bytes();
+		early.feed_raw(bytes, early.wire_ns(bytes), false, false, false);
+		early_high = std::max(early_high, early.current());
+	}
+	CHECK(early_high > early_steady + 1'000'000);
+}
