#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D src;
layout(set=0,binding=1,rgba8) uniform writeonly image2D dst;
float encode(float x) { return x < 0.0031308 ? 12.92*x : 1.055*pow(x,1.0/2.4)-0.055; }
void main() {
 ivec2 p=ivec2(gl_GlobalInvocationID.xy), n=imageSize(dst);
 if(any(greaterThanEqual(p,n))) return;
 vec3 rgb=texelFetch(src,p,0).rgb;
 imageStore(dst,p,vec4(encode(rgb.r),encode(rgb.g),encode(rgb.b),1.0));
}
