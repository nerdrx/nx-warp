+	auto planar_formats = image_formats(encoders[0].bit_depth);
+	std::vector<vk::Format> formats(planar_formats.begin(), planar_formats.end());
+	bool astc_direct_rgb = astc_direct_rgb_enabled(encoders);
+	if (astc_direct_rgb)
