diff --git a/common/pyrowave/shaders/wavelet_dequant.inc b/common/pyrowave/shaders/wavelet_dequant.inc
index 5c3120ca..32757339 100644
--- a/common/pyrowave/shaders/wavelet_dequant.inc
+++ b/common/pyrowave/shaders/wavelet_dequant.inc
@@ -70,9 +70,9 @@ uint read_payload_u16(int coord)
 	return texelFetch(PayloadU16, coord).x;
 }
 
-uint read_payload_u32(int coord)
+uint read_payload_u32(uint coord)
 {
-	return texelFetch(PayloadU32, coord).x;
+	return texelFetch(PayloadU32, int(coord)).x;
 }
 #elif STORAGE_MODE == 2
 uint read_payload_u8(uint coord)
