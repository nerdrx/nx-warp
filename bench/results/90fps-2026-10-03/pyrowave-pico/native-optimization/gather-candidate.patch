+vec2[10] sample_component_gather2(
+		mediump texture2D cb_even, mediump texture2D cb_odd,
+		mediump texture2D cr_even, mediump texture2D cr_odd)
+{
+	vec2 components[10];
+	vec2 gather_uv = vUV + half_texel_offset;
+	vec2 cb_even0, cb_even1, cb_odd0, cb_odd1;
+	vec2 cr_even0, cr_even1, cr_odd0, cr_odd1;
+
+	if (VERTICAL)
+	{
+		cb_even0 = textureGatherOffset(sampler2D(cb_even, uSampler), gather_uv, OFFSET_M1).wx;
+		cb_even1 = textureGatherOffset(sampler2D(cb_even, uSampler), gather_uv, OFFSET_P1).wx;
+		cb_odd0 = textureGatherOffset(sampler2D(cb_odd, uSampler), gather_uv, OFFSET_M2).wx;
+		cb_odd1 = textureGatherOffset(sampler2D(cb_odd, uSampler), gather_uv, OFFSET_C).wx;
+		cr_even0 = textureGatherOffset(sampler2D(cr_even, uSampler), gather_uv, OFFSET_M1).wx;
+		cr_even1 = textureGatherOffset(sampler2D(cr_even, uSampler), gather_uv, OFFSET_P1).wx;
+		cr_odd0 = textureGatherOffset(sampler2D(cr_odd, uSampler), gather_uv, OFFSET_M2).wx;
+		cr_odd1 = textureGatherOffset(sampler2D(cr_odd, uSampler), gather_uv, OFFSET_C).wx;
+	}
+	else
+	{
+		cb_even0 = textureGatherOffset(sampler2D(cb_even, uSampler), gather_uv, OFFSET_M1).wz;
+		cb_even1 = textureGatherOffset(sampler2D(cb_even, uSampler), gather_uv, OFFSET_P1).wz;
+		cb_odd0 = textureGatherOffset(sampler2D(cb_odd, uSampler), gather_uv, OFFSET_M2).wz;
+		cb_odd1 = textureGatherOffset(sampler2D(cb_odd, uSampler), gather_uv, OFFSET_C).wz;
+		cr_even0 = textureGatherOffset(sampler2D(cr_even, uSampler), gather_uv, OFFSET_M1).wz;
+		cr_even1 = textureGatherOffset(sampler2D(cr_even, uSampler), gather_uv, OFFSET_P1).wz;
+		cr_odd0 = textureGatherOffset(sampler2D(cr_odd, uSampler), gather_uv, OFFSET_M2).wz;
+		cr_odd1 = textureGatherOffset(sampler2D(cr_odd, uSampler), gather_uv, OFFSET_C).wz;
+	}
+
+	components[0] = vec2(0.0);
+	components[1] = vec2(cb_odd0.x, cr_odd0.x);
+	components[2] = vec2(cb_even0.x, cr_even0.x);
+	components[3] = vec2(cb_odd0.y, cr_odd0.y);
+	components[4] = vec2(cb_even0.y, cr_even0.y);
+	components[5] = vec2(cb_odd1.x, cr_odd1.x);
+	components[6] = vec2(cb_even1.x, cr_even1.x);
+	components[7] = vec2(cb_odd1.y, cr_odd1.y);
+	components[8] = vec2(cb_even1.y, cr_even1.y);
+	components[9] = vec2(
+			textureLodOffset(sampler2D(cb_odd, uSampler), vUV, 0.0, OFFSET_P2).x,
+			textureLodOffset(sampler2D(cr_odd, uSampler), vUV, 0.0, OFFSET_P2).x);
+
+	return components;
+}
