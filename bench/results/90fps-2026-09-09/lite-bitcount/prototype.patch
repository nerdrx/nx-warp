+// Count significance flags in bounded chunks. lite_get's four-byte funnel
+// permits at most 24 bits at any byte alignment (24 + 7 < 32).
+int lite_count_flags(uint bitpos, int count) {
+    int result = 0;
+    for (int p = 0; p < count; p += 24) {
+        uint width = uint(min(24, count - p));
+        result += bitCount(lite_get(bitpos + uint(p), width));
+    }
+    return result;
+}
+
