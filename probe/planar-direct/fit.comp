#version 460
// Approximate forced PLANAR R=2/coarse fit proof.  Input is the encoder's
// tile-major packed Y,Co,Cg buffer (two signed int16 samples per uint), with
// 2048 Y words then 512 words per chroma plane per tile.  It deliberately uses
// zero slopes: this is a valid body and a cheap GPU fallback, not the
// byte-identical host least-squares fit.
#extension GL_GOOGLE_include_directive : require
#include "nxe_enc_common.glsl"
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Bodies { uint body[]; };
layout(push_constant) uniform PC { uint width, height, qp, chromaQPOffset; } pc;
shared int cy[64], cu[64], cv[64];
shared int gy, gu, gv, qy0, qy1, qu0, qu1, qv0, qv1;

int read_sample(uint base, uint i) {
    uint w = src[base + (i >> 1u)];
    return ((i & 1u) == 0u) ? int(w << 16) >> 16 : int(w) >> 16;
}
int clamp8(int v) { return clamp(v, -128, 127); }
int quant(int v, int off, int step) {
    int d = v - off;
    int n = d >= 0 ? d * 16 + step / 2 : d * 16 - step / 2;
    return clamp8(n / step);
}
void main() {
    uint tile = gl_WorkGroupID.x, lid = gl_LocalInvocationID.x;
    nxe_init_tables(lid, 256u);
    barrier();
    uint tx = (pc.width + 63u) / 64u, ty = (pc.height + 63u) / 64u;
    uint nt = tx * ty;
    if (tile >= nt) return;
    uint ybase = tile * 2048u, cbase = nt * 2048u + tile * 512u;
    if (lid < 64u) {
        uint cell = lid, cx = cell & 7u, cy0 = cell >> 3u;
        int sy = 0, su = 0, sv = 0;
        for (uint j = 0u; j < 8u; ++j)
            for (uint i = 0u; i < 8u; ++i)
                sy += read_sample(ybase, (cy0 * 8u + j) * 64u + cx * 8u + i);
        for (uint j = 0u; j < 4u; ++j)
            for (uint i = 0u; i < 4u; ++i) {
                uint ci = (cy0 * 4u + j) * 32u + cx * 4u + i;
                su += read_sample(cbase, ci);
                sv += read_sample(cbase + nt * 512u, ci);
            }
        cy[cell] = (sy + 32) / 64;
        cu[cell] = (su + 8) / 16;
        cv[cell] = (sv + 8) / 16;
    }
    barrier();
    if (lid == 0u) {
        gy = gu = gv = 0;
        for (int i = 0; i < 64; ++i) { gy += cy[i]; gu += cu[i]; gv += cv[i]; }
        gy = (gy + 32) / 64; gu = (gu + 32) / 64; gv = (gv + 32) / 64;
        int sy0 = 0, sy1 = 0, su0 = 0, su1 = 0, sv0 = 0, sv1 = 0;
        int n0 = 0, n1 = 0;
        for (int i = 0; i < 64; ++i) {
            if (cy[i] < gy) { sy0 += cy[i]; su0 += cu[i]; sv0 += cv[i]; ++n0; }
            else { sy1 += cy[i]; su1 += cu[i]; sv1 += cv[i]; ++n1; }
        }
        // Empty regions fall back to the global mean, keeping the body valid.
        sy0 = n0 != 0 ? (sy0 + n0 / 2) / n0 : gy;
        sy1 = n1 != 0 ? (sy1 + n1 / 2) / n1 : gy;
        su0 = n0 != 0 ? (su0 + n0 / 2) / n0 : gu;
        su1 = n1 != 0 ? (su1 + n1 / 2) / n1 : gu;
        sv0 = n0 != 0 ? (sv0 + n0 / 2) / n0 : gv;
        sv1 = n1 != 0 ? (sv1 + n1 / 2) / n1 : gv;
        int stepY = nxe_dequant_step(int(pc.qp) >> 1, 16);
        int stepC = nxe_dequant_step(clamp(int(pc.qp) + int(pc.chromaQPOffset), 0, 63) >> 1, 16);
        qy0 = quant(sy0, 128, stepY); qy1 = quant(sy1, 128, stepY);
        qu0 = quant(su0, 128, stepC); qu1 = quant(su1, 128, stepC);
        qv0 = quant(sv0, 128, stepC); qv1 = quant(sv1, 128, stepC);
    }
    barrier();
    if (lid == 0u) {
        uint dst = tile * 26u;
        for (uint i = 0u; i < 26u; ++i) body[dst + i] = 0u;
        body[dst] = 0u; // R=2, coarse 8x8 bitmap form
        uint map0 = 0u, map1 = 0u;
        for (uint i = 0u; i < 64u; ++i)
            if (cy[i] >= gy) {
                if (i < 32u) map0 |= 1u << i;
                else map1 |= 1u << (i - 32u);
            }
        body[dst + 1u] = map0; body[dst + 2u] = map1;
        uint c0 = uint(qy0 & 255) | (uint(qu0 & 255) << 24);
        uint c1 = uint(qv0 & 255) << 16;
        uint c2 = uint(qy1 & 255) << 8;
        uint c3 = uint(qu1 & 255) | (uint(qv1 & 255) << 24);
        uint c4 = 0u;
        body[dst + 17u] = c0; body[dst + 18u] = c1;
        body[dst + 19u] = c2; body[dst + 20u] = c3; body[dst + 21u] = c4;
    }
}
