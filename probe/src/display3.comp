#version 450
// The same display pass as display.comp, but with the atlas held as THREE
// separate single-channel planes (Y, Co, Cg) instead of one three-channel
// texture -- which is how ADR-0029's atlas is laid out today, since a
// RefPicture is planar.
//
// This is the comparison that decides whether "texture-native" buys anything
// beyond bytes: a hardware-compressed atlas delivers Y, Co and Cg in ONE
// filtered tap, where a planar atlas needs three.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uY;
layout(set = 0, binding = 3) uniform sampler2D uCo;
layout(set = 0, binding = 4) uniform sampler2D uCg;
layout(set = 0, binding = 1, rgba8ui) uniform writeonly uimage2D uOut;
layout(set = 0, binding = 2, std430) readonly buffer Tiles { vec4 h[]; } uT;

layout(push_constant) uniform Push {
    ivec2 outSize;
    ivec2 atlasSize;
    int   tilesX;
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.outSize.x || p.y >= pc.outSize.y)
        return;

    int t = ((p.y >> 6) * pc.tilesX + (p.x >> 6)) * 3;
    vec3 q = vec3(float(p.x) + 0.5, float(p.y) + 0.5, 1.0);
    vec3 s = vec3(dot(uT.h[t].xyz, q), dot(uT.h[t + 1].xyz, q), dot(uT.h[t + 2].xyz, q));
    vec2 uv = (s.xy / s.z) / vec2(pc.atlasSize);

    // three taps, three planes
    float Y  = textureLod(uY,  uv, 0.0).r;
    float Co = textureLod(uCo, uv, 0.0).r - 0.5;
    float Cg = textureLod(uCg, uv, 0.0).r - 0.5;

    // YCoCg-R inverse, the codec's own colour transform, in float because this
    // pass is non-normative
    float tmp = Y - Cg * 0.5;
    float g = Cg + tmp;
    float b = tmp - Co * 0.5;
    float r = b + Co;
    imageStore(uOut, p, uvec4(clamp(ivec4(vec4(r, g, b, 1.0) * 255.0 + 0.5), 0, 255)));
}
