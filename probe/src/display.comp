#version 450
// The atlas display pass, reduced to exactly what ADR-0029 section 5 specifies
// and nothing else: one warp step from the atlas, per-tile homography from a
// small table, bilinear by the hardware sampler. Non-normative by construction,
// so float is allowed here.
//
// The point of this shader is that it is IDENTICAL for every atlas format --
// the only thing that changes between runs is the VkFormat of uAtlas. Whatever
// difference the measurement shows is the sampler's cost of that format.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uAtlas;
layout(set = 0, binding = 1, rgba8ui) uniform writeonly uimage2D uOut;
layout(set = 0, binding = 2, std430) readonly buffer Tiles {
    vec4 h[];      // 3 x vec4 per tile: rows of the 3x3, w unused
} uT;

layout(push_constant) uniform Push {
    ivec2 outSize;
    ivec2 atlasSize;
    int   tilesX;
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.outSize.x || p.y >= pc.outSize.y)
        return;

    int t = ((p.y >> 6) * pc.tilesX + (p.x >> 6)) * 3;
    vec3 q = vec3(float(p.x) + 0.5, float(p.y) + 0.5, 1.0);
    vec3 s = vec3(dot(uT.h[t].xyz, q), dot(uT.h[t + 1].xyz, q), dot(uT.h[t + 2].xyz, q));
    vec2 src = s.xy / s.z;

    vec4 c = textureLod(uAtlas, src / vec2(pc.atlasSize), 0.0);
    imageStore(uOut, p, uvec4(clamp(ivec4(c * 255.0 + 0.5), 0, 255)));
}
