#version 460
// NX Warp Windows interop probe: trivial compute kernel.
//
// Writes a deterministic checkerboard into an image that was imported from a
// D3D11 shared NT-handle texture. The pattern is chosen so that every byte is
// exactly representable through the UNORM round trip (multiples of 16, plus
// 255 and 32), which lets the D3D11 side verify the readback byte for byte.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint frame;   // iteration counter, unused by the pattern (kept for future use)
    uint pad;
} pc;

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.width || gid.y >= pc.height)
        return;

    uint cx = gid.x >> 6;   // 64x64 cells: the codec tile size (paper 6.2)
    uint cy = gid.y >> 6;

    float r = (((cx + cy) & 1u) != 0u) ? (255.0 / 255.0) : (32.0 / 255.0);
    float g = float((cx & 15u) * 16u) / 255.0;
    float b = float((cy & 15u) * 16u) / 255.0;

    imageStore(dst, ivec2(gid), vec4(r, g, b, 1.0));
}
