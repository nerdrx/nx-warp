// Present pass: 2-plane 4:2:0 YCbCr -> RGBA, ready for the blit to the swapchain.
//
// The decoder emits YCbCr because that is what the real codec produces and what
// the WiVRn NX client already samples out of MediaCodec (PAPER 3.5). A plain
// Android swapchain is RGB, so somebody has to convert; in the real integration
// that somebody is WiVRn's reprojection pass, which samples the decoder's planes
// through a VkSamplerYcbcrConversion. This shell does the same job explicitly so
// that the conversion is visible and cheap to reason about.
//
// The planes are read as SAMPLED images rather than storage images on purpose:
// sampled R8_UNORM and R8G8_UNORM support is mandatory in Vulkan, whereas
// *storage* support for them needs shaderStorageImageExtendedFormats. Only the
// decoder's write side needs that feature, and only for its own two images.
// Reading the chroma plane through a linear sampler also gives the 4:2:0
// upsample for free.
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D u_luma;    // R8_UNORM,  full res
layout(binding = 1) uniform sampler2D u_chroma;  // R8G8_UNORM, half res
layout(binding = 2, rgba8) uniform writeonly image2D u_rgba;

layout(push_constant) uniform PC {
    uvec2 img;   // luma / output size in pixels
} pc;

// Inverse of the full-range BT.709 matrix in tiles.comp.
vec3 ycbcr_to_rgb(float y, float cb, float cr) {
    cb -= 0.5;
    cr -= 0.5;
    return vec3(y + 1.5748 * cr,
                y - 0.1873 * cb - 0.4681 * cr,
                y + 1.8556 * cb);
}

void main() {
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.img.x || p.y >= pc.img.y) return;

    // Sample both planes at the same normalised position; the chroma plane is
    // half the size, so its own sampler does the 4:2:0 upsample.
    const vec2 uv = (vec2(p) + 0.5) / vec2(pc.img);

    const float y  = texture(u_luma, uv).r;
    const vec2  cc = texture(u_chroma, uv).rg;

    imageStore(u_rgba, ivec2(p), vec4(clamp(ycbcr_to_rgb(y, cc.x, cc.y), 0.0, 1.0), 1.0));
}
