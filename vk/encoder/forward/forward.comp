#version 460
// forward.comp -- E3: prediction, residual, forward transform, quantisation.
//
// SPDX-License-Identifier: Apache-2.0
//
// Paper 3.6's E2 "transform" pass, renamed to E3 to match the E0..E5 lettering
// the rest of this directory uses.  One workgroup of 64 lanes per 64x64 tile.
// Per coded plane:
//
//   1. block means            one lane per 8x8 block, an exact integer sum
//   2. the DC plane           forward transform (nb == 8), dead-zone quantise,
//                             sign hiding, then dequantise and inverse
//                             transform -- the decoder's own reconstruction,
//                             because the encoder must predict from what the
//                             decoder will see and nothing else
//   3. the prediction         bilinear over the reconstructed block means.
//                             It is never materialised: `pred_at` recomputes
//                             it from the 64 means in LDS, which is cheaper
//                             than the 16 KB of shared memory a 64x64 plane
//                             would cost and is bit-identical
//   4. residual blocks        eight blocks at a time, each an 8x8 forward DCT
//                             through LDS: lane (b, r) transforms row r of
//                             block b, the workgroup transposes in shared
//                             memory, and the same lanes transform again
//
// With NXE_SC_INTRA_DIR the blocks instead go in raster order, each one
// predicted from the tile's own running reconstruction (docs/SYNTAX.md 7.4),
// with the per-block modes supplied by the host rather than searched here.
//
// Bit-exactness: every step is the integer arithmetic of `forward_cpu.c` in
// the same order.  The only reduction is the block-mean sum, which one lane
// does serially, so there is not even an ordering question to answer.

#extension GL_GOOGLE_include_directive : require
#include "nxe_enc_common.glsl"

layout(local_size_x = NXE_E3_WG, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ParamBuf { nxe_frame_params fp; };
layout(std430, binding = 1) readonly buffer JobBuf   { nxe_tile_job jobs[]; };
// Tile-major packed planes, two int16 samples per word (vk/encoder/README.md).
layout(std430, binding = 2) readonly buffer SrcBuf   { uint v[]; } srcb;
// Coefficients, two int16 levels per word, NXE_TILE_COEF_WORDS per tile.
layout(std430, binding = 3)          buffer CoefBuf  { uint v[]; } coefb;
// Per-block intra modes, four per word, 3*64 per tile.  Read only when
// NXE_SC_INTRA_DIR is 1.
layout(std430, binding = 4) readonly buffer ModeBuf  { uint v[]; } modeb;
// Pass W's predictor, i16 packed two per uint at the decoder's own stride.
// THIS is the binding nxe_enc.h once claimed already existed.  A coded inter
// tile subtracts it here, and Pass B adds exactly the same samples back on the
// decode side -- which is the whole contract: E3 must subtract what Pass B
// will add, or the two disagree about what the residual means.
layout(std430, binding = 5) readonly buffer WPredBuf { uint v[]; } wpredb;

// ----------------------------------------------------------- effort 2 only
// The trellis's rate model: Q10 bits per (table set, context, symbol), built
// on the host from the frame's probability tables with nxe_neglog2_q10.  The
// device never computes a log; the table IS the log.  8 * 32 * 16 ints.
layout(std430, binding = 6) readonly buffer RateBuf { int v[]; } rateb;
// Per (tile, group, scan position): the three state costs and the best
// nonzero, as 64-bit pairs.  In a buffer rather than shared memory because a
// 64-position trellis for eight blocks is 24 kB and this shader already spends
// most of its shared allocation on the directional predictor's reconstruction.
// E4 stages its operation lists the same way.
layout(std430, binding = 7) buffer TrelFBuf { uvec2 v[]; } trelf;
// The magnitudes those costs chose: three per state plus the nonzero one.
layout(std430, binding = 8) buffer TrelMBuf { int v[]; } trelm;

#define NXE_TREL_POS   64
#define NXE_TREL_GROUP (NXE_TREL_POS * 4)
#define RATE_AT(set, ctx, sym) rateb.v[(set) * 32 * 16 + (ctx) * 16 + (sym)]
// Whether a zero is never dearer than a one in any context of this table set.
// The `hi` bound below rests on it: the distortion half of "everything above
// hi is provably zero" is an identity, the RATE half is a property of the
// TABLE, and a transmitted set is whatever the frame chose to send.  So it is
// computed once per set on the host and read here, exactly as
// `RateCost::zero_cheapest` is on the CPU side.  Assuming it -- which this
// shader did at first -- costs nothing with the built-in tables and diverges
// on a trained one, which is a bug that only appears with CUSTOM_TABLES on.
#define RATE_ZC(set) rateb.v[8 * 32 * 16 + (set)]

// ------------------------------------------------------------ shared state
shared int s_means[64];        // block means, then the reconstructed means
shared int s_dca[64], s_dcb[64];
shared int s_dcq[64];          // DC plane quantised levels
shared int s_dco[64];          // DC plane unquantised values (SDH input)
shared int s_blk[8][64];       // transform scratch, one row-transposed block
shared int s_orig[8][64];      // unquantised coefficients
shared int s_q[8][64];         // quantised levels

// Directional intra only.  Sized by the specialization constant so a build
// with NXE_SC_INTRA_DIR = 0 pays nothing for it: 16 KB of LDS is the
// difference between two and eight workgroups in flight per SIMD.
shared int s_recon[NXE_SC_INTRA_DIR * 4096 + 1];
shared int s_refA[NXE_SC_INTRA_DIR * 17 + 1];
shared int s_refL[NXE_SC_INTRA_DIR * 17 + 1];
shared int s_P[NXE_SC_INTRA_DIR * 64 + 1];
shared int s_tgt[NXE_SC_INTRA_DIR * 64 + 1];
shared int s_res[NXE_SC_INTRA_DIR * 64 + 1];

// -------------------------------------------------------- per-tile globals
// Set once at the top of main() and once per plane; every helper reads them.
uint g_tile;
int  g_size, g_nb, g_ndc, g_qp, g_maxval, g_dcoff, g_tskip, g_sdh;
// 1 when this tile predicts from the warp: its residual is against wpred and
// its DC plane codes the means of that residual.
int  g_inter;
uint g_wpredbase;
int  g_wmsel;          // -1 = the frame matrix, else a built-in index
bool g_chroma;
uint g_srcbase;        // first word of this tile's plane
int  g_coefoff;        // first level of this plane inside the tile slot
uint g_coefbase;       // first word of this tile's coefficient slot

int wm_at(int i) {
    if (g_wmsel < 0)
        return int(g_chroma ? fp.wm_chroma[i] : fp.wm_luma[i]);
    return nxe_weight[g_wmsel * 64 + i];
}
int step_at(int i) {
    return g_tskip != 0 ? nxe_dequant_step(g_qp, 16)
                        : nxe_dequant_step(g_qp, wm_at(i));
}

// One predictor sample of the current plane.  Zero on an intra tile, where
// nothing reads it -- an intra stream binds a 4-byte placeholder.
int wpred_at(int i) {
    if (g_inter == 0) return 0;
    uint w = g_wpredbase + uint(i >> 1);
    w = min(w, uint(wpredb.v.length()) - 1u);
    return int((wpredb.v[w] >> ((uint(i) & 1u) * 16u)) & 0xffffu);
}

int sample_at(int i) {
    uint w = g_srcbase + uint(i >> 1);
    w = min(w, uint(srcb.v.length()) - 1u);
    return nxe_unpack16(srcb.v[w], i & 1);
}

// The bilinear DC-plane prediction, recomputed from the 64 reconstructed means
// rather than stored.  bilinear_q4_i32(means, nb, nb, nb, 2x-7, 2y-7).
int pred_at(int x, int y) {
    int sx = 2 * x - 7, sy = 2 * y - 7;
    int x0 = sx >> 4, y0 = sy >> 4;
    int fx = sx & 15, fy = sy & 15;
    int x1 = nxe_clamp(x0 + 1, 0, g_nb - 1), y1 = nxe_clamp(y0 + 1, 0, g_nb - 1);
    x0 = nxe_clamp(x0, 0, g_nb - 1);
    y0 = nxe_clamp(y0, 0, g_nb - 1);
    int p00 = s_means[y0 * g_nb + x0], p01 = s_means[y0 * g_nb + x1];
    int p10 = s_means[y1 * g_nb + x0], p11 = s_means[y1 * g_nb + x1];
    int wx0 = 16 - fx, wy0 = 16 - fy;
    const int planar = (p00 * wx0 * wy0 + p01 * fx * wy0 + p10 * wx0 * fy +
                        p11 * fx * fy + 128) >> 8;
    if (g_inter == 0) return planar;
    // codec.cpp planar_from_means(): an inter tile's prediction is the warp
    // plus the DC plane's planar correction, offset back and clamped once.
    //     pred = clamp(wpred + planar(means) - dc_offset, 0, maxval)
    return nxe_clamp(wpred_at(y * g_size + x) + planar - g_dcoff, 0, g_maxval);
}

// ------------------------------------------------------- sign data hiding
// forward_cpu.c's nxe_hide_sign_unit.  The candidate comparison is the exact
// integer form derived there: 256 * cost = -d * step * (32a - (2m+d)*step),
// formed as a 64-bit product with imulExtended so no int64 type is needed.
bool cost_less(int a_hi, int a_lo, int b_hi, int b_lo) {
    if (a_hi != b_hi) return a_hi < b_hi;
    return uint(a_lo) < uint(b_lo);
}

// --------------------------------------------------------- effort 2: RDOQ
//
// nxe_trellis.c's nxe_rdoq_unit_int, transcribed.  ref/src/codec.cpp is the
// specification of both; `vk.encoder.acid.trellis` requires this and
// `nxv-enc --int-trellis 1 --rdoq-effort 3` to agree byte for byte.
//
// ONE LANE PER BLOCK.  The trellis is a serial walk over the scan, so lane
// r == 0 of each group entry runs its whole block while the other seven wait
// at the barrier that follows.  That is not a waste of the group: the eight
// entries run eight blocks at once, and the plane's sixty-four blocks are
// eight rounds of eight, which is exactly the neighbour chain -- block b
// conditions on block b - 8, and entry g owns blocks g, g + 8, g + 16 ...
// So the chain is per entry and carries in a register across the rounds; no
// lane ever reads another lane's class.
//
// `uc_*` are the tile's contexts.  s_uc_cbf/s_uc_last are per entry because
// v3 shifts them by the entry's own neighbour class.
shared int s_uc_cbf[8], s_uc_last[8];
// The neighbour class each BLOCK of this plane published, indexed by block.
// Per block and not per group entry because the chain reaches back `nlanes`
// blocks and `nlanes` is 8, 16 or 32 -- entry g owns g, g+8, g+16 ..., so at
// 8 lanes the predecessor is the entry's own previous round and at 16 or 32 it
// is two or four rounds back.  Either way it is already written.  Below 8 it
// would be inside the CURRENT round, which this eight-blocks-in-flight shape
// cannot satisfy; the library refuses effort 2 there rather than pretend.
shared int s_nbr[64];
int g_uc_ucls, g_uc_v3, g_uc_fixed, g_uc_bshift;
int g_trel_set, g_trel_base, g_nlanes;
uint g_trel_lam, g_trel_dclam;

// nxe_block_ctx / nxe_dc_ctx, for the plane this invocation is on.
void trellis_ctx_block(int chroma) {
    g_uc_ucls = chroma != 0 ? NXE_UCLS_CHROMA : NXE_UCLS_LUMA;
    g_uc_v3 = fp.nctx >= uint(NXE_NCTX_V3) ? 1 : 0;
    g_uc_fixed = NXE_CTX_NONE;
    g_uc_bshift = 0;   // 8x8 only: last_shift_of(64) is 0
}
void trellis_ctx_dc() {
    g_uc_ucls = NXE_UCLS_DC;
    g_uc_v3 = fp.nctx >= uint(NXE_NCTX_V3) ? 1 : 0;
    g_uc_fixed = fp.nctx >= uint(NXE_NCTX_V2) ? NXE_CTX_LEVEL_DC : NXE_CTX_NONE;
    g_uc_bshift = 0;
}
// with_nbr: v3 shifts CBF and LAST by the entry's class, nothing else moves.
void trellis_nbr(int g, int base_cbf, int base_last, int nbr) {
    if (g_uc_v3 == 0) { s_uc_cbf[g] = base_cbf; s_uc_last[g] = base_last; return; }
    s_uc_cbf[g] = nxe_v3_ctx_cbf(g_uc_ucls, nbr);
    s_uc_last[g] = nxe_v3_ctx_last(g_uc_ucls, nbr);
}

int uc_level_markov() {
    if (g_uc_ucls == NXE_UCLS_DC) return 0;
    return g_uc_fixed == NXE_CTX_NONE ? 1 : 0;
}

int uc_level(int scan_pos, int last, int prev_class) {
    int bp = scan_pos >> g_uc_bshift;
    if (g_uc_v3 != 0)
        return nxe_v3_ctx_level(g_uc_ucls, scan_pos, bp, last, prev_class);
    return g_uc_fixed != NXE_CTX_NONE ? g_uc_fixed
                                      : nxe_level_ctx(bp, prev_class);
}

int level_rate(int set, int scan_pos, int last, int prev_class, int m) {
    int ctx = uc_level(scan_pos, last, prev_class);
    int r = RATE_AT(set, ctx, m > 14 ? NXE_ESC_SYM : m);
    if (m > 14) r += nxe_escape_bits(m) << 10;
    if (m != 0) r += 1 << 10;
    return r;
}

// `unit` as in hide_sign_unit below: 0 the DC plane, 1..8 the block entry.
// `base` is this tile's slot in the trellis scratch, in positions.
void rdoq_unit_int(int unit, int ncoef, bool tskip, int const_step, int set,
                   uint lam, int base, int cbf_ctx, int last_ctx, int sdh) {
    int p, sc, k;
    for (p = 0; p < ncoef; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        if (unit == 0) s_dcq[idx] = 0; else s_q[unit - 1][idx] = 0;
    }

    // The provable bound: above the highest position whose magnitude reaches
    // half a step, zero beats one in distortion AND in rate, so those
    // positions are never searched.  The rate half holds only if the table
    // agrees (RATE_ZC); when it does not, every position is searched -- a
    // slower trellis, not a wrong one.
    int hi = -1;
    nxe_i64 energy = nxe_i64(0u, 0u);
    for (p = 0; p < ncoef; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int c = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        int a = c < 0 ? -c : c;
        int st = const_step > 0 ? const_step : step_at(idx);
        energy = nxe_i64_add(energy, nxe_i64_sq_shl18(c));
        if (32 * a >= st) hi = p;
    }
    if (hi < 0 || RATE_ZC(set) == 0) hi = hi < 0 ? -1 : ncoef - 1;
    if (hi < 0) return;

    nxe_i64 prev0 = nxe_i64(0u, 0u), prev1 = prev0, prev2 = prev0;
    for (p = 0; p <= hi; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int c = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        int a = c < 0 ? -c : c;
        int st = const_step > 0 ? const_step : step_at(idx);
        int m0 = st > 0 ? int((uint(a) * 16u) / uint(st)) : 0;
        if (m0 > 32767) m0 = 32767;

        for (sc = 0; sc < 3; ++sc) {
            nxe_i64 best = nxe_i64(0xFFFFFFFFu, 0x1FFFFFFFu);
            nxe_i64 bestnz = best;
            int bm = 0, bmnz = -1;
            bool have = false, havenz = false;
            // The candidate set, in the order nxe_trellis.c fills `cand[]`:
            // 0, then m0-1, m0, m0+1 with the invalid ones skipped.  Written
            // as four fixed slots rather than a local array because a local
            // array with a dynamic index can be spilled to scratch memory --
            // `shader-lint: dynamic-local-array-index`.  The ORDER is the
            // tie-break (the first equal cost wins), so it is preserved
            // exactly; NXE_RDOQ_FULL is the only effort the library allows.
            for (k = 0; k < 4; ++k) {
                int m;
                bool valid;
                if (k == 0) { m = 0; valid = true; }
                else if (k == 1) { m = m0 - 1; valid = m0 >= 2; }
                else if (k == 2) { m = m0; valid = m0 > 0; }
                else { m = m0 + 1; valid = m0 + 1 <= 32767; }
                if (!valid) continue;
                int d = a - nxe_dequant(m, st);
                nxe_i64 dd = nxe_i64_sq_shl18(d);
                int lc = uc_level_markov() != 0 ? nxe_level_class(m) : 0;
                nxe_i64 chain = lc == 0 ? prev0 : (lc == 1 ? prev1 : prev2);
                nxe_i64 cost = nxe_i64_add(
                    nxe_i64_add(dd, nxe_i64_mul(lam, level_rate(set, p, -1, sc, m))),
                    chain);
                if (!have || nxe_i64_lt(cost, best)) { best = cost; bm = m; have = true; }
                if (m != 0) {
                    nxe_i64 cnz = nxe_i64_add(
                        nxe_i64_add(dd, nxe_i64_mul(lam, level_rate(set, p, p, sc, m))),
                        chain);
                    if (!havenz || nxe_i64_lt(cnz, bestnz)) {
                        bestnz = cnz; bmnz = m; havenz = true;
                    }
                }
            }
            trelf.v[base + p * 4 + sc] = best;
            trelm.v[base + p * 4 + sc] = bm;
            if (sc == 0) {
                trelf.v[base + p * 4 + 3] = havenz ? bestnz
                                                   : nxe_i64(0xFFFFFFFFu, 0x1FFFFFFFu);
                trelm.v[base + p * 4 + 3] = bmnz;
            }
        }
        prev0 = trelf.v[base + p * 4 + 0];
        prev1 = trelf.v[base + p * 4 + 1];
        prev2 = trelf.v[base + p * 4 + 2];
    }

    nxe_i64 best_total =
        nxe_i64_add(nxe_i64_mul(lam, RATE_AT(set, cbf_ctx, 0)), energy);
    int best_last = -1;
    nxe_i64 tail = nxe_i64(0u, 0u);
    for (p = ncoef - 1; p > hi; --p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int c = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        tail = nxe_i64_add(tail, nxe_i64_sq_shl18(c));
    }
    for (p = hi; p >= 0; --p) {
        nxe_i64 fnz = trelf.v[base + p * 4 + 3];
        if (!(fnz.y == 0x1FFFFFFFu && fnz.x == 0xFFFFFFFFu)) {
            int r = RATE_AT(set, cbf_ctx, 1);
            if (ncoef > 1) {
                int cls = nxe_last_class_of(p >> g_uc_bshift);
                r += RATE_AT(set, last_ctx, cls) +
                     ((nxe_last_raw_bits[cls] + g_uc_bshift) << 10);
            }
            if (sdh != 0 && p >= NXE_SDH_MIN_LAST) r -= 1 << 10;
            nxe_i64 total =
                nxe_i64_add(nxe_i64_add(fnz, tail), nxe_i64_mul(lam, r));
            if (nxe_i64_lt(total, best_total)) { best_total = total; best_last = p; }
        }
        int idx = nxe_scan(ncoef, tskip, p);
        int c = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        tail = nxe_i64_add(tail, nxe_i64_sq_shl18(c));
    }

    if (best_last < 0) return;
    int sc2 = 0;
    for (p = best_last; p >= 0; --p) {
        int m = (p == best_last) ? trelm.v[base + p * 4 + 3]
                                 : trelm.v[base + p * 4 + sc2];
        int idx = nxe_scan(ncoef, tskip, p);
        int o = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        int v = o < 0 ? -m : m;
        if (unit == 0) s_dcq[idx] = v; else s_q[unit - 1][idx] = v;
        sc2 = uc_level_markov() != 0 ? nxe_level_class(m) : 0;
    }
}

// nxe_trellis.c's nxe_hide_sign_unit_int: the same move search as the plain
// one below, on the trellis's own footing so that the levels and the sign move
// they have to live with are decided by one arithmetic.
void hide_sign_unit_int(int unit, int ncoef, bool tskip, int const_step,
                        int set, uint lam) {
    int last = -1, sum = 0, p;
    for (p = 0; p < ncoef; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
        int m = q < 0 ? -q : q;
        sum += m;
        if (m != 0) last = p;
    }
    if (last < NXE_SDH_MIN_LAST) return;
    int lastidx = nxe_scan(ncoef, tskip, last);
    int want = (unit == 0 ? s_dcq[lastidx] : s_q[unit - 1][lastidx]) < 0 ? 1 : 0;
    if ((sum & 1) == want) return;

    nxe_i64 best = nxe_i64(0u, 0u);
    int best_p = -1, best_d = 0;
    for (p = 0; p <= last; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int o = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        int a = o < 0 ? -o : o;
        int st = const_step > 0 ? const_step : step_at(idx);
        int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
        int m = q < 0 ? -q : q;
        for (int d = -1; d <= 1; d += 2) {
            int m2 = m + d;
            if (m2 < 0 || m2 > 32767) continue;
            if (p == last && m2 == 0) continue;
            int e1 = a - nxe_dequant(m, st);
            int e2 = a - nxe_dequant(m2, st);
            nxe_i64 cost = nxe_i64_add(nxe_i64_sq_shl18(e2),
                                       nxe_i64_neg(nxe_i64_sq_shl18(e1)));
            int cx = uc_level(p, last, 0);
            int r1 = RATE_AT(set, cx, m > 14 ? NXE_ESC_SYM : m) +
                     (m > 14 ? (nxe_escape_bits(m) << 10) : 0) +
                     (m != 0 ? (1 << 10) : 0);
            int r2 = RATE_AT(set, cx, m2 > 14 ? NXE_ESC_SYM : m2) +
                     (m2 > 14 ? (nxe_escape_bits(m2) << 10) : 0) +
                     (m2 != 0 ? (1 << 10) : 0);
            cost = nxe_i64_add(cost, nxe_i64_mul(lam, r2 - r1));
            if (best_p < 0 || nxe_i64_lt(cost, best)) {
                best = cost; best_p = p; best_d = d;
            }
        }
    }
    if (best_p < 0) return;
    int idx = nxe_scan(ncoef, tskip, best_p);
    int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
    int o = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
    int m = (q < 0 ? -q : q) + best_d;
    bool neg = q != 0 ? (q < 0) : (o < 0);
    int v = neg ? -m : m;
    if (unit == 0) s_dcq[idx] = v; else s_q[unit - 1][idx] = v;
}

// The class a finished unit publishes to its entry's chain.
int unit_nbr_class(int unit, int ncoef, bool tskip) {
    int last = -1;
    for (int p = ncoef - 1; p >= 0; --p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
        if (q != 0) { last = p; break; }
    }
    return nxe_nbr_class_of(last < 0 ? 0 : 1, last < 0 ? 0 : last);
}

// `unit` selects the arrays: 0 = the DC plane (s_dcq / s_dco, constant step),
// 1..8 = residual block group entry g = unit - 1 (s_q[g] / s_orig[g]).
void hide_sign_unit(int unit, int ncoef, bool tskip, int const_step) {
    int last = -1, sum = 0, p;
    for (p = 0; p < ncoef; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
        int m = q < 0 ? -q : q;
        sum += m;
        if (m != 0) last = p;
    }
    if (last < NXE_SDH_MIN_LAST) return;
    int lastidx = nxe_scan(ncoef, tskip, last);
    int want = (unit == 0 ? s_dcq[lastidx] : s_q[unit - 1][lastidx]) < 0 ? 1 : 0;
    if ((sum & 1) == want) return;

    int best_hi = 0, best_lo = 0, best_p = -1, best_d = 0;
    for (p = 0; p <= last; ++p) {
        int idx = nxe_scan(ncoef, tskip, p);
        int o = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
        int a = o < 0 ? -o : o;
        int st = const_step > 0 ? const_step : step_at(idx);
        int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
        int m = q < 0 ? -q : q;
        for (int d = -1; d <= 1; d += 2) {
            int m2 = m + d;
            if (m2 < 0 || m2 > 32767) continue;
            if (p == last && m2 == 0) continue;
            int A = -d * st;
            int B = 32 * a - (2 * m + d) * st;
            int hi, lo;
            imulExtended(A, B, hi, lo);
            if (best_p < 0 || cost_less(hi, lo, best_hi, best_lo)) {
                best_hi = hi; best_lo = lo; best_p = p; best_d = d;
            }
        }
    }
    if (best_p < 0) return;
    int idx = nxe_scan(ncoef, tskip, best_p);
    int q = unit == 0 ? s_dcq[idx] : s_q[unit - 1][idx];
    int o = unit == 0 ? s_dco[idx] : s_orig[unit - 1][idx];
    int m = (q < 0 ? -q : q) + best_d;
    bool neg = q != 0 ? (q < 0) : (o < 0);
    int v = neg ? -m : m;
    if (unit == 0) s_dcq[idx] = v; else s_q[unit - 1][idx] = v;
}

// --------------------------------------------------------- level writeback
// Two levels per word, so a lane always owns whole words and the pack is never
// a read-modify-write race.  Every plane offset and every unit length is even,
// which is what makes that hold.
void store_levels(int level_off, int first, int count, int unit) {
    for (int k = first; k < first + count; k += 2) {
        int lo = unit == 0 ? s_dcq[k] : s_q[unit - 1][k];
        int hi = unit == 0 ? s_dcq[k + 1] : s_q[unit - 1][k + 1];
        uint w = g_coefbase + uint((level_off + k) >> 1);
        if (w < uint(coefb.v.length())) coefb.v[w] = nxe_pack16(lo, hi);
    }
}

// ------------------------------------------------------------- the DC plane
void dc_plane(uint lid) {
    const int tdc = nxe_dequant_step(g_qp >> 1, 16);

    // 1. block means, one lane per block.
    if (lid < uint(g_ndc)) {
        int b = int(lid), by = b / g_nb, bx = b % g_nb;
        int sum = 0;
        for (int j = 0; j < 8; ++j)
            for (int i = 0; i < 8; ++i) {
                const int k = (by * 8 + j) * g_size + bx * 8 + i;
                // For an inter tile the DC plane codes the mean of the
                // RESIDUAL, offset back so the quantised quantity is the same
                // `m - dc_off` on both paths (codec.cpp analyze_dc_plane).
                sum += sample_at(k) - (g_inter != 0 ? wpred_at(k) - g_dcoff : 0);
            }
        s_means[b] = sum >= 0 ? (sum + 32) >> 6 : -((-sum + 32) >> 6);
    }
    barrier();

    // 2. forward transform of the means (only nb == 8 transforms; a 4x4 DC
    //    plane is quantised directly, as reconstruct_dc_plane expects).
    if (g_nb == 8) {
        if (lid < 8u) {
            ivec4 ilo, ihi, olo, ohi;
            NXE_GATHER8(s_means, int(lid) * 8, ilo, ihi);
            ilo -= ivec4(g_dcoff);
            ihi -= ivec4(g_dcoff);
            nxe_fdct8_1d(ilo, ihi, olo, ohi);
            NXE_SCATTER8_RS(s_dca, int(lid), 8, olo, ohi, 32, 6);
        }
        barrier();
        if (lid < 8u) {
            ivec4 ilo, ihi, olo, ohi;
            NXE_GATHER8(s_dca, int(lid) * 8, ilo, ihi);
            nxe_fdct8_1d(ilo, ihi, olo, ohi);
            NXE_SCATTER8_RS(s_dco, int(lid), 8, olo, ohi, 8192, 14);
        }
        barrier();
    } else {
        if (lid < uint(g_ndc)) s_dco[lid] = s_means[lid] - g_dcoff;
        barrier();
    }

    if (fp.trellis != 0u) {
        // The DC plane through the trellis too: it is the intra predictor, so
        // re-deciding it with the same D + lambda*R the blocks use keeps the
        // predictor and the residual consistent by construction.  One lane,
        // like ref's single analyze_dc_plane call.
        if (lid == 0u) {
            trellis_ctx_dc();
            int cbf = fp.nctx >= uint(NXE_NCTX_V2) ? NXE_CTX_CBF_DC
                                                   : NXE_CTX_CBF_LUMA;
            int lst = fp.nctx >= uint(NXE_NCTX_V2) ? NXE_CTX_LAST_DC
                                                   : NXE_CTX_LAST_LUMA;
            rdoq_unit_int(0, g_ndc, false, tdc, g_trel_set, g_trel_dclam,
                          g_trel_base, cbf, lst, g_sdh);
            if (g_sdh != 0)
                hide_sign_unit_int(0, g_ndc, false, tdc, g_trel_set,
                                   g_trel_dclam);
        }
        barrier();
    } else {
    if (lid < uint(g_ndc)) s_dcq[lid] = nxe_quantize(s_dco[lid], tdc, tdc / 3);
    barrier();
    }

    // 3. sign hiding over the DC unit, then the levels go out.
    if (fp.trellis == 0u && g_sdh != 0 && lid == 0u)
        hide_sign_unit(0, g_ndc, false, tdc);
    barrier();
    if (lid < uint(g_ndc / 2)) store_levels(g_coefoff, int(lid) * 2, 2, 0);

    // 4. the decoder's reconstruction of the DC plane.
    if (lid < uint(g_ndc)) s_dca[lid] = nxe_dequant(s_dcq[lid], tdc);
    barrier();
    if (g_nb == 8) {
        if (lid < 8u) {
            ivec4 ilo, ihi, olo, ohi;
            NXE_GATHER8(s_dca, int(lid) * 8, ilo, ihi);
            nxe_idct8_1d(ilo, ihi, olo, ohi);
            NXE_SCATTER8_RS(s_dcb, int(lid), 8, olo, ohi, 64, 7);
        }
        barrier();
        if (lid < 8u) {
            ivec4 ilo, ihi, olo, ohi;
            NXE_GATHER8(s_dcb, int(lid) * 8, ilo, ihi);
            nxe_idct8_1d(ilo, ihi, olo, ohi);
            NXE_SCATTER8_RS(s_dca, int(lid), 8, olo, ohi, 4096, 13);
        }
        barrier();
    }
    if (lid < uint(g_ndc)) {
        // An INTRA tile's block mean is a sample value and is clamped to the
        // sample domain.  An INTER tile's is `dc_offset + a residual mean`,
        // whose legal range is wider on both sides; clamping it there would
        // silently cap the DC correction the warp needs.  dequant() has
        // already bounded |dc| by 32767.  reconstruct_dc_plane() makes exactly
        // this distinction and Pass B inherits it.
        const int m = g_dcoff + s_dca[lid];
        s_means[lid] = g_inter != 0 ? m : nxe_clamp(m, 0, g_maxval);
    }
    barrier();
}

// ---------------------------------------------- one 8x8 forward transform
// Lane `r` owns row r of group entry `g` on the way in and column r of the
// coefficient block on the way out, which is exactly how fdct8x8's two passes
// transpose.  `slo`/`shi` are the residual row, elements 0..3 and 4..7; the
// caller has already formed it.  See nxe_enc_common.glsl for why the row is not
// an int[8].
void fdct_group_pass1(int g, int r, ivec4 slo, ivec4 shi) {
    ivec4 olo, ohi;
    nxe_fdct8_1d(slo, shi, olo, ohi);
    NXE_SCATTER8_RS(s_blk[g], r, 8, olo, ohi, 32, 6);
}
void fdct_group_pass2(int g, int r) {
    ivec4 ilo, ihi, olo, ohi;
    NXE_GATHER8(s_blk[g], r * 8, ilo, ihi);
    nxe_fdct8_1d(ilo, ihi, olo, ohi);
    NXE_SCATTER8_RS(s_orig[g], r, 8, olo, ohi, 8192, 14);
}

// --------------------------------------------------------- residual blocks
void residual_blocks(uint lid) {
    const int g = int(lid >> 3), r = int(lid & 7);
    for (int gb = 0; gb < g_ndc; gb += 8) {
        int b = gb + g;
        int by = b / g_nb, bx = b % g_nb;
        int c;

        // The row of residuals, in an ivec4 pair rather than an int[8].
        const int ry = by * 8 + r, rxb = bx * 8;
#define NXE_RES_AT(k) (sample_at(ry * g_size + (rxb + (k))) - pred_at(rxb + (k), ry))
        ivec4 slo = ivec4(NXE_RES_AT(0), NXE_RES_AT(1), NXE_RES_AT(2), NXE_RES_AT(3));
        ivec4 shi = ivec4(NXE_RES_AT(4), NXE_RES_AT(5), NXE_RES_AT(6), NXE_RES_AT(7));
#undef NXE_RES_AT

        if (g_tskip != 0) {
            // Transform skip: the residual is quantised where it stands, with
            // the flat step, and the raster scan replaces the zigzag.
            int t = nxe_dequant_step(g_qp, 16);
#define NXE_TSKIP_ONE(k, v) { int idx = r * 8 + (k);                           \
                              s_orig[g][idx] = (v);                            \
                              s_q[g][idx] = nxe_quantize((v), t, t / 3); }
            NXE_TSKIP_ONE(0, slo.x)
            NXE_TSKIP_ONE(1, slo.y)
            NXE_TSKIP_ONE(2, slo.z)
            NXE_TSKIP_ONE(3, slo.w)
            NXE_TSKIP_ONE(4, shi.x)
            NXE_TSKIP_ONE(5, shi.y)
            NXE_TSKIP_ONE(6, shi.z)
            NXE_TSKIP_ONE(7, shi.w)
#undef NXE_TSKIP_ONE
            barrier();
        } else {
            fdct_group_pass1(g, r, slo, shi);
            barrier();
            fdct_group_pass2(g, r);
            for (c = 0; c < 8; ++c) {
                int idx = c * 8 + r;
                int t = step_at(idx);
                s_q[g][idx] = nxe_quantize(s_orig[g][idx], t, t / 3);
            }
            barrier();
        }

        // The integer requantiser, at effort 1 (nxe_enc.h, "integer RDOQ"):
        // drop a level of +-1 whose squared error is worth less than the bits
        // it saves.  BEFORE sign hiding, which reads the levels -- a
        // coefficient dropped here is one the hiding pass must not have
        // counted -- and after the barrier that ends either quantise branch,
        // so lane `r` may own column r whichever branch ran.  No coefficient's
        // decision depends on another's, so this stage needs no barrier of its
        // own, only the one that publishes it to lane 0.
        //
        // The lambda takes the plane's own quantiser step and NOT the
        // weighted one: `int_rdoq_lambda_q8(s.qp)` in the reference is
        // kQStep[qp], the same for every coefficient of the block, while the
        // per-coefficient step below carries the weighting matrix.
        if (fp.trellis != 0u) {
            // Effort 2.  Lane r == 0 of each entry runs its block's whole
            // trellis; the chain is per entry (block b conditions on b - 8,
            // and entry g owns g, g+8, g+16 ...), so `s_nbr[g]` carries in
            // shared memory across the rounds of this loop and no lane ever
            // reads another's.
            if (r == 0) {
                trellis_ctx_block(g_chroma ? 1 : 0);
                trellis_nbr(g, g_chroma ? NXE_CTX_CBF_CHROMA
                                        : NXE_CTX_CBF_LUMA,
                            g_chroma ? NXE_CTX_LAST_CHROMA
                                     : NXE_CTX_LAST_LUMA,
                            b >= g_nlanes ? s_nbr[b - g_nlanes] : 0);
                rdoq_unit_int(g + 1, 64, g_tskip != 0, 0, g_trel_set,
                              g_trel_lam, g_trel_base + (g + 1) * NXE_TREL_GROUP,
                              s_uc_cbf[g], s_uc_last[g], g_sdh);
                if (g_sdh != 0)
                    hide_sign_unit_int(g + 1, 64, g_tskip != 0, 0, g_trel_set,
                                       g_trel_lam);
                s_nbr[b] = unit_nbr_class(g + 1, 64, g_tskip != 0);
            }
            barrier();
        } else if (fp.int_rdoq != 0u) {
            const uint lam = nxe_rdoq_lambda_q8(nxe_qstep[g_qp]);
            for (c = 0; c < 8; ++c) {
                int idx = c * 8 + r;
                if (nxe_rdoq_drop(s_orig[g][idx], s_q[g][idx], step_at(idx),
                                  lam))
                    s_q[g][idx] = 0;
            }
            barrier();
        }

        if (fp.trellis == 0u && g_sdh != 0 && r == 0)
            hide_sign_unit(g + 1, 64, g_tskip != 0, 0);
        barrier();

        store_levels(g_coefoff + g_ndc + b * 64, r * 8, 8, g + 1);
        barrier();
    }
}

// ------------------------------------------------------- directional intra
#define FALLBACK(X, Y) (fp.dir_layer != 0u ? 0 : pred_at((X), (Y)))

int refs_at(int bx, int by, int x, int y) {
    int cx = nxe_clamp(x, 0, g_size - 1), cy = nxe_clamp(y, 0, g_size - 1);
    int nbx = cx >> 3, nby = cy >> 3;
    bool done = (nby < by) || (nby == by && nbx < bx);
    return done ? s_recon[cy * g_size + cx] : FALLBACK(cx, cy);
}

void predict_block(int mode, int bx, int by, uint lid) {
    if (lid >= 64u) return;
    int i = int(lid) & 7, j = int(lid) >> 3;
    int tl = s_refA[0];
    // A[k] == s_refA[1 + k], L[k] == s_refL[1 + k]; A[-1] == L[-1] == tl.
    #define A(k) s_refA[1 + (k)]
    #define L(k) s_refL[1 + (k)]
    int v;
    if (mode == 0) {
        v = FALLBACK(bx * 8 + i, by * 8 + j);
    } else if (mode == 1) {
        int sum = 0;
        for (int k = 0; k < 8; ++k) sum += A(k) + L(k);
        v = (sum + 8) >> 4;
    } else if (mode == 2) {
        v = ((7 - i) * L(j) + (i + 1) * A(8) + (7 - j) * A(i) + (j + 1) * L(8) +
             8) >> 4;
    } else if (mode == 3) {
        v = L(j);
    } else if (mode == 4) {
        v = A(i);
    } else if (mode == 5) {
        int k = i + j;
        v = (k == 14) ? (A(14) + 3 * A(15) + 2) >> 2
                      : (A(k) + 2 * A(k + 1) + A(k + 2) + 2) >> 2;
    } else if (mode == 6) {
        if (i > j) { int k = i - j; v = (A(k - 2) + 2 * A(k - 1) + A(k) + 2) >> 2; }
        else if (i < j) { int k = j - i; v = (L(k - 2) + 2 * L(k - 1) + L(k) + 2) >> 2; }
        else v = (A(0) + 2 * tl + L(0) + 2) >> 2;
    } else if (mode == 7) {
        int z = 2 * i - j, k = i - (j >> 1);
        if (z >= 0 && (z & 1) == 0) v = (A(k - 1) + A(k) + 1) >> 1;
        else if (z >= 0) v = (A(k - 2) + 2 * A(k - 1) + A(k) + 2) >> 2;
        else if (z == -1) v = (L(0) + 2 * tl + A(0) + 2) >> 2;
        else { int q = j - 2 * i; v = (L(q - 1) + 2 * L(q - 2) + L(q - 3) + 2) >> 2; }
    } else {
        int z = 2 * j - i, k = j - (i >> 1);
        if (z >= 0 && (z & 1) == 0) v = (L(k - 1) + L(k) + 1) >> 1;
        else if (z >= 0) v = (L(k - 2) + 2 * L(k - 1) + L(k) + 2) >> 2;
        else if (z == -1) v = (A(0) + 2 * tl + L(0) + 2) >> 2;
        else { int q = i - 2 * j; v = (A(q - 1) + 2 * A(q - 2) + A(q - 3) + 2) >> 2; }
    }
    #undef A
    #undef L
    s_P[j * 8 + i] = v;
}

int mode_at(int plane, int b) {
    uint idx = g_tile * 3u * 64u + uint(plane) * 64u + uint(b);
    uint w = idx >> 2;
    if (w >= uint(modeb.v.length())) return 0;
    return int((modeb.v[w] >> ((idx & 3u) * 8u)) & 0xffu);
}

void residual_blocks_dir(uint lid, int plane) {
    // The full 8x8 raster dependency of SYNTAX.md 7.4: block (bx, by) reads the
    // reconstruction of every block before it, including the one up and to the
    // right.  There is no wavefront to exploit inside a tile at 8x8 -- the
    // dependency chain is the raster order itself -- so the blocks are serial
    // and the 64 lanes go wide inside each one.  Restriction A (dropping the
    // top-right reference, ref/RESULTS-intra.md section 5) would allow an
    // anti-diagonal wavefront of up to 8 blocks; it is not conformant, so it
    // is not what this kernel does.
    for (uint i = lid; i < uint(g_size * g_size); i += uint(NXE_E3_WG))
        s_recon[i] = 0;
    barrier();

    for (int b = 0; b < g_ndc; ++b) {
        int by = b / g_nb, bx = b % g_nb;
        int mode = mode_at(plane, b);

        if (lid == 0u) {
            s_refA[0] = refs_at(bx, by, bx * 8 - 1, by * 8 - 1);
            s_refL[0] = s_refA[0];
        }
        if (lid >= 1u && lid < 17u) {
            int k = int(lid) - 1;
            s_refA[1 + k] = refs_at(bx, by, bx * 8 + k, by * 8 - 1);
            s_refL[1 + k] = refs_at(bx, by, bx * 8 - 1, by * 8 + k);
        }
        if (lid < 64u) {
            int i = int(lid) & 7, j = int(lid) >> 3;
            int x = bx * 8 + i, y = by * 8 + j;
            int v = sample_at(y * g_size + x);
            if (fp.dir_layer != 0u) v -= pred_at(x, y);
            s_tgt[j * 8 + i] = v;
        }
        barrier();

        predict_block(mode, bx, by, lid);
        barrier();
        if (lid < 64u) s_res[lid] = s_tgt[lid] - s_P[lid];
        barrier();

        // Quantise, using group 0 of the shared transform scratch.
        if (g_tskip != 0) {
            if (lid < 64u) {
                int t = nxe_dequant_step(g_qp, 16);
                s_orig[0][lid] = s_res[lid];
                s_q[0][lid] = nxe_quantize(s_res[lid], t, t / 3);
            }
            barrier();
        } else {
            if (lid < 8u) {
                ivec4 slo, shi;
                NXE_GATHER8(s_res, int(lid) * 8, slo, shi);
                fdct_group_pass1(0, int(lid), slo, shi);
            }
            barrier();
            if (lid < 8u) {
                fdct_group_pass2(0, int(lid));
                for (int c = 0; c < 8; ++c) {
                    int idx = c * 8 + int(lid);
                    int t = step_at(idx);
                    s_q[0][idx] = nxe_quantize(s_orig[0][idx], t, t / 3);
                }
            }
            barrier();
        }
        if (g_sdh != 0 && lid == 0u) hide_sign_unit(1, 64, g_tskip != 0, 0);
        barrier();
        if (lid < 8u) store_levels(g_coefoff + g_ndc + b * 64, int(lid) * 8, 8, 1);

        // residual_block: dequantise and inverse transform, then the running
        // reconstruction the next block will read.
        if (g_tskip != 0) {
            if (lid < 64u) {
                int t = nxe_dequant_step(g_qp, 16);
                s_res[lid] = nxe_dequant(s_q[0][lid], t);
            }
            barrier();
        } else {
            if (lid < 64u) s_blk[0][lid] = nxe_dequant(s_q[0][lid], step_at(int(lid)));
            barrier();
            if (lid < 8u) {
                ivec4 ilo, ihi, olo, ohi;
                NXE_GATHER8(s_blk[0], int(lid) * 8, ilo, ihi);
                nxe_idct8_1d(ilo, ihi, olo, ohi);
                NXE_SCATTER8_RS(s_dca, int(lid), 8, olo, ohi, 64, 7);
            }
            barrier();
            if (lid < 8u) {
                ivec4 ilo, ihi, olo, ohi;
                NXE_GATHER8(s_dca, int(lid) * 8, ilo, ihi);
                nxe_idct8_1d(ilo, ihi, olo, ohi);
                NXE_SCATTER8_RS(s_res, int(lid), 8, olo, ohi, 4096, 13);
            }
            barrier();
        }
        if (lid < 64u) {
            int i = int(lid) & 7, j = int(lid) >> 3;
            int x = bx * 8 + i, y = by * 8 + j;
            int v = s_P[j * 8 + i] + s_res[j * 8 + i];
            int rec;
            if (fp.dir_layer != 0u) {
                int base = pred_at(x, y);
                rec = nxe_clamp(base + v, 0, g_maxval) - base;
            } else {
                rec = nxe_clamp(v, 0, g_maxval);
            }
            s_recon[y * g_size + x] = rec;
        }
        barrier();
    }
    // s_recon is internal to the plane: E3's product is the coefficients.  A
    // future E3b that writes the encoder's reference picture reads it instead.
}

// -------------------------------------------------------------------- main
void main() {
    uint lid = gl_LocalInvocationID.x;
    nxe_init_tables(lid, uint(NXE_E3_WG));
    barrier();
    g_tile = gl_WorkGroupID.x;
    if (g_tile >= fp.ntiles) return;
    nxe_tile_job job = jobs[g_tile];
    // A WARP_SKIP tile codes no residual, so E3 does not transform it and E4
    // gives it no units.  It does not simply return, though: its coefficient
    // slot has to be ZEROED.
    //
    // Pass B reconstructs the encoder's reference picture for every tile,
    // skipped ones included -- a skipped tile is an inter tile whose residual
    // is nothing, which is exactly `reconstruct_skip`.  In the dense
    // coefficient layout Pass B is run with, there are no per-unit lengths and
    // every unit is read as coded, so a slot left holding the PREVIOUS frame's
    // coefficients would be added to the prediction as if it were this
    // tile's residual.  Zeroing is the dense layout's own convention for an
    // uncoded unit, which is why Pass A does the same.
    //
    // One workgroup owns one tile, so both the branch and the return are
    // workgroup-uniform and the barriers below are unaffected.
    // A tile that predicts from the warp and still codes a residual.  Its
    // WPred slot is Pass W's output for the mode and vector E1c chose, and
    // every plane of it is subtracted below.
    g_inter = job.mode != uint(NXE_MODE_INTRA) ? 1 : 0;

    if (job.mode == uint(NXE_MODE_WARP_SKIP)) {
        for (uint w = lid; w < uint(NXE_TILE_COEF_WORDS); w += uint(NXE_E3_WG))
            coefb.v[g_tile * uint(NXE_TILE_COEF_WORDS) + w] = 0u;
        return;
    }

    const int qp_base = nxe_clamp(int(fp.base_qp) + job.qp_delta, 0, 63);
    g_coefbase = g_tile * uint(NXE_TILE_COEF_WORDS);
    g_tskip = int(job.tskip);
    g_sdh = int(fp.sdh);

    // Plane word bases, derived exactly as the host lays the buffer out.  The
    // running base is carried through the plane loop below rather than
    // precomputed into a uint[NXE_MAX_PLANES]: the planes are visited in the
    // same order either way, and a local array indexed by the loop counter is
    // the construct docs/ADRENO-RULES.md exists to keep out.
    uint pbase = 0u;

    for (int p = 0; p < NXE_MAX_PLANES; ++p) {
        g_chroma = (p == 1 || p == 2);
        g_size = nxe_plane_size(job.chroma444, job.res_level, p);
        g_nb = g_size / 8;
        g_ndc = g_nb * g_nb;
        g_qp = g_chroma ? nxe_clamp(qp_base + fp.chroma_qp_off, 0, 63) : qp_base;
        g_maxval = (fp.ycocgr != 0u && g_chroma) ? 511 : 255;
        g_dcoff = (fp.ycocgr != 0u && g_chroma) ? 256 : 128;
        g_wmsel = job.wm_id == 0u ? -1 : int(g_chroma ? 3u : job.wm_id);
        // Effort 2's per-plane state: the rate model's table set, this tile's
        // slot in the trellis scratch, and the two lambdas -- the plane's own
        // and the DC plane's, at its own quantiser.  The chain starts empty on
        // every plane, exactly as ref's `nbr[]` is local to rdoq_plane.
        g_trel_set = int(job.table_set);
        g_nlanes = 1 << int(fp.nsub_log2);
        g_trel_base = int(gl_WorkGroupID.x) * (9 * NXE_TREL_GROUP);
        g_trel_lam = nxe_trellis_lambda_q8(nxe_qstep[g_qp]);
        g_trel_dclam = nxe_trellis_lambda_q8(nxe_qstep[g_qp >> 1]);
        if (lid < 64u) s_nbr[lid] = 0;
        barrier();
        // Captured before the pass calls below, which are free to move the
        // globals; the next plane's base must not depend on that.
        const uint plane_words = fp.ntiles * uint(g_size * g_size / 2);
        g_srcbase = pbase + g_tile * uint(g_size * g_size / 2);
        // WPred is laid out per TILE at the decoder's own stride, with each
        // plane at a fixed res_level-0 offset -- not packed plane-major the
        // way the source is.  inter_layout.h's nxvw_wpred_plane_off().
        {
            const int ce = fp.chroma420 != 0u ? 32 : 64;
            const int poff = p == 0 ? 0 : (p == 1 ? 4096 : 4096 + ce * ce);
            g_wpredbase = (g_tile * fp.wpred_stride + uint(poff)) >> 1u;
        }
        g_coefoff = nxe_plane_coef_offset(job.chroma444, job.res_level, p);

        dc_plane(lid);
        if (NXE_SC_INTRA_DIR != 0) residual_blocks_dir(lid, p);
        else residual_blocks(lid);
        barrier();

        pbase += plane_words;
    }
}
