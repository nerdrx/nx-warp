#version 460
// Approximate forced PLANAR R=2/coarse fit proof.  Input is the encoder's
// plane-major, tile-packed Y/Cb/Cr buffer (two signed int16 samples per uint), with
// 2048 Y words then 512 words per chroma plane per tile.  It deliberately uses
// zero slopes: this is a valid body and a cheap GPU fallback, not the
// byte-identical host least-squares fit.
#extension GL_GOOGLE_include_directive : require
#include "nxe_enc_common.glsl"
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Bodies { uint body[]; };
layout(std430, binding = 2) readonly buffer Jobs { nxe_tile_job jobs[]; };
layout(std430, binding = 3) writeonly buffer Recon { uint recon[]; };
// Mode 0 is the historical path. Mode 1 only skips a fit; full-frame decode
// remains possible and no WARP_SKIP is emitted. Reuse keeps old image-space samples
// without per-tile pose metadata or motion correction. Meta stride is 64 uints/tile:
// [0] state(valid|promoted), [1] lastRefresh, [2] lastCheck, [3] format key,
// [4] age-at-refresh, [5] quiet count, [6..10] refresh/reuse/change/promote/
// age stats, [12] job flags, [16..63] 48 samples from the last refresh.
layout(std430, binding = 4) buffer CadenceMeta { uint meta[]; };
layout(push_constant) uniform PC {
    uint width, height, qp, chromaQPOffset, cadenceMode, frameNumber;
} pc;
shared int cy[256], cu[256], cv[256];
shared int gy, gu, gv, qy0, qy1, qu0, qu1, qv0, qv1;
shared int fp[48];
shared uint cadenceReuse, cadenceRefresh, cadencePromote, cadenceQuiet;

int read_sample(uint base, uint i) {
    uint w = src[base + (i >> 1u)];
    return ((i & 1u) == 0u) ? int(w << 16) >> 16 : int(w) >> 16;
}
int clamp8(int v) { return clamp(v, -128, 127); }
int quant(int v, int off, int step) {
    int d = v - off;
    int n = d >= 0 ? d * 16 + step / 2 : d * 16 - step / 2;
    return clamp8(n / step);
}
void main() {
    uint tile = gl_WorkGroupID.x, lid = gl_LocalInvocationID.x;
    nxe_init_tables(lid, 256u);
    barrier();
    // Dispatch covers every tile in both eyes; width/height are per eye.
    uint nt = gl_NumWorkGroups.x;
    if (tile >= nt) return;
    uint ybase = tile * 2048u, cbase = nt * 2048u + tile * 512u;
    uint mt = tile * 64u;
    if ((pc.cadenceMode & 1u) != 0u && (jobs[tile].flags & 0x80000000u) != 0u) return;
    if ((pc.cadenceMode & 1u) != 0u) {
        if (lid < 48u) {
            uint plane = lid / 16u, k = lid & 15u;
            uint x = (k & 3u) * 16u + 8u, y = (k >> 2u) * 16u + 8u;
            uint si = plane == 0u ? y * 64u + x :
                      ((k >> 2u) * 8u + 4u) * 32u + (k & 3u) * 8u + 4u;
            uint base = plane == 0u ? ybase : cbase + (plane - 1u) * nt * 512u;
            fp[lid] = read_sample(base, si);
        }
        barrier();
        if (lid == 0u) {
            uint flags = jobs[tile].flags;
            uint tileQP = uint(clamp(int(pc.qp) + jobs[tile].qp_delta, 0, 63));
            uint key = tileQP | ((pc.chromaQPOffset & 255u) << 8u) |
                       ((uint(jobs[tile].qp_delta) & 255u) << 16u);
            uint state = meta[mt];
            bool valid = (state & 1u) != 0u;
            bool promoted = (state & 2u) != 0u;
            bool native = (flags & 0x80000000u) != 0u;
            bool keyChanged = meta[mt + 3u] != key || meta[mt + 12u] != flags;
            uint age = pc.frameNumber - meta[mt + 1u];
            bool force = !valid || keyChanged || age >= 4u ||
                         ((pc.cadenceMode & 2u) != 0u);
            int mad = 0;
            if (valid && !force)
                for (uint i = 0u; i < 48u; ++i)
                    mad += abs(fp[i] - int(meta[mt + 16u + i]));
            mad /= 48;
            bool baseline2 = (flags & 0x10000000u) != 0u;
            uint period = baseline2 ? 2u : 4u;
            // Fixed spatial phases stagger both eyes without an atomic race.
            uint phase = jobs[tile].col + 3u * jobs[tile].row;
            bool due = (phase + pc.frameNumber) % period == 0u;
            bool rotatingHalf = ((jobs[tile].col / 2u + jobs[tile].row + pc.frameNumber / 2u) & 1u) == 0u;
            bool changed = mad >= 12;
            bool quiet = mad <= 6;
            uint quietCount = quiet ? min(meta[mt + 5u] + 1u, 3u) : 0u;
            bool fast = changed || (promoted && quietCount < 3u);
            bool promoteNow = !force && !due && fast && rotatingHalf &&
                              (phase + pc.frameNumber) % (period / 2u) == 0u;
            cadencePromote = promoteNow ? 1u : 0u;
            cadenceQuiet = quietCount;
            cadenceRefresh = (force || due || promoteNow) ? 1u : 0u;
            cadenceReuse = cadenceRefresh == 0u ? 1u : 0u;
            meta[mt] = (valid ? 1u : 0u) | (fast ? 2u : 0u);
            meta[mt + 5u] = quietCount;
        }
        barrier();
    } else {
        if (lid == 0u) {
            cadenceReuse = 0u;
            cadenceRefresh = 1u;
            cadencePromote = 0u;
            cadenceQuiet = 0u;
        }
        barrier();
    }
    bool doFit = cadenceReuse == 0u;
    // Reused body and recon are already complete in persistent buffers. This
    // uniform return is the actual fit saving; it occurs before any reductions.
    if (!doFit) {
        if (lid == 0u) {
            meta[mt + 2u] = pc.frameNumber;
            meta[mt + 7u]++;
            if (cadenceQuiet == 0u) meta[mt + 8u]++;
            meta[mt + 10u] = pc.frameNumber - meta[mt + 1u];
        }
        return;
    }
    uint cell = lid;
    const bool fine = (jobs[tile].flags & 0x10000000u) != 0u;
    const uint dim = fine ? 16u : 8u;
    const uint cell_size = fine ? 4u : 8u;
    const uint ccell_size = fine ? 2u : 4u;
    if (doFit && lid < dim * dim) {
        uint cx = cell % dim, cy0 = cell / dim;
        int sy = 0, su = 0, sv = 0;
        for (uint j = 0u; j < cell_size; ++j)
            for (uint i = 0u; i < cell_size; ++i)
                sy += read_sample(ybase, (cy0 * cell_size + j) * 64u + cx * cell_size + i);
        for (uint j = 0u; j < ccell_size; ++j)
            for (uint i = 0u; i < ccell_size; ++i) {
                uint ci = (cy0 * ccell_size + j) * 32u + cx * ccell_size + i;
                su += read_sample(cbase, ci);
                sv += read_sample(cbase + nt * 512u, ci);
            }
        cy[cell] = (sy + int(cell_size * cell_size / 2u)) /
                   int(cell_size * cell_size);
        cu[cell] = (su + int(ccell_size * ccell_size / 2u)) /
                   int(ccell_size * ccell_size);
        cv[cell] = (sv + int(ccell_size * ccell_size / 2u)) /
                   int(ccell_size * ccell_size);
    }
    barrier();
    // Graduated outer rings may merge neighbouring 8x8 means before the
    // palette split. Host-only job flags select 2x2 or 4x4 cell groups.
    uint group = (jobs[tile].flags & 0x20000000u) != 0u ? 4u :
                 (jobs[tile].flags & 0x40000000u) != 0u ? 2u : 1u;
    int gsy = 0, gsu = 0, gsv = 0, gn = 0;
    if (doFit && group > 1u && lid < dim * dim) {
        uint cx0 = (cell % dim) / group * group;
        uint cy0 = (cell / dim) / group * group;
        for (uint yy = 0u; yy < group; ++yy)
            for (uint xx = 0u; xx < group; ++xx) {
                uint c = (cy0 + yy) * dim + cx0 + xx;
                gsy += cy[c]; gsu += cu[c]; gsv += cv[c];
            }
        gn = int(group * group);
    }
    barrier();
    if (doFit && group > 1u && lid < dim * dim) {
        cy[cell] = (gsy + gn / 2) / gn;
        cu[cell] = (gsu + gn / 2) / gn;
        cv[cell] = (gsv + gn / 2) / gn;
    }
    barrier();
    if (doFit && lid == 0u) {
        gy = gu = gv = 0;
        const int ncells = int(dim * dim);
        for (int i = 0; i < ncells; ++i) { gy += cy[i]; gu += cu[i]; gv += cv[i]; }
        gy = (gy + ncells / 2) / ncells;
        gu = (gu + ncells / 2) / ncells;
        gv = (gv + ncells / 2) / ncells;
        int sy0 = 0, sy1 = 0, su0 = 0, su1 = 0, sv0 = 0, sv1 = 0;
        int n0 = 0, n1 = 0;
        for (int i = 0; i < ncells; ++i) {
            if (cy[i] < gy) { sy0 += cy[i]; su0 += cu[i]; sv0 += cv[i]; ++n0; }
            else { sy1 += cy[i]; su1 += cu[i]; sv1 += cv[i]; ++n1; }
        }
        // Empty regions fall back to the global mean, keeping the body valid.
        sy0 = n0 != 0 ? (sy0 + n0 / 2) / n0 : gy;
        sy1 = n1 != 0 ? (sy1 + n1 / 2) / n1 : gy;
        su0 = n0 != 0 ? (su0 + n0 / 2) / n0 : gu;
        su1 = n1 != 0 ? (su1 + n1 / 2) / n1 : gu;
        sv0 = n0 != 0 ? (sv0 + n0 / 2) / n0 : gv;
        sv1 = n1 != 0 ? (sv1 + n1 / 2) / n1 : gv;
        int tileQP = clamp(int(pc.qp) + jobs[tile].qp_delta, 0, 63);
        int stepY = nxe_dequant_step(tileQP >> 1, 16);
        int stepC = nxe_dequant_step(clamp(tileQP + int(pc.chromaQPOffset), 0, 63) >> 1, 16);
        qy0 = quant(sy0, 128, stepY); qy1 = quant(sy1, 128, stepY);
        qu0 = quant(su0, 128, stepC); qu1 = quant(su1, 128, stepC);
        qv0 = quant(sv0, 128, stepC); qv1 = quant(sv1, 128, stepC);
    }
    barrier();
    if (doFit && lid == 0u) {
        uint dst = tile * 26u;
        uint packed[26]; for (uint i = 0u; i < 26u; ++i) packed[i] = 0u;
        const uint map_bytes = fine ? 32u : 8u;
        packed[0] = fine ? 8u : 0u; // R=2, fine bit when selected
        for (uint i = 0u; i < dim * dim; ++i) {
            if (cy[i] >= gy) {
                const uint bit = i;
                packed[((1u + bit / 8u) >> 2u)] |=
                    1u << (((1u + bit / 8u) & 3u) * 8u + (bit & 7u));
            }
        }
        const uint co = 1u + map_bytes;
        const uint q[6] = {uint(qy0 & 255), uint(qu0 & 255), uint(qv0 & 255),
                           uint(qy1 & 255), uint(qu1 & 255), uint(qv1 & 255)};
        for (uint i = 0u; i < 6u; ++i)
            packed[((co + i * 3u) >> 2u)] |=
                q[i] << (((co + i * 3u) & 3u) * 8u);
        for (uint i = 0u; i < 26u; ++i) body[dst + i] = packed[i];
        // Reconstruct uses an expanded layout: header word, 16 map words,
        // then 18 coefficient bytes. Serialized map/coefficients are unaligned.
        uint expanded[26];
        for (uint i = 0u; i < 26u; ++i) expanded[i] = 0u;
        expanded[0] = fine ? 8u : 0u;
        for (uint i = 0u; i < map_bytes; ++i) {
            uint src_byte = 1u + i;
            uint value = (packed[src_byte >> 2u] >> ((src_byte & 3u) * 8u)) & 255u;
            expanded[1u + (i >> 2u)] |= value << ((i & 3u) * 8u);
        }
        for (uint i = 0u; i < 18u; ++i) {
            uint src_byte = co + i;
            uint value = (packed[src_byte >> 2u] >> ((src_byte & 3u) * 8u)) & 255u;
            expanded[17u + (i >> 2u)] |= value << ((i & 3u) * 8u);
        }
        for (uint i = 0u; i < 26u; ++i) recon[dst + i] = expanded[i];
    }
    barrier();
    if ((pc.cadenceMode & 1u) != 0u && lid == 0u) {
        uint flags = jobs[tile].flags;
        bool native = (flags & 0x80000000u) != 0u;
        if (!native) {
            uint tileQP = uint(clamp(int(pc.qp) + jobs[tile].qp_delta, 0, 63));
            uint key = tileQP | ((pc.chromaQPOffset & 255u) << 8u) |
                       ((uint(jobs[tile].qp_delta) & 255u) << 16u);
            uint state = meta[mt];
            if (cadenceRefresh != 0u) {
                uint promoted = cadencePromote != 0u ? 2u :
                                ((state & 2u) != 0u && cadenceQuiet < 3u ? 2u : 0u);
                meta[mt] = 1u | promoted;
                meta[mt + 1u] = pc.frameNumber;
                meta[mt + 2u] = pc.frameNumber;
                meta[mt + 3u] = key;
                meta[mt + 4u] = 0u;
                meta[mt + 6u]++;
                if (cadencePromote != 0u) meta[mt + 9u]++;
                for (uint i = 0u; i < 48u; ++i) meta[mt + 16u + i] = uint(fp[i]);
            } else {
                meta[mt + 2u] = pc.frameNumber;
                meta[mt + 7u]++;
            }
            if (cadenceQuiet == 0u) meta[mt + 8u]++;
            meta[mt + 10u] = pc.frameNumber - meta[mt + 1u];
            meta[mt + 12u] = flags;
        }
    }
}
