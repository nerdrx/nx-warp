#version 460
// packetize.comp -- E5: the frame laid out in the host-cached output buffer.
//
// SPDX-License-Identifier: Apache-2.0
//
// Paper 3.6: "one group of 1024 threads per view; prefix sum of tile sizes,
// compaction into tile-row segments, headers written by the shader".  The
// prefix sum is E2's, already run over the per-tile byte counts E4 wrote, so
// this pass is the compaction and the headers.
//
// The destination is the HOST_VISIBLE | HOST_COHERENT | HOST_CACHED buffer the
// network thread reads with sendmmsg, so the writes want to be coalesced
// whole words rather than bytes.  A tile's payload lands at an arbitrary byte
// offset, though, so the copy is: every destination word the tile *fully*
// covers is assembled from two source words and stored outright, and the at
// most six bytes at the two ends -- which a tile shares with its neighbour or
// with a row header -- go in with atomicOr over a pre-zeroed buffer.  That is
// eight atomics per tile instead of one per byte.
//
// Tile order is the normative one (row-major, eye-minor, column), so the row
// group of tile t is t / tiles_x and every row header up to and including it
// is accounted for by a multiplication.  There is no second scan.

#extension GL_GOOGLE_include_directive : require
#include "nxe_enc_common.glsl"

layout(local_size_x = NXE_E5_WG, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ParamBuf { nxe_frame_params fp; };
layout(std430, binding = 1) readonly buffer JobBuf   { nxe_tile_job jobs[]; };
layout(std430, binding = 2) readonly buffer SlotBuf  { uint v[]; } slot;
// E2's exclusive prefix sum over the per-tile byte counts, and its total.
layout(std430, binding = 3) readonly buffer PrefixBuf { uint v[]; } prefix;
layout(std430, binding = 4) readonly buffer TotalBuf  { uint v[]; } tot;
layout(std430, binding = 5)          buffer OutBuf    { uint v[]; } outb;
// The frame's pose blob, 26 bytes; the compositor's, opaque to the codec.
layout(std430, binding = 6) readonly buffer PoseBuf   { uint v[]; } pose;
// The transmitted probability tables (SYNTAX.md 9.4), one byte per byte of
// the frame's table area.  Empty unless CUSTOM_TABLES is on; the host
// serialises it next to the table training, which is the same host work the
// per-tile table-set choice already is.
layout(std430, binding = 7) readonly buffer TabBytes  { uint v[]; } tabb;
// warp_ext(): nine int32 per eye, row-major, Q10.21 for rows 0 and 1 and
// Q2.29 for row 2.  The host derives it from the pose pair; the codec never
// sees the floating point that produced it.
//
// It goes BEFORE the table area, not after: SYNTAX.md 12 fixes the frame as
//   frame := frame_header [warp_ext] [custom_matrices] [table_set]* tile_row*
// so an inter frame with transmitted tables carries warp_ext at offset 40 and
// the tables after it.  Getting that order backwards produces a frame both
// encoders agree on and no decoder can read.
layout(std430, binding = 8) readonly buffer WarpExtBuf { uint v[]; } warpext;

// [planar] [SYN] 13.13.  One tile's raw body, NXE_PLANAR_BODY_UINTS per tile.
//
// A planar tile has no rANS payload -- no lanes, no flush states, no
// renormalisation words -- so it does not pass through E3 or E4 at all and
// there is nothing of it in `slot`.  The host fits it (the fit is integer and
// shared with the reference, vk/encoder/forward/nxe_planar.h) and uploads the
// finished body here; E5 copies it out verbatim.
//
// A buffer of its own rather than a corner of `slot`: the slot layout is
// dimensioned by NXE_TILE_COEFS_MAX and indexed by the entropy pass's own
// back-to-front emission rule, and threading a payload that has neither
// through it would make both harder to read for no saving.
layout(std430, binding = 9) readonly buffer PlanarBuf { uint v[]; } planarb;

void put_byte(uint off, uint val) {
    uint w = off >> 2;
    if (w < uint(outb.v.length()))
        atomicOr(outb.v[w], (val & 0xffu) << ((off & 3u) * 8u));
}

// Whole-word form of the same.  The output buffer is zeroed by the E5 pass-0
// clear before anything writes to it, so an OR into a word no other lane touches
// is a store.
void put_word(uint w, uint val) {
    if (w < uint(outb.v.length()))
        atomicOr(outb.v[w], val);
}

// Byte `i` of tile `t`'s output.  E4's slot is not the tile's bytes laid end
// to end: the header and the rANS flush states are at the front, and the
// renormalisation words are one per word at the *end*, emission e at
// slot_end - 1 - e (see NXE_TILE_SLOT_WORDS).  Reading those forwards is
// exactly the bitstream's order, because the sweep produces them in descending
// global operation order.
// [planar] `tile` is carried so tile_byte() can find the body buffer; every
// other field is an offset into `slot`, which a planar tile does not use.
struct TileSlot { uint w0, wend, prefix_bytes; uint ewords; uint fields; uint tile; };

TileSlot tile_slot(uint t) {
    TileSlot s;
    s.tile = t;
    s.w0 = t * uint(NXE_TILE_SLOT_WORDS);
    s.wend = s.w0 + uint(NXE_TILE_SLOT_WORDS);
    uint nlanes_active = (jobs[t].flags >> 8) & 0xffu;
    /* SYNTAX.md 4.1's optional fields sit between the two header words and
     * the payload; this pipeline emits only the two-byte vector, on a
     * coded-vector tile. */
    const uint m = jobs[t].mode;
    s.fields = (m == uint(NXE_MODE_STATIC_MV) || m == uint(NXE_MODE_WARP_MV) ||
                m == uint(NXE_MODE_STEREO)) ? 2u : 0u;
    // [planar] A planar tile carries the two header words and then its body,
    // and nothing else: 13.13 forbids every field that would sit between them
    // (mv_present, quad_mv and the rest are all required to be 0), and it has
    // no lanes to flush.
    if (m == uint(NXE_MODE_PLANAR)) {
        s.fields = 0u;
        s.prefix_bytes = 8u;
        s.ewords = 0u;
        return s;
    }
    s.prefix_bytes = 8u + s.fields + 4u * nlanes_active;
    s.ewords = (jobs[t].tile_bytes - s.prefix_bytes) >> 1;
    return s;
}

uint tile_byte(TileSlot s, uint i) {
    if (i < 8u) {                       /* the two header words */
        uint w = s.w0 + (i >> 2);
        return (slot.v[min(w, uint(slot.v.length()) - 1u)] >> ((i & 3u) * 8u)) &
               0xffu;
    }
    if (i < 8u + s.fields) {            /* the field word, at w0 + 2 */
        const uint k = i - 8u;
        return (slot.v[s.w0 + 2u] >> (k * 8u)) & 0xffu;
    }
    if (i < s.prefix_bytes) {           /* the rANS flush states, at w0 + 3 */
        const uint k = i - 8u - s.fields;
        uint w = s.w0 + 3u + (k >> 2);
        return (slot.v[min(w, uint(slot.v.length()) - 1u)] >> ((k & 3u) * 8u)) &
               0xffu;
    }
    uint k = i - s.prefix_bytes;
    // [planar] The body, verbatim from the host's fit: a plain byte run,
    // four bytes to a word, low byte first.  No entropy state to unwind and
    // no emission order to reverse -- which is the whole reason the mode is
    // cheap to decode, showing up here as the simplest branch in the file.
    if (jobs[s.tile].mode == uint(NXE_MODE_PLANAR)) {
        uint wp = s.tile * uint(NXE_PLANAR_BODY_UINTS) + (k >> 2);
        return (planarb.v[min(wp, uint(planarb.v.length()) - 1u)] >>
                ((k & 3u) * 8u)) & 0xffu;
    }
    if (NXE_SC_ENTROPY_LITE != 0) {
        // ENTROPY_LITE has no rANS flush states and no emission words: the
        // payload is a plain byte run starting at the word after the field
        // word, packed four bytes to a word, low byte first.  Lite's byte
        // offsets follow from prefix sums the kernel already had, so the
        // back-to-front trick E4 needs buys nothing here.
        uint wl = s.w0 + 3u + (k >> 2);
        return (slot.v[min(wl, uint(slot.v.length()) - 1u)] >>
                ((k & 3u) * 8u)) & 0xffu;
    }
    uint w = s.wend - s.ewords + (k >> 1);
    uint v = slot.v[min(w, uint(slot.v.length()) - 1u)];
    return ((k & 1u) == 0u) ? ((v >> 8) & 0xffu) : (v & 0xffu);
}

#ifndef NXE_E5_PASS
#define NXE_E5_PASS 1
#endif

// ------------------------------------------------------- [SYN] 3.1.2
//
// A tile-row structure is PRESENT when it carries at least one coded tile; a
// row whose bit is 0 carries nothing at all -- no 12-byte header, no tile
// structures -- and decodes exactly as a row whose skip_bitmap names every
// column.  So an absent row removes NXE_ROW_HEADER_BYTES from every offset
// after it, which is what these three helpers compute.
//
// Presence is derived from E2's byte prefix rather than by rescanning the
// modes.  A coded tile always occupies at least its 8-byte header, so "this
// row spans no bytes" and "this row coded nothing" are the same statement --
// and the prefix answers it in `rowgroups` reads where the modes would cost
// `tiles_x` per row, which matters because the lanes that need this are the
// TILE lanes, one per tile.
//
// With the tool off, `rowpresent_bytes` is 0, every row is present, and each
// of these collapses to the arithmetic that was here before.
bool row_is_present(uint g, uint rowgroups) {
    uint b0 = prefix.v[g * fp.tiles_x];
    uint b1 = (g + 1u == rowgroups) ? tot.v[0]
                                    : prefix.v[(g + 1u) * fp.tiles_x];
    return b1 > b0;
}

uint rows_present_before(uint g, uint rowgroups) {
    if (fp.rowpresent_bytes == 0u) return g;
    uint n = 0u;
    for (uint r = 0u; r < g; ++r)
        if (row_is_present(r, rowgroups)) ++n;
    return n;
}

// With the tool off every row structure is emitted, present or not; with it on,
// an absent row emits nothing at all.
bool row_is_present_or_tool_off(uint g, uint rowgroups) {
    return fp.rowpresent_bytes == 0u || row_is_present(g, rowgroups);
}

uint rows_present_total(uint rowgroups) {
    if (fp.rowpresent_bytes == 0u) return rowgroups;
    uint n = 0u;
    for (uint r = 0u; r < rowgroups; ++r)
        if (row_is_present(r, rowgroups)) ++n;
    return n;
}

// The bitmap's EFFECTIVE size, which is not `fp.rowpresent_bytes` whenever the
// tool is on and this frame elides nothing.
//
// [SYN] 3.1.2 lets a frame set flags bit 4 and name every row, and that is
// legal; it is not what the REFERENCE emits, and the reference is the interop
// target.  nxv-enc sets bit 4 only when a row was actually elided, so a frame
// that elides nothing is spelled exactly as it was before the tool existed and
// enabling the tool never COSTS bytes -- on a grid where no row can ever be
// elided (every row carrying a coded tile) an unconditional bitmap is pure
// overhead, +8 B a frame at 3 row structures and +3 B at 17.
//
// Deciding it here rather than on the host is forced: presence comes from E2's
// byte prefix, which does not exist until this shader runs, while the host
// fixes `fp` before the dispatch.  So the shader owns both the flag and the
// layout it moves.
uint rp_eff(uint rowgroups) {
    if (fp.rowpresent_bytes == 0u) return 0u;
    return rows_present_total(rowgroups) == rowgroups ? 0u
                                                      : fp.rowpresent_bytes;
}

#if NXE_E5_PASS == 0
// Zero exactly the bytes this frame will occupy, so the atomicOr writes of
// pass 1 land on a clean slate.  The output buffer is dimensioned for the
// worst case -- every tile at its bounded slot size -- and filling all of that
// would cost forty times what the frame actually is, which is why this is a
// shader that reads E2's total rather than a vkCmdFillBuffer.
void main() {
    const uint rowgroups = fp.tiles_y * fp.eyes;
    // Everything the frame carries before the first tile-row header, in the
    // order SYNTAX.md 12 fixes: the 40-byte header, then warp_ext(), then the
    // transmitted table area.  Both are 0 when their tool is off.
    const uint hdr = NXE_FRAME_HEADER_BYTES + fp.warp_bytes +
                     rp_eff(rowgroups) + fp.table_bytes;
    const uint total =
        hdr + NXE_ROW_HEADER_BYTES * rows_present_total(rowgroups) + tot.v[0];
    const uint nwords = (total + 3u) >> 2;
    const uint stride = gl_NumWorkGroups.x * uint(NXE_E5_WG);
    for (uint w = gl_GlobalInvocationID.x; w < nwords; w += stride)
        if (w < uint(outb.v.length())) outb.v[w] = 0u;
}
#else

void main() {
    const uint t = gl_WorkGroupID.x;
    const uint lid = gl_LocalInvocationID.x;
    const uint rowgroups = fp.tiles_y * fp.eyes;
    // Everything the frame carries before the first tile-row header, in the
    // order SYNTAX.md 12 fixes: the 40-byte header, then warp_ext(), then the
    // transmitted table area.  Both are 0 when their tool is off.
    const uint hdr = NXE_FRAME_HEADER_BYTES + fp.warp_bytes +
                     rp_eff(rowgroups) + fp.table_bytes;
    const uint total =
        hdr + NXE_ROW_HEADER_BYTES * rows_present_total(rowgroups) + tot.v[0];

    // ---- the frame header.  Offset 0, so every one of its ten words is wholly
    // owned by this one lane; the buffer arrives zeroed from the E5 clear pass,
    // so the ORs below land exactly where the old staging uint[10] did.
    //
    // That staging array is what this replaces.  `w[o >> 2] |= ...` in the pose
    // loop is a local array indexed by a value the compiler cannot fold, which
    // on the Adreno 650 means a private-memory array -- the construct that made
    // Pass B read a local back wrong (docs/ADRENO-RULES.md).  Writing through
    // put_byte/put_word instead keeps every access chain in the SSBO, where a
    // computed index is fine.
    if (t == 0u && lid == 0u) {
        put_word(0u, fp.frame_number & 0xffffu);
        // pose[] is 26 bytes at byte offset 2; it straddles words 0..6.
        for (uint k = 0u; k < 26u; ++k)
            put_byte(2u + k, (pose.v[k >> 2] >> ((k & 3u) * 8u)) & 0xffu);
        put_word(7u, (fp.base_qp & 0xffu)                         // byte 28
                   | ((uint(fp.chroma_qp_off) & 0xffu) << 8)      // byte 29
                                                                  // byte 30 alpha_qp_off, 0
                   | ((fp.quant_matrix & 0xffu) << 24));          // byte 31
        // Byte 34's bit 4 is `row_present`, and it must agree with the
        // bitmap this frame actually carries: the host set it from the CONFIG,
        // which cannot know whether anything was elided.  Cleared when
        // `rp_eff` came back zero, so the frame is spelled exactly as a
        // tool-off frame is.
        const uint ff = (rp_eff(rowgroups) != 0u) ? (fp.frame_flags | 16u)
                                                  : (fp.frame_flags & ~16u);
        put_word(8u, (fp.tables_present & 0xffu)                  // byte 32
                   | ((fp.ref_slots & 0xffu) << 8)                // byte 33
                   | ((ff & 0xffu) << 16));                       // byte 34
                                                                  // byte 35 reserved, 0
        put_word(9u, total);
        // warp_ext(), immediately after the 40-byte header and before the
        // custom matrices this pipeline never emits.  Word-aligned at 40, so
        // these are whole-word stores like the header's own.
        for (uint k = 0u; k < (fp.warp_bytes >> 2); ++k)
            put_word(10u + k, warpext.v[k]);

        // row_present(), immediately after warp_ext() and before the custom
        // matrices this pipeline never emits ([SYN] 3.1.2).  Bit
        // `i = row * eyes + eye` of byte `i >> 3` at position `i & 7`, in the
        // decode order of 3.3 -- which is the rowgroup order this shader
        // already indexes by, so `i` IS the rowgroup.
        //
        // Bits above the last row structure must be zero, "so that one frame
        // has exactly one encoding"; the buffer arrives zeroed from pass 0 and
        // only present rows are ORed in, so they are.
        //
        // Guarded on the tool being ON.  With it off there is no bitmap and
        // offset 40 + warp_bytes is the FIRST ROW HEADER; writing there anyway
        // ORs the bitmap over that header's frame_number, which is a two-byte
        // corruption of every frame and exactly what an unguarded version of
        // this loop did.
        if (rp_eff(rowgroups) != 0u)
            for (uint g = 0u; g < rowgroups; ++g)
                if (row_is_present(g, rowgroups))
                    put_byte(NXE_FRAME_HEADER_BYTES + fp.warp_bytes + (g >> 3),
                             1u << (g & 7u));
    }

    // ---- the transmitted table area, AFTER warp_ext().  SYNTAX.md 12:
    //   frame := frame_header [warp_ext] [custom_matrices] [table_set]* ...
    // so on an inter frame with transmitted tables the base is 40 +
    // warp_bytes, not 40.  Word-aligned at neither end in general, so it goes
    // in through put_byte like the pose blob does; it is at most
    // NXE_TABLE_AREA_MAX bytes and no other lane touches the region.
    if (t == 0u) {
        for (uint k = lid; k < fp.table_bytes; k += uint(NXE_E5_WG))
            put_byte(NXE_FRAME_HEADER_BYTES + fp.warp_bytes +
                         rp_eff(rowgroups) + k,
                     (tabb.v[k >> 2] >> ((k & 3u) * 8u)) & 0xffu);
    }

    // ---- the tile-row headers, one per row group.
    if (t < rowgroups && lid == 0u && row_is_present_or_tool_off(t, rowgroups)) {
        uint g = t;
        uint off = hdr + NXE_ROW_HEADER_BYTES * rows_present_before(g, rowgroups)
                 + prefix.v[g * fp.tiles_x];
        uint row = g / fp.eyes;
        // The row's skip bitmap, bit i for column i, and the count of tiles
        // that are NOT skipped -- which is what `tile_count` means and what
        // the decoder's walk uses to know how many tile structures follow.
        // Both are derived here from the modes rather than uploaded, so they
        // cannot disagree with the tiles E4 actually sized.
        //
        // fp.tiles_x is at most 64 (kMaxTilesPerRow) and the bitmap is a u64,
        // which is why the two halves are accumulated separately: this shader
        // has no 64-bit integers and does not want them.
        uint lo = 0u, hi = 0u, coded = 0u;
        for (uint c = 0u; c < fp.tiles_x; ++c) {
            if (jobs[g * fp.tiles_x + c].mode == NXE_MODE_WARP_SKIP) {
                if (c < 32u) lo |= 1u << c;
                else hi |= 1u << (c - 32u);
            } else {
                ++coded;
            }
        }
        put_byte(off + 0u, fp.frame_number);
        put_byte(off + 1u, fp.frame_number >> 8);
        put_byte(off + 2u, row);
        // Bit 7 is dc_present, which NEAR_SKIP would set; this pipeline does
        // not implement it, so the field is the count alone.
        put_byte(off + 3u, coded);
        // Byte at a time: `off` is a row header's offset and carries
        // `prefix.v[...]`, the accumulated bytes of every earlier tile, which
        // is any value at all.  A row header is not word-aligned and the
        // whole-word store the frame header can use is wrong here.
        for (uint k = 0u; k < 4u; ++k) put_byte(off + 4u + k, lo >> (k * 8u));
        for (uint k = 0u; k < 4u; ++k) put_byte(off + 8u + k, hi >> (k * 8u));
    }

    if (t >= fp.ntiles) return;

    // ---- the tile: its 8-byte header and payload, contiguous in the slot.
    const uint nbytes = jobs[t].tile_bytes;
    const uint rowgroup = t / fp.tiles_x;
    // Its own row is present by construction -- this tile is coded, so the row
    // spans at least its bytes -- hence the `+ 1u` on the count of rows before
    // it, exactly as the old `rowgroup + 1u` was.
    const uint d0 = hdr +
                    NXE_ROW_HEADER_BYTES *
                        (rows_present_before(rowgroup, rowgroups) + 1u) +
                    prefix.v[t];
    const uint d1 = d0 + nbytes;
    const TileSlot ts = tile_slot(t);

    const uint wfirst = (d0 + 3u) >> 2;
    const uint wlast = d1 >> 2;
    for (uint w = wfirst + lid; w < wlast; w += uint(NXE_E5_WG)) {
        uint base = w * 4u - d0;
        uint val = tile_byte(ts, base) | (tile_byte(ts, base + 1u) << 8) |
                   (tile_byte(ts, base + 2u) << 16) |
                   (tile_byte(ts, base + 3u) << 24);
        if (w < uint(outb.v.length())) outb.v[w] = val;
    }

    // The head and tail bytes, which a tile shares with a row header or with
    // the next tile.  At most three at each end.
    if (lid < 8u) {
        uint head_end = min(d1, wfirst * 4u);
        uint b = d0 + lid;
        if (b < head_end) put_byte(b, tile_byte(ts, b - d0));
        uint tail_start = max(wlast * 4u, d0);
        uint c = tail_start + lid;
        if (c < d1) put_byte(c, tile_byte(ts, c - d0));
    }
}
#endif
