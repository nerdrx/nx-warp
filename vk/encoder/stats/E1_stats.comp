#version 460
// E1_stats.comp -- per-tile analysis statistics for rate control and the
// degradation ladder.
//
// SPDX-License-Identifier: Apache-2.0
//
// Paper references: 3.6 (E1 analyze, one group per tile), 4.6 (rate-control
// inputs: warped SAD, variance, mean luminance), 4.6.1 (log-variance activity
// and gradient coherence from the structure tensor feed the four tile classes
// text / edge / texture / flat), 5.2 (dQ_lum, dQ_act, dQ_motion), 3.2.6
// (subgroup portability).
//
// Shape: one workgroup per 64x64 tile, 256 lanes.  Dispatch is (num_tiles,1,1);
// it is trivially convertible to vkCmdDispatchIndirect once E1 is driven by a
// tile list rather than the full grid.
//
// Outputs one nxe_tile_stats record per tile:
//   mean luma           <- sum_luma, mean_luma_q8
//   activity            <- sum_dev_sq (log taken host-side, see tile_stats.h)
//   gradient coherence  <- j_xx, j_xy_pos/neg, j_yy from central differences
//   complexity          <- sad against the reference at the tile's offset
//   retinal slip        <- mv_qx, mv_qy, mv_mag_q4
//
// ---------------------------------------------------------------------------
// Why this is bit-exact against the CPU model on any subgroup size
// ---------------------------------------------------------------------------
// Every accumulator is an integer sum.  Integer addition is associative, and
// the u32 accumulators are associative modulo 2^32, so the reduction tree the
// hardware happens to build -- 8 lanes on lavapipe, 32 or 64 on RADV depending
// on what the driver chose that day (paper 3.7: "never assume which") -- cannot
// change the answer.  The shader reads gl_NumSubgroups and gl_SubgroupID rather
// than assuming any width, uses only subgroupAdd (core Vulkan 1.1 arithmetic,
// no clustered ops per 3.2.6), and combines across subgroups through shared
// memory with a barrier.
//
// The only rounding in the kernel is the tile mean, and it is a rounding shift
// with a literal shift amount, so it is the same everywhere.

#extension GL_GOOGLE_include_directive : require
#include "nxe_common.glsl"

layout(local_size_x = NXE_WG_SIZE, local_size_y = 1, local_size_z = 1) in;

// Source luma plane, tile-major packed (E0 output).
layout(std430, binding = 0) readonly buffer SrcPlane { uint w[]; } src;
// Reference luma plane, same layout.  When has_ref == 0 this may alias src;
// it is never read in that case.
layout(std430, binding = 1) readonly buffer RefPlane { uint w[]; } ref_;
// Per-tile prediction offset in quarter-pel, ivec2 per tile.  This is the hook
// for E0_warp: today the host writes zeros (previous frame at identity) or a
// test pattern, tomorrow the warp pass writes the corner-displacement-derived
// integer offset here.  Only the integer part is used for the SAD; the
// fractional quarter-pel part is carried through to the record for 5.2's
// dQ_motion and will drive the bit-exact 4-tap predictor in E2_transform.
layout(std430, binding = 2) readonly buffer Offsets { ivec2 mv[]; } off;
layout(std430, binding = 3) writeonly buffer Stats { nxe_tile_stats s[]; } out_;

layout(push_constant) uniform PC {
    uint width;
    uint height;
    uint tiles_x;
    uint tiles_y;
    uint plane_y_off;
    uint plane_co_off;
    uint plane_cg_off;
    uint flags;
    uint plane_words;
    uint num_tiles;
    uint has_ref;
    uint pad_;
} pc;

// The tile's luma, unpacked to int32 once and reused by the gradient pass, the
// moment pass and the deviation pass.  16 KB, within the 32 KB Adreno budget
// so the same shape survives if E1 is ever wanted on a headset.
shared int s_luma[NXE_TILE_PIXELS];

// Cross-subgroup reduction scratch: 7 lanes wide so one barrier pair covers
// the whole moment/tensor/SAD reduction.
#define NXE_RED_LANES 7
shared uint s_red[NXE_MAX_SUBGROUPS][NXE_RED_LANES];

// Reduce NXE_RED_LANES values at once.  Uniform control flow; every thread
// leaves with the full workgroup total, so no broadcast step is needed.
//
// The seven accumulators travel as a uvec4 plus a uvec3 rather than as a
// uint[7].  A local array is bad enough on Adreno -- it is lowered to private
// (scratch) memory instead of registers, and Pass B measured one being read back
// wrong (docs/ADRENO-RULES.md) -- and an `inout` array parameter is worse: on
// top of the scratch allocation glslang copies the whole array in at the call
// and back out at the return.  Vector components are registers everywhere and
// every access below is a constant component select.  s_red stays an array
// because it is `shared`: LDS is addressable and is the rewrite the rule asks
// for.
void wg_reduce_n(inout uvec4 lo, inout uvec3 hi) {
    uvec4 sg_lo = uvec4(subgroupAdd(lo.x), subgroupAdd(lo.y),
                        subgroupAdd(lo.z), subgroupAdd(lo.w));
    uvec3 sg_hi = uvec3(subgroupAdd(hi.x), subgroupAdd(hi.y), subgroupAdd(hi.z));
    if (subgroupElect()) {
        s_red[gl_SubgroupID][0] = sg_lo.x;
        s_red[gl_SubgroupID][1] = sg_lo.y;
        s_red[gl_SubgroupID][2] = sg_lo.z;
        s_red[gl_SubgroupID][3] = sg_lo.w;
        s_red[gl_SubgroupID][4] = sg_hi.x;
        s_red[gl_SubgroupID][5] = sg_hi.y;
        s_red[gl_SubgroupID][6] = sg_hi.z;
    }
    barrier();
    uvec4 t_lo = uvec4(0u);
    uvec3 t_hi = uvec3(0u);
    for (uint i = 0u; i < gl_NumSubgroups; ++i) {
        t_lo.x += s_red[i][0];
        t_lo.y += s_red[i][1];
        t_lo.z += s_red[i][2];
        t_lo.w += s_red[i][3];
        t_hi.x += s_red[i][4];
        t_hi.y += s_red[i][5];
        t_hi.z += s_red[i][6];
    }
    barrier();   // s_red is reusable after this
    lo = t_lo;
    hi = t_hi;
}

uint wg_reduce1(uint v) {
    uint sg = subgroupAdd(v);
    if (subgroupElect()) s_red[gl_SubgroupID][0] = sg;
    barrier();
    uint t = 0u;
    for (uint i = 0u; i < gl_NumSubgroups; ++i) t += s_red[i][0];
    barrier();
    return t;
}

// Clamped luma fetch from a tile-major packed plane at absolute frame coords.
// The tile-major address arithmetic is 4 shifts and a mad; cheaper than the
// alternative of keeping a second linear copy of the reference around.
int fetch_ref(int x, int y) {
    x = clamp(x, 0, int(pc.width) - 1);
    y = clamp(y, 0, int(pc.height) - 1);
    uint tx = uint(x) >> 6;
    uint ty = uint(y) >> 6;
    uint t  = ty * pc.tiles_x + tx;
    uint i  = uint((y & 63) * NXE_TILE_SIZE + (x & 63));
    uint idx = pc.plane_y_off + t * uint(NXE_LUMA_WORDS_PER_TILE) + (i >> 1);
    uint w = (idx < pc.plane_words) ? ref_.w[idx] : 0u;
    return nxe_unpack(w, int(i & 1u));
}

// In-tile neighbour, replicating at the tile border.  Confining the
// gradient to the tile keeps a tile's tensor a function of that tile alone --
// no cross-tile reads, which the tile-major layout makes expensive and which
// would couple neighbouring workgroups for a statistic that does not need it.
int lum(int x, int y) {
    return s_luma[clamp(y, 0, 63) * NXE_TILE_SIZE + clamp(x, 0, 63)];
}

void main() {
    uint tile = gl_WorkGroupID.x;
    if (tile >= pc.num_tiles) return;
    uint lid = gl_LocalInvocationID.x;

    uint ybase = nxe_tile_word_base(pc.plane_y_off, tile, uint(NXE_LUMA_WORDS_PER_TILE));

    // ---- load the tile into LDS, fully coalesced (8 words per lane).
    for (uint w = lid; w < uint(NXE_LUMA_WORDS_PER_TILE); w += uint(NXE_WG_SIZE)) {
        uint idx = ybase + w;
        uint packed = (idx < pc.plane_words) ? src.w[idx] : 0u;
        s_luma[w * 2u + 0u] = nxe_unpack_lo(packed);
        s_luma[w * 2u + 1u] = nxe_unpack_hi(packed);
    }
    barrier();

    uint tx = tile % pc.tiles_x;            // integer div/mod on a workgroup-
    uint ty = tile / pc.tiles_x;            // uniform value, once per group;
                                            // outside the normative path.
    int org_x = int(tx) * NXE_TILE_SIZE;
    int org_y = int(ty) * NXE_TILE_SIZE;

    ivec2 mvq = (tile < pc.num_tiles) ? off.mv[tile] : ivec2(0);
    // Integer-pel part of the quarter-pel offset, truncated towards zero the
    // same way on GPU and CPU: an arithmetic shift would floor, so the sign is
    // handled explicitly.
    ivec2 mvi = ivec2(mvq.x / 4, mvq.y / 4);

    // ---- pass 1: moments, structure tensor, SAD.  16 pixels per lane,
    // strided so the LDS access pattern is bank-conflict friendly.
    // acc[0..3] and acc[4..6] of the old uint[NXE_RED_LANES]; see wg_reduce_n.
    uvec4 acc_lo = uvec4(0u);   // sum, sumsq, j_xx, j_xy_pos
    uvec3 acc_hi = uvec3(0u);   // j_xy_neg, j_yy, sad

    for (uint p = lid; p < uint(NXE_TILE_PIXELS); p += uint(NXE_WG_SIZE)) {
        int px = int(p & 63u);
        int py = int(p >> 6);
        int v  = s_luma[p];

        acc_lo.x += uint(v);
        acc_lo.y += uint(v * v);

        // Central difference, the operator rc/ calibrated its thresholds
        // against, with the neighbour clamped inside the tile exactly as rc
        // clamps it.  The difference is accumulated undivided -- halving it
        // would need a fraction, and the whole point of this kernel is that it
        // has none -- so the record's tensor is 4x rc/'s.  See tile_stats.h.
        int gx = lum(px + 1, py) - lum(px - 1, py);
        int gy = lum(px, py + 1) - lum(px, py - 1);
        int xy = gx * gy;
        acc_lo.z += uint(gx * gx);
        acc_lo.w += uint(max(xy, 0));    // positive contributions
        acc_hi.x += uint(max(-xy, 0));   // negative contributions, unsigned
        acc_hi.y += uint(gy * gy);

        if (pc.has_ref != 0u) {
            int r = fetch_ref(org_x + px + mvi.x, org_y + py + mvi.y);
            acc_hi.z += uint(abs(v - r));
        }
    }

    wg_reduce_n(acc_lo, acc_hi);

    uint sum    = acc_lo.x;
    uint sumsq  = acc_lo.y;
    uint jxx    = acc_lo.z;
    uint jxy_p  = acc_lo.w;
    uint jxy_n  = acc_hi.x;
    uint jyy    = acc_hi.y;
    uint sad    = acc_hi.z;

    // ---- pass 2: sum of squared deviations about the rounded integer mean.
    // The tile is already in LDS, so this is one more sweep with no memory
    // traffic -- the "tiny second pass" the variance needs, kept on the GPU
    // because it costs almost nothing here and saves rc/ a second read of the
    // raw moments.  mean_int = round(sum / 4096) = (sum + 2048) >> 12.
    int mean_int = int((sum + 2048u) >> 12);
    uint dev = 0u;
    for (uint p = lid; p < uint(NXE_TILE_PIXELS); p += uint(NXE_WG_SIZE)) {
        int d = s_luma[p] - mean_int;
        dev += uint(d * d);
    }
    dev = wg_reduce1(dev);

    if (lid == 0u) {
        uint fl = pc.flags;
        if (pc.has_ref != 0u) fl |= NXE_TS_F_SAD_VALID;
        // A tile that reaches past the frame carries replicated samples in its
        // statistics; rc/ may want to down-weight it.
        if (uint(org_x + NXE_TILE_SIZE) > pc.width || uint(org_y + NXE_TILE_SIZE) > pc.height)
            fl |= NXE_TS_F_PADDED;

        nxe_tile_stats o;
        o.sum_luma     = sum;
        o.sum_sq_luma  = sumsq;
        o.mean_luma_q8 = (sum + 8u) >> 4;    // round(sum/4096) in Q8.8
        o.sum_dev_sq   = dev;
        o.j_xx         = jxx;
        o.j_xy_pos     = jxy_p;
        o.j_xy_neg     = jxy_n;
        o.j_yy         = jyy;
        o.sad          = sad;
        o.mv_qx        = mvq.x;
        o.mv_qy        = mvq.y;
        o.mv_mag_q4    = nxe_isqrt(uint(mvq.x * mvq.x + mvq.y * mvq.y));
        o.flags        = fl;
        out_.s[tile] = o;
    }
}
