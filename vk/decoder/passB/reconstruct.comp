                    uint w2 = sPlane[rb + 2], w3 = sPlane[rb + 3];
                    idct8_1d(unpack16(w0, 0), unpack16(w0, 1), unpack16(w1, 0),
                             unpack16(w1, 1), unpack16(w2, 0), unpack16(w2, 1),
                             unpack16(w3, 0), unpack16(w3, 1),
                             y0, y1, y2, y3, y4, y5, y6, y7);
