            int qsh = dirQsh(lb);
            int nsteps = dirStepCount(nb, qsh);
            int lanes = kXformLarge != 0 ? ((bs * bs) >> 2)
                                         : kDirLanesPerBlock;
            int cpLog2 = lb - 1;              // log2 of the column pairs
            int slot = tid / lanes;
            int lane = tid - slot * lanes;
            int cp = lane & ((1 << cpLog2) - 1), jg = lane >> cpLog2;
            int i0 = 2 * cp;
            int kSlots = 256 / lanes;
            for (int step = 0; step < nsteps; ++step) {
                int nblocks = dirStepBlocks(step, nb, nbLog2, qsh);
                for (int g = slot; g < nblocks; g += kSlots) {
