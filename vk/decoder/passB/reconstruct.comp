                    A[0] = dirAt(store, size, nb, bs, lb, wbx, wby, x0 - 1,
                                 y0 - 1);
                    L[0] = A[0];
                    // 2n long at every size, so DDL reaches A[2n-1] and the
                    // above-right dependency is one block wide however large
                    // the block is ([SYN] 7.4).
                    for (int k = 0; k < 2 * bs; ++k) {
                        // nxvc-lint: allow dynamic-local-array-index -- 7.4's reference arrays; the bound is 2*bs and only the transform size makes it non-literal.  predictOne() records what reading them one at a time instead does to an Adreno 650: it miscompiles.
                        A[1 + k] = dirAt(store, size, nb, bs, lb, wbx, wby,
                                         x0 + k, y0 - 1);
                        // nxvc-lint: allow dynamic-local-array-index -- as above
                        L[1 + k] = dirAt(store, size, nb, bs, lb, wbx, wby,
                                         x0 - 1, y0 + k);
                    }
                    int b = wby * nb + wbx;
                    int blockMode =
                        int((uModes.w[modeBase + p * NXVW_MODE_WORDS_PER_PLANE +
                                      b / int(NXVW_MODES_PER_UINT)] >>
                             (uint(b % int(NXVW_MODES_PER_UINT)) * NXVW_MODE_BITS)) &
                            NXVW_MODE_MASK);
                    // [minor 6] INTRA_CFL: the model is fitted ONCE per
                    // block, from the same reconstructed neighbours the other
                    // predictors read, and then evaluated per sample.
                    int cflAlpha = 0, cflBaseL = 0, cflBaseC = 0;
                    if (blockMode == kIntraCfl)
                        cflFit(store, size, nb, bs, lb, wbx, wby, lumaStore,
                               lumaSize, cflF, x0, y0, cflAlpha, cflBaseL,
                               cflBaseC);
                    for (int h = 0; h < 2; ++h) {
                        int c = 2 * jg + h;
                        int yy = y0 + c;
                        int e = yy * size + x0 + i0;
                        uint packed = sPlane[store + (e >> 1)];
                        int p0, p1;
                        if (blockMode == kIntraCfl) {
                            p0 = cflPredictOne(lumaStore, lumaSize, cflF,
                                               maxval, cflAlpha, cflBaseL,
                                               cflBaseC, x0 + i0, yy);
                            p1 = cflPredictOne(lumaStore, lumaSize, cflF,
                                               maxval, cflAlpha, cflBaseL,
                                               cflBaseC, x0 + i0 + 1, yy);
                        } else {
                            p0 = predictOne(blockMode, A, L, nb, bs, lb, wbx,
                                            wby, i0, c);
                            p1 = predictOne(blockMode, A, L, nb, bs, lb, wbx,
                                            wby, i0 + 1, c);
                        }
                        int v0 = p0 + unpack16(packed, 0);
                        int v1 = p1 + unpack16(packed, 1);
                        int r0, r1;
                        if (pc.p.dirLayer != 0) {
                            // The mode predicts the DC-plane residual; what is
                            // stored for later blocks is that residual.
                            int b0 = dirPred(nb, bs, lb, x0 + i0, yy);
                            int b1 = dirPred(nb, bs, lb, x0 + i0 + 1, yy);
                            r0 = clamp(b0 + v0, 0, maxval) - b0;
                            r1 = clamp(b1 + v1, 0, maxval) - b1;
                        } else {
                            r0 = clamp(v0, 0, maxval);
                            r1 = clamp(v1, 0, maxval);
                        }
                        sPlane[store + (e >> 1)] = pack16x2(r0, r1);
                    }
                }
                barrier();
            }
            if (pc.p.dirLayer != 0) {
                // recon -> samples: sample = pred + recon, exactly, because
                // recon was formed as clamp(pred + v) - pred.
                for (int w = tid; w < (size * size) >> 1; w += 256) {
                    int e = w << 1;
                    int x = e % size, y = e / size;
                    uint packed = sPlane[store + w];
                    int r0 = unpack16(packed, 0), r1 = unpack16(packed, 1);
                    sPlane[store + w] =
                        pack16x2(dirPred(nb, bs, lb, x, y) + r0,
                                 dirPred(nb, bs, lb, x + 1, y) + r1);
                }
                barrier();
            }
        }
#endif

        coefBase += ndc + ndc * ncoef;
        unitBase += unitsPerPlaneExtra + ndc;
    }

    // ------------------------------------------------- display conversion
    // Scalars for the same reason as planeStoreBase above.
    // [REF] plane_full_extent(): a chroma plane is half size only when the
    // *stream* is 4:2:0; inside a 4:4:4 stream a 4:2:0 tile is upsampled
    // straight to 64 in one step.
    int sizeP0 = nxvw_plane_size(0, res_level, chroma444);
    int sizeP1 = nxvw_plane_size(1, res_level, chroma444);
    int sizeP2 = nxvw_plane_size(2, res_level, chroma444);
    int sizeP3 = nxvw_plane_size(3, res_level, chroma444);
    int chromaFull = pc.p.chroma420 != 0 ? 32 : 64;
    int fullP0 = 64, fullP1 = chromaFull, fullP2 = chromaFull, fullP3 = 64;

    int ox = tileX * 64, oy = tileY * 64;

    // Both stores run off the same reconstruction; `kOutSecond` is a
    // specialization constant, so a pipeline that does not want one compiles
    // to exactly the single-store kernel it did before.
    for (int store_pass = 0; store_pass < 2; ++store_pass) {
    int fmt = store_pass == 0 ? kOutFormat : kOutSecond;
    if (fmt == kOutNone) break;

    // ---------------------------------- two-plane 4:2:0 YCbCr passthrough
    // No colour transform, no chroma upsampling: the planes go out exactly as
    // the stream carries them.  Luma is written at full resolution, Cb/Cr
    // interleaved at half.  Requires a 4:2:0 stream and colour_transform none.
    if (fmt == kOutYcbcr420) {
        for (int k = 0; k < 16; ++k) {
            int idx = k * 256 + tid;
            int x = idx & 63, y = idx >> 6;
            int gx = ox + x, gy = oy + y;
            if (gx >= pc.p.imageW || gy >= pc.p.imageH) continue;
            int Y = clamp(planeAtFull(planeStoreBase0, sizeP0, 64, x, y), 0, 255);
            if (kUnormStore != 0)
                imageStore(uOutLumaN, ivec2(gx, gy),
                           vec4(nxvw_unorm8(Y), 0.0, 0.0, 0.0));
            else
                imageStore(uOutLuma, ivec2(gx, gy), uvec4(uint(Y), 0u, 0u, 0u));
        }
        int cw = (pc.p.imageW + 1) >> 1, ch = (pc.p.imageH + 1) >> 1;
        int cox = tileX * 32, coy = tileY * 32;
        for (int k = 0; k < 4; ++k) {
            int idx = k * 256 + tid;
            int x = idx & 31, y = idx >> 5;
            int gx = cox + x, gy = coy + y;
            if (gx >= cw || gy >= ch) continue;
            int Cb = clamp(planeAtFull(planeStoreBase1, sizeP1, 32, x, y), 0, 255);
            int Cr = clamp(planeAtFull(planeStoreBase2, sizeP2, 32, x, y), 0, 255);
            if (kUnormStore != 0)
                imageStore(uOutCbCrN, ivec2(gx, gy),
                           vec4(nxvw_unorm8(Cb), nxvw_unorm8(Cr), 0.0, 0.0));
            else
                imageStore(uOutCbCr, ivec2(gx, gy), uvec4(uint(Cb), uint(Cr), 0u, 0u));
        }
        continue;
    }

    for (int k = 0; k < 16; ++k) {
        int idx = k * 256 + tid;
        int x = idx & 63, y = idx >> 6;
        int gx = ox + x, gy = oy + y;
        if (gx >= pc.p.imageW || gy >= pc.p.imageH) continue;

        int P0 = planeAtDisplay(planeStoreBase0, sizeP0, fullP0, x, y);
        int P1 = planeAtDisplay(planeStoreBase1, sizeP1, fullP1, x, y);
        int P2 = planeAtDisplay(planeStoreBase2, sizeP2, fullP2, x, y);

        int R, G, B;
        if (pc.p.colorTransform == kCtYCoCgR) {
            // [REF] nxvc_ycocgr_inverse.
            int Y = P0;
            int Co = P1 - kDcOffsetChromaCT;
            int Cg = P2 - kDcOffsetChromaCT;
            int t = Y - (Cg >> 1);
            G = Cg + t;
            B = t - (Co >> 1);
            R = B + Co;
        } else {
            R = P0; G = P1; B = P2;
        }
        R = clamp(R, 0, 255);
        G = clamp(G, 0, 255);
        B = clamp(B, 0, 255);

        int A = 255;
        if (alpha_mode == kAlphaConstant) {
            A = nxvw_rec_alpha_value(rec.w2);
        } else if (alpha_mode == kAlphaCoded) {
            A = clamp(planeAtDisplay(planeStoreBase3, sizeP3, fullP3, x, y),
                      0, 255);
        }

        if (fmt == kOutRgb10A2) {
            // 8-bit samples replicated into 10 bits; see syntax_constants.h.
            uvec4 v = uvec4(uint((R << 2) | (R >> 6)), uint((G << 2) | (G >> 6)),
                            uint((B << 2) | (B >> 6)), uint(A >> 6));
            imageStore(uOutRgb10a2, ivec2(gx, gy), v);
        } else if (kUnormStore != 0) {
            imageStore(uOutRgba8N, ivec2(gx, gy),
                       vec4(nxvw_unorm8(R), nxvw_unorm8(G), nxvw_unorm8(B),
                            nxvw_unorm8(A)));
        } else {
            imageStore(uOutRgba8, ivec2(gx, gy),
                       uvec4(uint(R), uint(G), uint(B), uint(A)));
        }
    }
    }  // store_pass

    // [inter] The reference-ring slot is a second store of the same samples,
    // in the coded domain rather than the display one.
    // vk/decoder/inter/inter_hook.glsl.
    nxvwRefRingStore(tid, tile, tileX, tileY, res_level, chroma444, alpha_mode,
                     nxvw_rec_alpha_value(rec.w2), planeStoreBase0,
                     planeStoreBase1, planeStoreBase2, planeStoreBase3);
}
