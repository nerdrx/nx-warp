                    if (hf == 0) {
                        res0[0] = clamp16((y0 + kIdctRound2) >> kIdctShift2);
                        res0[1] = clamp16((y1 + kIdctRound2) >> kIdctShift2);
                        res0[2] = clamp16((y2 + kIdctRound2) >> kIdctShift2);
                        res0[3] = clamp16((y3 + kIdctRound2) >> kIdctShift2);
                        res0[4] = clamp16((y4 + kIdctRound2) >> kIdctShift2);
                        res0[5] = clamp16((y5 + kIdctRound2) >> kIdctShift2);
                        res0[6] = clamp16((y6 + kIdctRound2) >> kIdctShift2);
                        res0[7] = clamp16((y7 + kIdctRound2) >> kIdctShift2);
                    } else {
                        res1[0] = clamp16((y0 + kIdctRound2) >> kIdctShift2);
                        res1[1] = clamp16((y1 + kIdctRound2) >> kIdctShift2);
                        res1[2] = clamp16((y2 + kIdctRound2) >> kIdctShift2);
                        res1[3] = clamp16((y3 + kIdctRound2) >> kIdctShift2);
                        res1[4] = clamp16((y4 + kIdctRound2) >> kIdctShift2);
                        res1[5] = clamp16((y5 + kIdctRound2) >> kIdctShift2);
                        res1[6] = clamp16((y6 + kIdctRound2) >> kIdctShift2);
                        res1[7] = clamp16((y7 + kIdctRound2) >> kIdctShift2);
                    }
                }
            }
            barrier();
        }

        // ------------------------------- prediction, add, clamp, write out
        // [v3 fast path] `dir` only forces the wavefront when some block of
        // this plane names a mode other than 0.  Mode 0 is the DC-plane
        // predictor, which reads no neighbour, so an all-zero mode plane
        // reconstructs bit-identically down the parallel path -- in the
        // layered form too, where the store-then-convert pair collapses to
        // `clamp(pred + res)` exactly as it does here.
        bool useDir = dir && sModesNz != 0u;
        if (!useDir) {
            if (live) {
                int col0 = bx * bs + 2 * sub;
                // The planar predictor samples at (2x - 7, 2y - 7) at bs == 8,
                // and at [SYN] 7.2's general Q4 mapping above it, so a
                // thread's two columns give two x halves that do not change
                // over its `bs` rows.  Hoisting them, and sharing the y half
                // between the two columns, is the whole of the saving; the
                // arithmetic is unchanged and the output is bit-identical.
                int px0, px1, pfx;
                bilinMeansX(nb, planarQ4(col0, bs, lb), px0, px1, pfx);
                // At bs == 8 the odd column shares px0/px1 -- see
                // bilinMeansY2 -- so only its fraction is needed: the Q4 step
                // between the two columns is 2 and the pair is 2-aligned, so
                // it can never straddle a 16-wide mean cell.
                //
                // **That stops being true at 16 and 32**, and it is the one
                // place where re-gridding the DC plane is not just a change
                // of constants.  The Q4 step is 16/bs, so the mean grid is
                // finer relative to the block than the sample grid is, and
                // the pair straddles a cell at columns 6, 22, 38 and 54 of a
                // 16x16 plane and 14 and 46 of a 32x32 one.  The odd column
                // therefore gets its own x half there.
                int qx0 = px0, qx1 = px1, qfx;
                if (kXformLarge != 0 && bs > kBlock)
                    bilinMeansX(nb, planarQ4(col0 + 1, bs, lb), qx0, qx1, qfx);
                else
                    qfx = planarQ4(col0 + 1, bs, lb) & (kBilinOne - 1);
                // The four block means a row needs change only when the row
                // crosses a mean cell, which over an 8x8 block's eight rows
                // happens once (the same argument as for the columns:
                // 2*y - 7 spans 14 of a 16-wide cell) and over a larger
                // block's rows a handful of times, because the Q4 step per
                // row is 16/bs.  Reloading them only when the row pair
                // actually moves turns four LDS loads per row into four per
                // cell -- and the loads, not the multiplies, are what this
                // predictor costs.
                //
                // The cache key is the UNCLAMPED quotient, not the clamped row
                // base: at the top edge qy goes -1 then 0, which clamp maps to
                // the same r0 but to different r1 (0 and nb), so keying on r0
                // would serve the first row of the second cell stale means.
                // 0x7fffffff is not a value qy can take.
                int rp = 0x7fffffff;
                int m00 = 0, m01 = 0, m10 = 0, m11 = 0;
                // The odd column's four, which are the same four unless the
                // pair straddles a cell.  With kXformLarge specialized to 0
                // the copies below are the identity and the four extra loads
                // do not exist.
                int n00 = 0, n01 = 0, n10 = 0, n11 = 0;
                for (int c = 0; c < bs; ++c) {
                    int yy = by * bs + c;
                    int sy = planarQ4(yy, bs, lb);
                    int qy = sy >> kBilinFracBits;
                    int fy = sy & (kBilinOne - 1);
                    if (qy != rp) {
                        int r0 = clamp(qy, 0, nb - 1) * nb;
                        int r1 = clamp(qy + 1, 0, nb - 1) * nb;
                        m00 = sMeans[r0 + px0];
                        m01 = sMeans[r0 + px1];
                        m10 = sMeans[r1 + px0];
                        m11 = sMeans[r1 + px1];
                        if (kXformLarge != 0 && bs > kBlock) {
                            n00 = sMeans[r0 + qx0];
                            n01 = sMeans[r0 + qx1];
                            n10 = sMeans[r1 + qx0];
                            n11 = sMeans[r1 + qx1];
