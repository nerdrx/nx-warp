#version 460
// NX Warp decoder, Pass W: the inter predictor.
//
// One workgroup per 64x64 tile, 256 invocations.  For every coded plane of an
// inter tile it produces the samples the residual is measured against and
// writes them to the WPred buffer, which Pass B's prediction hook reads.  It
// is a third dispatch and not a stage of Pass B for one reason: Pass B's
// kernel belongs to the intra path and the inter path does not get to
// restructure it (vk/decoder/README.md, "the prediction hook").
//
//   ring slot ---> warp_tile ---> box average to the coded extent
//                                   ---> [+ the near-skip mean field]
//                                     ---> WPred ---> Pass B
//
// Everything between `warp_tile_corners` and `sample_bilinear` below is a
// LINE-FOR-LINE twin of warp/ref/warp_ref.cpp, which is the normative
// implementation, and of warp/glsl/warp_tile.comp, which is that file's
// existing GLSL twin.  The three MUST agree on every bit of every sample.
// What this kernel adds around them is the plane loop, the reference-ring
// addressing, the res_level box average and the near-skip mean field --
// ref/src/inter.cpp `warp_plane_tile_quad`, ref/src/codec_impl.inc
// `predict_tile`, and ref/src/codec.cpp `reconstruct_near_skip` respectively.
//
// Portability (PAPER 3.2.6), the same rules warp_tile.comp is held to:
//   * no subgroup op at all; the only cross-lane exchange is the four corner
//     coordinates and the near-skip means, both through shared memory
//   * no shaderInt64: 64-bit intermediates are (hi, lo) uint pairs built with
//     umulExtended, which is core SPIR-V
//   * no float anywhere
//   * no hardware sampler: explicit integer loads, because sampler weight
//     precision is vendor-specific
//   * one SPIR-V binary on every vendor, no #ifdefs
//
// SPDX-License-Identifier: Apache-2.0

#extension GL_GOOGLE_include_directive : require
#include "../passB/syntax_constants.h"
#include "../passB/passB_layout.h"
#include "inter_layout.h"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ------------------------------------------------------------- bindings
layout(set = 0, binding = 0, std430) readonly buffer RefRing { uint w[]; } uRing;
layout(set = 0, binding = 1, std430) readonly buffer WarpParams { uint w[]; } uWarp;
layout(set = 0, binding = 2, std430) writeonly buffer WPred { uint w[]; } uWPred;
// The host's workgroup -> tile map, the same buffer Pass B reads.  Pass W used
// to take gl_WorkGroupID.x as the tile index, which is correct only while it
// dispatches over every tile in raster order; going through the map lets one
// dispatch cover any contiguous RANGE of build_tile_order()'s partition, which
// is what a WARP_SKIP pipeline needs.  One uint load per workgroup, and every
// write address still comes from the tile index rather than the workgroup id,
// so the output is unchanged.
layout(set = 0, binding = 3, std430) readonly buffer TileOrder { uint i[]; } uOrder;

layout(push_constant) uniform Push { NxvwWarpPush p; } pc;

// The 64x64 predictor block, i16 packed two per uint.  8 KB, which is inside
// every device this decoder runs on and leaves Pass B's own 12.5-24.5 KB
// untouched because the two are different pipelines.
shared uint sFull[(kWarpTile * kWarpTile) / 2];
shared ivec2 sCorner[4];
shared int sMeans[64];

// The two things warp_pred.glsl does not contain, because they are the two
// things its two callers differ in: where the parameters and the ring are
// bound, and where the finished samples go.  Pass B's WARP_SKIP module
// (passB/reconstruct.comp, NXVW_SKIP_STORE) defines the same four against its
// own bindings and its own plane slot.
uint nxvwWarpParam(uint i) { return uWarp.w[i]; }
uint nxvwRingWord(uint i) { return uRing.w[i]; }
uint nxvwWarpScratchRead(int i) { return sFull[i]; }
void nxvwWarpScratchWrite(int i, uint v) { sFull[i] = v; }
// The finished plane goes straight out to WPred, one pair a word, from
// wherever the driver produced it -- the same single write per sample pair
// this kernel has always done.  `gWpBase` is the tile-and-plane base the plane
// loop below sets; a parameter would have to travel through the driver, which
// has no business knowing this buffer exists.
int gWpBase = 0;
void nxvwWarpEmit(int i, uint v) {
    uWPred.w[uint(gWpBase + 2 * i) >> 1u] = v;
}

#include "warp_pred.glsl"

void main() {
    const int tid = int(gl_LocalInvocationID.x);
    const int tile = int(uOrder.i[gl_WorkGroupID.x]);
    if (tile >= pc.p.tileCount) return;

    const uint tb = uint(NXVW_WARP_HDR_UINTS + tile * NXVW_WARP_TILE_UINTS);
    const uint w0 = uWarp.w[tb];
    if (nxvw_wt_inter(w0) == 0) return;      // an INTRA tile: nothing to do
    const int eye = nxvw_wt_eye(w0);
    if (pc.p.eyeFilter >= 0 && eye != pc.p.eyeFilter) return;

    const int mode = nxvw_wt_mode(w0);
    const int res_level = nxvw_wt_res_level(w0);
    const int chroma444 = nxvw_wt_chroma444(w0);
    const int alpha_mode = nxvw_wt_alpha_mode(w0);
    const int quad = nxvw_wt_quad(w0);
    const int near_skip = nxvw_wt_near_skip(w0);
    const int tx = int(uWarp.w[tb + 1u]);
    const int ty = int(uWarp.w[tb + 2u]);
    const int mvx = int(uWarp.w[tb + 3u]);
    const int mvy = int(uWarp.w[tb + 4u]);
    const uint qbits = uWarp.w[tb + 5u];
    const uint refBase = uWarp.w[tb + 6u];
    const int tileQp = int(uWarp.w[tb + 7u]);

    // [SYN] 13.3 step 3 and 4.1: STATIC_MV and STEREO take the identity
    // corners and never touch the matrix; WARP_SKIP and WARP_MV take the
    // frame's.  `refBase == 0xffffffff` is "this frame holds no usable
    // reference", which only a skipped tile can reach: the reference decoder
    // then leaves the tile mid-grey rather than inventing a picture, and a
    // CODED tile in the same position is a malformed stream the host has
    // already refused.
    const bool noref = (refBase == 0xffffffffu);
    const int wmode = (mode == kModeWarpSkip || mode == kModeWarpMv)
                          ? kWarpModeWarp
                          : kWarpModeStatic;
    // A STEREO tile predicts from the FIRST eye of this frame, so its
    // reference sub-picture is eye 0 whatever eye the tile is in
    // ([SYN] 13.1).  The row order of 3.3 is what makes that eye available,
    // and on the GPU it is a second dispatch: see `eyeFilter`.
    const int refEye = (mode == kModeStereo) ? 0 : eye;

    const int nplanes = (pc.p.alphaPresent != 0) ? 4 : 3;
    int ncoded = nplanes;
    if (alpha_mode != kAlphaCoded) ncoded = min(ncoded, 3);

    for (int p = 0; p < 4; ++p) {
        if (p >= ncoded) break;   // uniform across the workgroup

        const bool chroma = (p == 1 || p == 2);
        const int full = nxvw_inter_plane_full(p, pc.p.chroma420);
        const int sub = nxvw_inter_plane_sub(p, pc.p.chroma420);
        const int size = nxvw_plane_size(p, res_level, chroma444);
        gWpBase =
            tile * pc.p.wpredStrideI16 + nxvw_wpred_plane_off(p, pc.p.chroma420);

        // The whole plane, predicted into sFull and emitted to WPred at coded
        // extent.  inter/warp_pred.glsl.
        nxvwWarpPlane(tid, p, tb, size, full, sub, eye, refEye, wmode,
                      chroma ? pc.p.chromaW : pc.p.eyeW,
                      chroma ? pc.p.chromaH : pc.p.eyeH,
                      near_skip, quad, tileQp, qbits, refBase, mvx, mvy, tx,
                      ty);
    }
}
