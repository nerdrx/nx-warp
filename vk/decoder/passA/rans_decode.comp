#version 460
// NX Warp decoder, Pass A: interleaved rANS entropy decode.
//
// One workgroup decodes TILES_PER_GROUP tiles; each tile is decoded by LANES
// interleaved rANS lanes.  The workgroup is always 64 threads and
// TILES_PER_GROUP * LANES <= 64.
//
// The lanes of a tile share ONE read pointer into the tile's byte stream.
// Within a scheduling round the lanes that renormalise consume 16-bit words
// in ascending lane order; a ballot over the LANES-wide cluster plus an
// exclusive bit count gives each lane its offset, and the cluster advances
// the pointer by the popcount.  READ_PTR_MODE == 1 selects an LDS-based
// fallback that computes the identical offsets without any subgroup op, for
// devices with subgroupSize < LANES or unreliable ballot.
//
// [nxvc_vk_decoder glue, marked edit] LANES was a compile-time 8 until the
// tile header's nsub_log2 became a free per-tile field (docs/SYNTAX.md 4.1,
// vectors v24/v25/v26).  It is now specialisation constant 2 and the host
// issues one dispatch per distinct lane count present in the frame.  The
// three other changes in this file carry the same marker:
//   * the coefficient / CBF base comes from the tile descriptor rather than
//     from `tile * coef_stride`, so a dispatch may cover an arbitrary subset
//     of the frame's tiles in any order;
//   * `active = min(LANES, nunits)` follows ref/src/entropy.cpp
//     decode_units(), which initialises only that many rANS states;
//   * threads whose tile slot is >= TILES_PER_GROUP idle through the
//     schedule (all barriers stay workgroup-uniform).
//
// All normative arithmetic is int32/uint32.  There is no float and no
// division anywhere in the per-symbol path.
//
// Every bitstream constant comes from syntax_constants.h.  See README.md.

#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "syntax_constants.h"

// ---------------------------------------------------------------------------
// Specialisation constants
// ---------------------------------------------------------------------------
layout(constant_id = 0) const uint READ_PTR_MODE = 0;   // kReadPtrBallot
layout(constant_id = 1) const uint TILES_PER_GROUP = 8; // kTilesPerGroup
// [marked edit] 2: rANS lanes per tile, 1 << nsub_log2, 1..32.
layout(constant_id = 2) const uint LANES = 8;           // kLanes
// [entropy-lite] 3: which entropy tool this dispatch decodes.
//   kEntropyRans (0)       the interleaved rANS path, unchanged in every
//                          respect -- same code, same schedule, same output.
//   kEntropyLiteFixed (1)  ENTROPY_LITE / FIXED (stream tool bit 24): one
//                          workgroup of 64 threads per tile, no coder state.
// main() branches on it at the very top so the test is dynamically uniform
// and each path's barriers stay in uniform control flow.
layout(constant_id = 3) const uint ENTROPY_MODE = 0;    // kEntropyRans

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Bindings
// ---------------------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer Bitstream {
    uint data[];
} u_bits;

layout(std430, set = 0, binding = 1) readonly buffer TileDesc {
    uint data[];  // kTileDescUints per tile
} u_tiles;

// Cumulative frequencies: cum[set][ctx][sym], sym 0..15.  cum[16] == 1024.
layout(std430, set = 0, binding = 2) readonly buffer Tables {
    uint data[];
} u_tables;

layout(std430, set = 0, binding = 3) writeonly buffer Coefs {
    int16_t data[];
} u_coef;

layout(std430, set = 0, binding = 4) buffer CbfBits {
    uint data[];
} u_cbf;

layout(std430, set = 0, binding = 5) writeonly buffer Status {
    uint data[];  // one per tile
} u_status;

// [v3] Per-block intra modes, kModeWordsPerTile uints per tile, 4 bits per
// block.  Read as well as written: the lane that owns a plane's mode unit
// reads back the left and above modes to derive the MPM (SYNTAX.md 9.6), and
// both live in the same unit and therefore in the same lane.
layout(std430, set = 0, binding = 6) buffer Modes {
    uint data[];
} u_modes;

// [sparse] One byte per unit, LAST + 1 in the unit's scan (0 = CBF 0).  Read
// as well as written because the write is an atomicOr into a pre-zeroed word:
// four neighbouring units belong to four different lanes.
layout(std430, set = 0, binding = 7) buffer UnitLens {
    uint data[];
} u_ulen;

layout(push_constant) uniform Push {
    uint num_tiles;
    uint frame_nplanes;   // 3 or 4
    uint coef_stride;     // int16 entries reserved per tile
    uint cbf_words;       // uints reserved per tile
    // [v3] frame-uniform tool flags: kToolFlagCtxV2 | kToolFlagIntraDir |
    // kToolFlagSignHide.  A push constant rather than a specialisation
    // constant so turning a tool on costs no pipeline rebuild.
    uint tools;
    // [sparse] 1 = scan-order slots plus a per-unit length (syntax_constants.h
    // section 8); 0 = the dense raster-order layout.  A push constant so the
    // host can A/B the two layouts without a second pipeline, and because the
    // branch it selects is workgroup-uniform.
    uint sparse;
} pc;

// ---------------------------------------------------------------------------
// Shared memory
// ---------------------------------------------------------------------------
// Cumulative frequency tables for all 8 sets: 8 * 12 * 16 uints = 6 KiB.
shared uint s_cum[kNumTableSets * kNumCtx * kNumSym];
// scan_pos -> block index, four tables of 64 slots: 1 KiB.
shared uint s_scan[kNumScans * kScanStride];

// Per-tile-slot geometry, filled by lane 0 of each tile.
shared int s_np[kMaxSlots];      // coded plane count
shared int s_nb[kMaxSlots * kMaxPlanes]; // blocks per edge, per plane
shared int s_unit_base[kMaxSlots * (kMaxPlanes + 1)];
shared int s_coef_base[kMaxSlots * kMaxPlanes];
shared int s_nunits[kMaxSlots];
shared int s_tskip[kMaxSlots];
shared uint s_tabbase[kMaxSlots];        // table_set * kNumCtx * kNumSym
shared uint s_pay[kMaxSlots];            // byte offset of the rANS payload
shared uint s_end[kMaxSlots];            // one past the last payload byte
shared uint s_ok[kMaxSlots];             // status accumulator
shared int s_active[kMaxSlots];          // min(LANES, nunits): initialised rANS lanes
shared int s_mode_base[kMaxSlots];       // uint index of the tile's mode words

// [sparse] Unit lengths are accumulated here and flushed once at the end.
// Four neighbouring units belong to four different lanes, so the write has to
// be an atomicOr either way; doing it in LDS turns ~100 global atomics per
// tile into ~100 local ones plus 66 coalesced stores.  2112 B.
shared uint s_ulen[kMaxSlots * kUnitLenWordsPerTile];

// Fallback read-pointer exchange and the workgroup-wide "any lane active".
shared uint s_renorm[kMaxSlots];
shared uint s_any;

// ---------------------------------------------------------------------------
// [entropy-lite] Per-unit working set of the Lite path.  Used only when
// ENTROPY_MODE == kEntropyLiteFixed, where a workgroup holds ONE tile and the
// eight rANS slots collapse to slot 0.  ~6.7 KiB, on top of the ~12 KiB the
// rANS path already takes.
//
// Everything here is indexed by UNIT index.  Two different ownership rules
// take turns, separated by barriers, and no index is ever written by two
// threads in the same phase:
//   * the decode phases own unit `u` from thread `u % 64`;
//   * lite_scan() owns a contiguous block of kLiteUnitsPerThread units.
shared uint s_lflag[kLiteUnitsPad];  // section H1: is this unit coded
shared uint s_lpp[kLiteUnitsPad];    // section P: LAST | (mag class << 16)
shared uint s_lsum[kLiteUnitsPad];   // per-unit widths -> exclusive offsets
shared uint s_lsoff[kLiteUnitsPad];  // section S: this unit's bit offset
shared uint s_lblk[kWorkgroupSize];  // lite_scan(): per-thread block totals
shared uint s_lgoff[kLiteMaxGroups]; // section H1: each group's bit offset
shared uint s_lgmask;                // section H0: one bit per group
shared uint s_ltotal;                // lite_scan(): sum of every width
shared uint s_lbase;                 // byte offset of the Lite payload
shared uint s_lbits;                 // payload length in BITS
shared uint s_lh1, s_lp, s_ls, s_lb; // bit offsets of sections H1, P, S, B

// ---------------------------------------------------------------------------
// Bitstream access.  The buffer is uint-addressed; these read bytes.
// ---------------------------------------------------------------------------
uint load_byte(uint byte_off) {
    uint w = u_bits.data[byte_off >> 2u];
    return (w >> ((byte_off & 3u) * 8u)) & 0xffu;
}

// Little-endian uint32, used for the tile header and the lane init states.
uint load_u32le(uint byte_off) {
    return load_byte(byte_off) | (load_byte(byte_off + 1u) << 8u) |
           (load_byte(byte_off + 2u) << 16u) | (load_byte(byte_off + 3u) << 24u);
}

// Big-endian uint16, the renormalisation word.
uint load_u16be(uint byte_off) {
    return (load_byte(byte_off) << 8u) | load_byte(byte_off + 1u);
}

// ---------------------------------------------------------------------------
// Per-lane decoder state (registers)
// ---------------------------------------------------------------------------
// rANS
uint  g_state;
uint  g_pos;      // shared read pointer, byte offset into the bitstream
uint  g_end;      // one past the last payload byte
// LaneMachine
const int kPhCbf = 0, kPhLast = 1, kPhLastRaw = 2, kPhLevel = 3;
const int kPhEscPrefix = 4, kPhEscSuffix = 5, kPhSign = 6, kPhDone = 7;
// [v3] mode-unit phases, ref/src/entropy.h LaneMachine::Phase.
const int kPhModeSym = 8, kPhModeFlag = 9, kPhModeIdx = 10;

int  g_phase;
int  g_ui;        // current unit index
int  g_stride;    // == LANES
int  g_nunits;
int  g_last, g_pos_sp, g_prev_class, g_last_cls, g_mag;
int  g_esc_j, g_esc_bits, g_esc_done;
uint g_esc_acc;
// current unit
int  g_u_ncoef, g_u_scan, g_u_ctx_cbf, g_u_ctx_last, g_u_coef;
// [v3] kCtxNone = the banded LEVEL contexts of 9.3; otherwise a fixed context.
int  g_u_ctx_level;
// [v3] mode unit: kCtxNone = bypass coded (1-bit flag + 3-bit index),
// otherwise the single MODE symbol in context 15.
int  g_u_ctx_mode;
// [entropy-lite] UNIT_COEF (0) or UNIT_MODE (1).  The rANS path encodes the
// same distinction in the phase it enters; the Lite path resolves a unit
// without a state machine and so needs it as a field.
int  g_u_kind;
int  g_u_nbx;     // mode unit: blocks per plane edge
int  g_u_modes;   // mode unit: uint index of this plane's mode words
int  g_mb;        // mode unit: block being decoded
int  g_mpm;       // mode unit: its most probable mode
// [v3] sign data hiding, SYNTAX.md 9.7.
int  g_u_sdh;     // 1 when this unit may hide a sign
int  g_hide;      // ... and whether it actually does (LAST >= kSdhMinLast)
int  g_sum_abs;   // running sum of |level| over the unit
int  g_hide_mag;  // magnitude stored provisionally positive at scan pos LAST
// tile
int  g_slot;
uint g_coef_off;  // int16 index of this tile's region
uint g_cbf_off;   // uint index of this tile's CBF words
uint g_ulen_off;  // [sparse] uint index of this tile's unit-length words

int scan_index(int scan_id, int p) {
    return int(s_scan[uint(scan_id * kScanStride + p)]);
}

void fail(uint code) {
    if (s_ok[g_slot] == kStatusOk) s_ok[g_slot] = code;
    g_phase = kPhDone;
}

// ---------------------------------------------------------------------------
// Unit lookup: derive the current unit's properties from its index.
// Mirrors TileCoder::build_units(): per plane one DC unit of nb*nb
// coefficients, then nb*nb block units of 64.
// ---------------------------------------------------------------------------
// Mutually recursive: a unit that finishes immediately (an empty mode unit)
// starts the next one.
void begin_unit();
void begin_next_unit();

// [v3] Packed mode access.  Only the lane that owns a plane's mode unit ever
// touches that plane's words, and the words were zeroed before decoding, so a
// plain read-modify-write is safe: no atomic, no cross-lane ordering.
int load_mode(int b) {
    uint w = u_modes.data[uint(g_u_modes) + uint(b) / kModesPerUint];
    return int((w >> (uint(b % int(kModesPerUint)) * kModeBits)) & kModeMask);
}

void store_mode(int b, int mode) {
    uint idx = uint(g_u_modes) + uint(b) / kModesPerUint;
    uint sh = uint(b % int(kModesPerUint)) * kModeBits;
    uint w = u_modes.data[idx];
    u_modes.data[idx] = (w & ~(kModeMask << sh)) | ((uint(mode) & kModeMask) << sh);
}

// [REF] entropy.cpp mpm_of(): left and above inside the same unit.
int mpm_now() {
    int bx = g_mb % g_u_nbx, by = g_mb / g_u_nbx;
    int left = bx > 0 ? load_mode(g_mb - 1) : kIntraDcPlane;
    int above = by > 0 ? load_mode(g_mb - g_u_nbx) : kIntraDcPlane;
    return nxs_mpm(left, above);
}

void begin_next_unit() {
    g_ui += g_stride;
    if (g_ui >= g_nunits) g_phase = kPhDone; else begin_unit();
}

void begin_unit() {
    int base = g_slot * (kMaxPlanes + 1);
    int p = 0;
    for (int q = 1; q < s_np[g_slot]; ++q)
        if (s_unit_base[base + q] <= g_ui) p = q;

    int k = g_ui - s_unit_base[base + p];
    int nb = s_nb[g_slot * kMaxPlanes + p];
    int ndc = nb * nb;
    int chroma = (p == 1 || p == 2) ? 1 : 0;
    bool ctx_v2 = (pc.tools & kToolFlagCtxV2) != 0u;
    bool dir = (pc.tools & kToolFlagIntraDir) != 0u;
    g_u_sdh = (pc.tools & kToolFlagSignHide) != 0u ? 1 : 0;
    g_u_ctx_mode = kCtxNone;

    // [SYN] 9.1 unit order inside a plane: DC plane, [mode unit], then the
    // nb*nb block units.  [REF] TileCoder::build_units().
    if (k == 0) {
        // The DC-plane unit.  Under CTX_V2 it has CBF, LAST and LEVEL
        // contexts of its own (SYNTAX.md 9.3, contexts 12-14).
        g_u_ncoef = ndc;
        g_u_scan = nxs_scan_id(ndc, 0);
        g_u_coef = s_coef_base[g_slot * kMaxPlanes + p];
        g_u_ctx_cbf = ctx_v2 ? kCtxCbfDc
                             : (chroma != 0 ? kCtxCbfChroma : kCtxCbfLuma);
        g_u_ctx_last = ctx_v2 ? kCtxLastDc
                              : (chroma != 0 ? kCtxLastChroma : kCtxLastLuma);
        g_u_ctx_level = ctx_v2 ? kCtxLevelDc : kCtxNone;
        g_phase = kPhCbf;
        return;
    }
    if (dir && k == 1) {
        // The mode unit: nb*nb intra modes in raster order, coded in full
        // before this lane moves on (SYNTAX.md 9.6).
        g_u_nbx = nb;
        g_u_modes = s_mode_base[g_slot] + p * int(kModeWordsPerPlane);
        g_u_ctx_mode = ctx_v2 ? kCtxMode : kCtxNone;
        g_mb = 0;
        // ref/src/entropy.cpp begin_unit() skips an empty mode unit here.  A
        // coded plane's edge is at least kMinChromaSize, so nb >= 1 always and
        // the case cannot arise; it is left out rather than recursed into,
        // because GLSL forbids the begin_unit/begin_next_unit cycle.
        g_mpm = mpm_now();
        g_phase = g_u_ctx_mode != kCtxNone ? kPhModeSym : kPhModeFlag;
        return;
    }
    // A residual block unit.  Its contexts are the plane's, and its LEVEL
    // context is the banded derivation of 9.3, in both models.
    int b = k - (dir ? 2 : 1);
    g_u_ncoef = kCoefPerBlock;
    g_u_scan = nxs_scan_id(kCoefPerBlock, s_tskip[g_slot]);
    g_u_coef = s_coef_base[g_slot * kMaxPlanes + p] + ndc + b * kCoefPerBlock;
    g_u_ctx_cbf = chroma != 0 ? kCtxCbfChroma : kCtxCbfLuma;
    g_u_ctx_last = chroma != 0 ? kCtxLastChroma : kCtxLastLuma;
    g_u_ctx_level = kCtxNone;
    g_phase = kPhCbf;
}

// [sparse] The only place the two layouts differ: scan order stores
// coefficient `scan_pos` at slot `scan_pos`, dense stores it at the raster
// index the scan names.  The unit's base and reserved width are the same
// either way.
void store_coef_at(int scan_pos, int value) {
    int slot = pc.sparse != 0u ? scan_pos : scan_index(g_u_scan, scan_pos);
    u_coef.data[g_coef_off + uint(g_u_coef + slot)] = int16_t(value);
}

// [sparse] Publish the unit's coefficient count, LAST + 1.  atomicOr into a
// zeroed word: unit `u` belongs to lane `u % LANES`, so the four units sharing
// a word belong to four different lanes.
void store_unit_len(int ui, int len) {
    if (pc.sparse == 0u) return;
    atomicOr(s_ulen[uint(g_slot) * kUnitLenWordsPerTile +
                    uint(ui) / kUnitLensPerWord],
             (uint(len) & kUnitLenMask)
                 << ((uint(ui) % kUnitLensPerWord) * kUnitLenBits));
}

void begin_levels() {
    store_unit_len(g_ui, g_last + 1);
    g_pos_sp = g_last;
    g_prev_class = 0;
    g_sum_abs = 0;
    // [SYN] 9.7: the hidden sign is the one at scan position LAST, which is
    // known the moment LAST is decoded and is nonzero by construction, so no
    // lookahead is needed.  Its value is settled at the end of the unit.
    g_hide = (g_u_sdh != 0 && g_last >= kSdhMinLast) ? 1 : 0;
    g_hide_mag = 0;
    g_phase = kPhLevel;
}

void advance_pos() {
    int m = g_mag < 0 ? -g_mag : g_mag;
    g_prev_class = nxs_level_class(m);
    g_sum_abs += m;
    if (g_pos_sp == 0) {
        // [SYN] 9.7: parity of the sum of |level| over the whole unit decides
        // the sign at LAST.  The magnitude was stored positive; flip it here.
        if (g_hide != 0 && (g_sum_abs & 1) != 0)
            store_coef_at(g_last, -g_hide_mag);
        begin_next_unit();
    } else {
        --g_pos_sp;
        g_phase = kPhLevel;
    }
}

void lane_init(int lane) {
    g_stride = int(LANES);
    g_ui = lane;
    g_last = 0; g_pos_sp = 0; g_prev_class = 0; g_last_cls = 0; g_mag = 0;
    g_esc_j = 0; g_esc_bits = 0; g_esc_done = 0; g_esc_acc = 0u;
    g_u_ctx_level = kCtxNone; g_u_ctx_mode = kCtxNone;
    g_u_nbx = 0; g_u_modes = 0; g_mb = 0; g_mpm = 0;
    g_u_sdh = 0; g_hide = 0; g_sum_abs = 0; g_hide_mag = 0;
    if (g_ui >= g_nunits) { g_phase = kPhDone; return; }
    begin_unit();
}

// ---------------------------------------------------------------------------
// LaneMachine::next() - what does this lane code now?
// out_kind: 0 = symbol (out_arg is the context), 1 = bypass (out_arg is bits)
// Returns false when the lane has finished.  Does not mutate the machine.
// ---------------------------------------------------------------------------
bool lane_next(out int out_kind, out int out_arg) {
    out_kind = 0; out_arg = 0;
    if (g_phase == kPhDone) return false;
    if (g_phase == kPhCbf)  { out_kind = 0; out_arg = g_u_ctx_cbf;  return true; }
    if (g_phase == kPhLast) { out_kind = 0; out_arg = g_u_ctx_last; return true; }
    if (g_phase == kPhLastRaw) {
        out_kind = 1; out_arg = kLastRawBits[g_last_cls]; return true;
    }
    if (g_phase == kPhLevel) {
        // [SYN] 9.3 / [REF] entropy.cpp kLevel: a unit that names its own
        // LEVEL context uses it; kCtxNone means the banded derivation.
        out_kind = 0;
        out_arg = g_u_ctx_level != kCtxNone
                      ? g_u_ctx_level
                      : nxs_level_ctx(g_pos_sp, g_prev_class);
        return true;
    }
    if (g_phase == kPhModeSym) { out_kind = 0; out_arg = g_u_ctx_mode; return true; }
    if (g_phase == kPhModeFlag) { out_kind = 1; out_arg = kModeFlagBits; return true; }
    if (g_phase == kPhModeIdx) { out_kind = 1; out_arg = kModeIdxBits; return true; }
    if (g_phase == kPhEscPrefix) { out_kind = 1; out_arg = 1; return true; }
    if (g_phase == kPhEscSuffix) {
        int nchunks = (g_esc_bits + kEscChunkBits - 1) / kEscChunkBits;
        int chunk = g_esc_done == 0
                        ? g_esc_bits - kEscChunkBits * (nchunks - 1)
                        : kEscChunkBits;
        out_kind = 1; out_arg = chunk; return true;
    }
    // kPhSign
    out_kind = 1; out_arg = 1; return true;
}

void store_coef(int value) {
    store_coef_at(g_pos_sp, value);
}

// [REF] entropy.cpp store_magnitude(): normally the sign follows; for the one
// hidden position the coefficient is stored provisionally positive and its
// sign is settled from the unit's parity in advance_pos().
void store_magnitude() {
    if (g_hide != 0 && g_pos_sp == g_last) {
        g_hide_mag = g_mag;
        store_coef(g_mag);
        advance_pos();
        return;
    }
    g_phase = kPhSign;
}

// [REF] entropy.cpp mode_step(): commit the mode just decoded and move on.
void mode_step(int mode) {
    store_mode(g_mb, mode);
    ++g_mb;
    if (g_mb >= g_u_nbx * g_u_nbx) { begin_next_unit(); return; }
    g_mpm = mpm_now();
    g_phase = g_u_ctx_mode != kCtxNone ? kPhModeSym : kPhModeFlag;
}

// ---------------------------------------------------------------------------
// LaneMachine::feed() - apply the decoded value.
// ---------------------------------------------------------------------------
void lane_feed(uint v) {
    if (g_phase == kPhModeSym) {
        // [SYN] 9.6: symbol 0 is the MPM, 1..8 name the other eight modes in
        // ascending order.  9..15 are illegal.
        if (v >= uint(kNumIntraModes)) { fail(kStatusBadSymbol); return; }
        mode_step(v == 0u ? g_mpm : nxs_nonmpm_mode(g_mpm, int(v) - 1));
        return;
    }
    if (g_phase == kPhModeFlag) {
        if (v > 1u) { fail(kStatusBadSymbol); return; }
        if (v == 0u) { g_phase = kPhModeIdx; return; }
        mode_step(g_mpm);
        return;
    }
    if (g_phase == kPhModeIdx) {
        if (v > 7u) { fail(kStatusBadSymbol); return; }
        mode_step(nxs_nonmpm_mode(g_mpm, int(v)));
        return;
    }
    if (g_phase == kPhCbf) {
        if (v > 1u) { fail(kStatusBadSymbol); return; }
        if (v == 0u) {
            begin_next_unit();
            return;
        }
        atomicOr(u_cbf.data[g_cbf_off + uint(g_ui) / 32u],
                 1u << (uint(g_ui) & 31u));
        if (g_u_ncoef == 1) { g_last = 0; begin_levels(); return; }
        g_phase = kPhLast;
        return;
    }
    if (g_phase == kPhLast) {
        if (v > uint(kLastMaxClass)) { fail(kStatusBadSymbol); return; }
        g_last_cls = int(v);
        int base = kLastBase[g_last_cls];
        if (base >= g_u_ncoef) { fail(kStatusBadSymbol); return; }
        if (kLastRawBits[g_last_cls] > 0) { g_phase = kPhLastRaw; return; }
        g_last = base;
        begin_levels();
        return;
    }
    if (g_phase == kPhLastRaw) {
        g_last = kLastBase[g_last_cls] + int(v);
        if (g_last >= g_u_ncoef) { fail(kStatusBadSymbol); return; }
        begin_levels();
        return;
    }
    if (g_phase == kPhLevel) {
        if (v == uint(kEscSym)) { g_esc_j = 0; g_phase = kPhEscPrefix; return; }
        g_mag = int(v);
        if (g_mag == 0) {
            if (g_pos_sp == g_last) { fail(kStatusBadSymbol); return; }
            store_coef(0);
            g_mag = 0;
            advance_pos();
            return;
        }
        store_magnitude();
        return;
    }
    if (g_phase == kPhEscPrefix) {
        if (v > 1u) { fail(kStatusBadSymbol); return; }
        if (v == 1u) {
            if (++g_esc_j > kEscMaxPrefix) { fail(kStatusBadSymbol); return; }
            return;
        }
        g_esc_bits = g_esc_j + kEscOrder;
        g_esc_done = 0;
        g_esc_acc = 0u;
        g_phase = kPhEscSuffix;
        return;
    }
    if (g_phase == kPhEscSuffix) {
        int nchunks = (g_esc_bits + kEscChunkBits - 1) / kEscChunkBits;
        int chunk = g_esc_done == 0
                        ? g_esc_bits - kEscChunkBits * (nchunks - 1)
                        : kEscChunkBits;
        g_esc_acc = (g_esc_acc << uint(chunk)) | v;
        g_esc_done += chunk;
        if (g_esc_done < g_esc_bits) return;
        uint n = (1u << uint(g_esc_bits)) + g_esc_acc;
        uint val = n - (1u << uint(kEscOrder));
        if (val > uint(kEscMaxValue)) { fail(kStatusBadSymbol); return; }
        g_mag = int(val) + kEscSym;
        store_magnitude();
        return;
    }
    // kPhSign
    if (v > 1u) { fail(kStatusBadSymbol); return; }
    store_coef(v != 0u ? -g_mag : g_mag);
    advance_pos();
}

// ---------------------------------------------------------------------------
// Symbol lookup.  Branchless binary search for the largest s with
// cum[s] <= slot; identical to indexing ref's 1024-entry slot2sym table,
// but 12 contexts x 8 table sets of those would not fit in LDS.
// ---------------------------------------------------------------------------
uint cum_at(uint tabbase, int ctx, int s) {
    return s_cum[tabbase + uint(ctx * kNumSym + s)];
}

void decode_symbol(uint tabbase, int ctx, uint slot, out uint sym,
                   out uint f, out uint c) {
    int s = 0;
    if (cum_at(tabbase, ctx, 8) <= slot) s = 8;
    if (cum_at(tabbase, ctx, s + 4) <= slot) s += 4;
    if (cum_at(tabbase, ctx, s + 2) <= slot) s += 2;
    if (cum_at(tabbase, ctx, s + 1) <= slot) s += 1;
    c = cum_at(tabbase, ctx, s);
    uint hi = (s == kNumSym - 1) ? kProbScale : cum_at(tabbase, ctx, s + 1);
    f = hi - c;
    sym = uint(s);
}

// ===========================================================================
// [entropy-lite] ENTROPY_LITE / FIXED -- stream tool bit 30
// ===========================================================================
// NORMATIVE SOURCE: ref/src/entropy_lite.{h,cpp}.  A tile's payload is five
// byte-aligned sections in this order:
//
//   H0  one bit per group of kLiteCbfGroup units, "any unit here is coded"
//   H1  for each group whose H0 bit is 1, one bit per unit of that group
//   P   per coded COEFFICIENT unit: lite_last_bits(ncoef) bits of LAST, then
//       kLiteParamBits of magnitude class.  Mode units contribute nothing.
//   S   per coded unit: a mode unit's nbx*nbx "is_mpm" flags, or a
//       coefficient unit's LAST significance bits for scan positions
//       0 .. LAST-1 (position LAST is nonzero by construction)
//   B   per coded unit: a mode unit's 3-bit non-MPM index per cleared flag,
//       or, per nonzero scan position in ascending order, kLiteMagBits[class]
//       bits of |q| - 1 followed by one sign bit, 1 == negative
//
// Every offset is computable: H0's length is a constant of the unit list,
// H1's a popcount over H0, P's the coded bits and the unit list, S's follows
// from P (which carries LAST) and each unit's slot in B from a prefix sum
// over per-unit body lengths that S and P determine.  So the decode is three
// workgroup prefix sums and then wholly independent per-unit work -- no coder
// state, no round chain, nothing serial but a unit's own coefficients.
//
// Dispatch shape: ONE workgroup of kWorkgroupSize threads per tile (the host
// dispatches num_tiles groups), unit `u` decoded by thread `u % 64`.

// Bits [bitpos, bitpos + k) of the payload, MSB-first inside a byte.  One
// four-byte funnel load rather than the reference's bit-at-a-time loop; k is
// at most kLiteMagBits[7] == 16, so bitpos%8 + k never passes 32.
uint lite_get(uint bitpos, uint k) {
    if (k == 0u) return 0u;
    uint o = s_lbase + (bitpos >> 3u);
    uint sh = bitpos & 7u;
    uint w = (load_byte(o) << 24u) | (load_byte(o + 1u) << 16u) |
             (load_byte(o + 2u) << 8u) | load_byte(o + 3u);
    return (w << sh) >> (32u - k);
}

// Unit `u`'s geometry, the same derivation begin_unit() makes -- but as a
// pure lookup, because the Lite path has no lane state machine to walk into.
void lite_unit(int u) {
    int base = g_slot * (kMaxPlanes + 1);
    int p = 0;
    for (int q = 1; q < s_np[g_slot]; ++q)
        if (s_unit_base[base + q] <= u) p = q;

    int k = u - s_unit_base[base + p];
    int nb = s_nb[g_slot * kMaxPlanes + p];
    int ndc = nb * nb;
    bool dir = (pc.tools & kToolFlagIntraDir) != 0u;

    if (k == 0) {  // the DC-plane unit
        g_u_kind = 0;
        g_u_ncoef = ndc;
        g_u_scan = nxs_scan_id(ndc, 0);
        g_u_coef = s_coef_base[g_slot * kMaxPlanes + p];
        return;
    }
    if (dir && k == 1) {  // the mode unit
        g_u_kind = 1;
        g_u_nbx = nb;
        g_u_modes = s_mode_base[g_slot] + p * int(kModeWordsPerPlane);
        return;
    }
    int b = k - (dir ? 2 : 1);  // a residual block unit
    g_u_kind = 0;
    g_u_ncoef = kCoefPerBlock;
    g_u_scan = nxs_scan_id(kCoefPerBlock, s_tskip[g_slot]);
    g_u_coef = s_coef_base[g_slot * kMaxPlanes + p] + ndc + b * kCoefPerBlock;
}

// Turns s_lsum[] from per-unit WIDTHS into per-unit EXCLUSIVE bit offsets and
// leaves the grand total in s_ltotal.  Two levels: each thread serially scans
// its own contiguous block of kLiteUnitsPerThread units, then the 64 block
// totals go through a Hillis-Steele scan, then the block offset is folded
// back in.  Ends with a barrier, so the caller may read s_lsum immediately.
void lite_scan() {
    uint tid = gl_LocalInvocationID.x;
    uint sum = 0u;
    for (int k = 0; k < kLiteUnitsPerThread; ++k) {
        uint i = tid * uint(kLiteUnitsPerThread) + uint(k);
        uint w = s_lsum[i];
        s_lsum[i] = sum;
        sum += w;
    }
    s_lblk[tid] = sum;
    barrier();
    for (uint d = 1u; d < kWorkgroupSize; d <<= 1u) {
        uint v = tid >= d ? s_lblk[tid - d] : 0u;
        barrier();
        s_lblk[tid] += v;
        barrier();
    }
    uint blk = s_lblk[tid] - sum;  // inclusive minus own == exclusive
    if (tid == kWorkgroupSize - 1u) s_ltotal = s_lblk[tid];
    for (int k = 0; k < kLiteUnitsPerThread; ++k)
        s_lsum[tid * uint(kLiteUnitsPerThread) + uint(k)] += blk;
    barrier();
}

void lite_main() {
    uint tid = gl_LocalInvocationID.x;
    uint tile = gl_WorkGroupID.x;
    // One workgroup per tile, so this test is workgroup-uniform and every
    // barrier below stays in uniform control flow.
    if (tile >= pc.num_tiles) return;
    g_slot = 0;

    uint d = tile * kTileDescUints;
    uint hdr_off = u_tiles.data[d + kTdBitsOffset];
    uint bs_len = u_tiles.data[d + kTdBitsLength];
    g_coef_off = u_tiles.data[d + kTdCoefOffset];
    g_cbf_off = u_tiles.data[d + kTdCbfOffset];
    g_ulen_off = u_tiles.data[d + kTdUnitLenOffset];

    // The scan tables.  The probability tables are NOT loaded: ENTROPY_LITE
    // has none, and binding 2 goes unread in this mode.
    for (uint i = tid; i < uint(kNumScans * kScanStride); i += kWorkgroupSize) {
        uint t = i / uint(kScanStride);
        uint p = i % uint(kScanStride);
        uint v = p;  // kScanRaster8 / kScanSmall are the identity
        if (t == uint(kScanZigzag8)) v = uint(kZigzag8[p]);
        else if (t == uint(kScanZigzag4)) v = (p < 16u) ? uint(kZigzag4[p]) : p;
        s_scan[i] = v;
    }

    // --- tile header, and the tile geometry it implies ---------------------
    if (tid == 0u) {
        s_ok[0] = kStatusOk;
        s_mode_base[0] = int(u_tiles.data[d + kTdModeOffset]);
        uint w0 = load_u32le(hdr_off);
        uint w1 = load_u32le(hdr_off + 4u);
        int res_level = int((w1 >> kThResLevelShift) & kThResLevelMask);
        int chroma444 = int((w1 >> kThChroma444Shift) & kThChroma444Mask);
        int alpha_mode = int((w1 >> kThAlphaModeShift) & kThAlphaModeMask);
        // Under ENTROPY_LITE the header's table_set names the VARIANT.
        uint variant = (w1 >> kThTableSetShift) & kThTableSetMask;
        uint nsub_log2 = (w1 >> kThNsubLog2Shift) & kThNsubLog2Mask;
        s_tskip[0] = int((w1 >> kThTskipShift) & kThTskipMask);

        uint pay = nxs_tile_payload_offset(hdr_off, w1);
        uint paylen = (w0 >> kThPayloadLenShift) & kThPayloadLenMask;
        uint tile_end = hdr_off + bs_len;
        uint pay_end = pay + paylen;
        uint pend = pay_end < tile_end ? pay_end : tile_end;
        s_lbase = pay;
        s_lbits = pend > pay ? (pend - pay) * 8u : 0u;

        int np = nxs_coded_planes(int(pc.frame_nplanes), alpha_mode);
        s_np[0] = np;
        int extra = (pc.tools & kToolFlagIntraDir) != 0u
                        ? kUnitsPerPlaneExtraDir
                        : kUnitsPerPlaneExtra;
        int ub = 0, cb = 0;
        for (int p = 0; p < kMaxPlanes; ++p) {
            s_unit_base[p] = ub;
            s_coef_base[p] = cb;
            if (p < np) {
                int nb = nxs_plane_size(p, res_level, chroma444) / kBlockSize;
                s_nb[p] = nb;
                int ndc = nb * nb;
                ub += extra + ndc;
                cb += ndc + ndc * kCoefPerBlock;
            } else {
                s_nb[p] = 0;
            }
        }
        s_unit_base[kMaxPlanes] = ub;
        s_nunits[0] = ub;

        // The rANS path's rejections, plus the two ENTROPY_LITE adds: only
        // the FIXED variant is implemented, and v1 still fixes nsub_log2 at 3.
        if (nxs_tile_header_reserved_bad(w0, w1) != 0 ||
            variant != uint(kLiteFixed) || nsub_log2 != kLanesLog2 ||
            ub <= 0 || ub > kMaxUnitsPerTile || pend < pay)
            s_ok[0] = kStatusBadHeader;
    }
    barrier();

    // --- zero the CBF, length and mode words -------------------------------
    // Identical contract to the rANS path: dense zeroes the whole coefficient
    // region, sparse zeroes only the length words and leaves the coefficient
    // slots past LAST untouched.
    if (pc.sparse == 0u) {
        for (uint i = tid; i < pc.coef_stride; i += kWorkgroupSize)
            u_coef.data[g_coef_off + i] = int16_t(0);
    } else {
        for (uint i = tid; i < kUnitLenWordsPerTile; i += kWorkgroupSize)
            s_ulen[i] = 0u;
    }
    for (uint i = tid; i < pc.cbf_words; i += kWorkgroupSize)
        u_cbf.data[g_cbf_off + i] = 0u;
    for (uint i = tid; i < kModeWordsPerTile; i += kWorkgroupSize)
        u_modes.data[uint(s_mode_base[0]) + i] = 0u;
    barrier();

    bool ok = s_ok[0] == kStatusOk;
    int nunits = s_nunits[0];

    // --- H0: the group map, and each group's slot in H1 --------------------
    // ngroups is at most kLiteMaxGroups (17), so one thread walking it is
    // cheaper than any parallel alternative and keeps the popcount exact.
    if (tid == 0u && ok) {
        int ngroups = (nunits + kLiteCbfGroup - 1) / kLiteCbfGroup;
        uint h1 = nxs_align8(uint(ngroups));
        uint acc = 0u;
        uint gmask = 0u;
        for (int gi = 0; gi < ngroups; ++gi) {
            s_lgoff[gi] = acc;
            if (lite_get(uint(gi), 1u) != 0u) {
                gmask |= 1u << uint(gi);
                int lo = gi * kLiteCbfGroup;
                int hi = lo + kLiteCbfGroup < nunits ? lo + kLiteCbfGroup
                                                     : nunits;
                acc += uint(hi - lo);
            }
        }
        s_lgmask = gmask;
        s_lh1 = h1;
        s_lp = h1 + nxs_align8(acc);
        if (h1 > s_lbits || h1 + acc > s_lbits) s_ok[0] = kStatusTruncated;
    }
    barrier();
    ok = s_ok[0] == kStatusOk;

    // --- H1: the coded flag of every unit, and section P's widths ----------
    for (uint u = tid; u < uint(kLiteUnitsPad); u += kWorkgroupSize) {
        uint c = 0u;
        if (ok && u < uint(nunits)) {
            uint gi = u / uint(kLiteCbfGroup);
            if ((s_lgmask & (1u << gi)) != 0u)
                c = lite_get(s_lh1 + s_lgoff[gi] + (u % uint(kLiteCbfGroup)),
                             1u);
        }
        s_lflag[u] = c;
        uint w = 0u;
        if (c != 0u) {
            lite_unit(int(u));
            // A mode unit codes nothing in P.
            if (g_u_kind == 0)
                w = uint(nxs_lite_last_bits(g_u_ncoef) + kLiteParamBits);
        }
        s_lsum[u] = w;
    }
    barrier();
    lite_scan();
    if (tid == 0u && ok) {
        s_ls = s_lp + nxs_align8(s_ltotal);
        if (s_ls > s_lbits) s_ok[0] = kStatusTruncated;
    }
    barrier();
    ok = s_ok[0] == kStatusOk;

    // --- P: LAST and the magnitude class; then section S's widths ----------
    for (uint u = tid; u < uint(kLiteUnitsPad); u += kWorkgroupSize) {
        uint sw = 0u, pp = 0u;
        if (ok && s_lflag[u] != 0u) {
            lite_unit(int(u));
            if (g_u_kind == 1) {
                sw = uint(g_u_nbx * g_u_nbx);
            } else {
                int lb = nxs_lite_last_bits(g_u_ncoef);
                uint off = s_lp + s_lsum[u];
                uint L = lite_get(off, uint(lb));
                uint cls = lite_get(off + uint(lb), uint(kLiteParamBits));
                if (int(L) >= g_u_ncoef) {
                    fail(kStatusBadSymbol);
                } else {
                    pp = L | (cls << 16u);
                    sw = L;  // position LAST is not coded in S
                }
            }
        }
        s_lpp[u] = pp;
        s_lsum[u] = sw;
    }
    barrier();
    lite_scan();
    if (tid == 0u && ok) {
        s_lb = s_ls + nxs_align8(s_ltotal);
        if (s_lb > s_lbits) s_ok[0] = kStatusTruncated;
    }
    barrier();
    ok = s_ok[0] == kStatusOk;

    // --- S: the significance / is-MPM flags; then section B's widths -------
    // A unit's B length is the one quantity that needs S read first: for a
    // mode unit it counts the cleared flags, for a coefficient unit the set
    // ones.  Reading S twice costs a handful of byte loads and saves keeping
    // 64 flags per unit alive across the scan.
    for (uint u = tid; u < uint(kLiteUnitsPad); u += kWorkgroupSize) {
        uint bw = 0u, soff = 0u;
        if (ok && s_lflag[u] != 0u) {
            lite_unit(int(u));
            soff = s_ls + s_lsum[u];
            if (g_u_kind == 1) {
                int n = g_u_nbx * g_u_nbx;
                int nonmpm = 0;
                for (int b = 0; b < n; ++b)
                    if (lite_get(soff + uint(b), 1u) == 0u) ++nonmpm;
                bw = uint(nonmpm * kModeIdxBits);
            } else {
                int L = int(s_lpp[u] & 0xffffu);
                int cls = int(s_lpp[u] >> 16u);
                int nnz = 1;  // position LAST is nonzero by construction
                for (int p = 0; p < L; ++p)
                    if (lite_get(soff + uint(p), 1u) != 0u) ++nnz;
                bw = uint(nnz * (kLiteMagBits[cls] + 1));
            }
        }
        s_lsoff[u] = soff;
        s_lsum[u] = bw;
    }
    barrier();
    lite_scan();
    if (tid == 0u && ok && s_lb + s_ltotal > s_lbits)
        s_ok[0] = kStatusTruncated;
    barrier();
    ok = s_ok[0] == kStatusOk;

    // --- B: the bodies.  Every unit is independent from here on. -----------
    for (uint u = tid; u < uint(kLiteUnitsPad); u += kWorkgroupSize) {
        if (!ok || s_lflag[u] == 0u) continue;
        lite_unit(int(u));
        uint boff = s_lb + s_lsum[u];
        uint soff = s_lsoff[u];

        if (g_u_kind == 1) {
            // The MPM of block b reads the modes of b-1 and b-nbx, both
            // already committed by this same thread, so the unit resolves in
            // one raster pass and needs no coder chain at all.
            int n = g_u_nbx * g_u_nbx;
            for (int b = 0; b < n; ++b) {
                g_mb = b;
                int mpm = mpm_now();
                int m;
                if (lite_get(soff + uint(b), 1u) != 0u) {
                    m = mpm;
                } else {
                    uint idx = lite_get(boff, uint(kModeIdxBits));
                    boff += uint(kModeIdxBits);
                    m = nxs_nonmpm_mode(mpm, int(idx));
                }
                store_mode(b, m);
            }
            continue;
        }

        int L = int(s_lpp[u] & 0xffffu);
        int cls = int(s_lpp[u] >> 16u);
        int mbits = kLiteMagBits[cls];
        // Exactly what the rANS path publishes for a coded unit: the CBF bit
        // (an atomicOr because four neighbouring units are four threads) and,
        // under the sparse layout, LAST + 1.
        atomicOr(u_cbf.data[g_cbf_off + u / 32u], 1u << (u & 31u));
        store_unit_len(int(u), L + 1);
        for (int p = 0; p <= L; ++p) {
            uint sig = 1u;
            if (p < L) sig = lite_get(soff + uint(p), 1u);
            if (sig == 0u) {
                // Stored explicitly, as the rANS level phase does: under the
                // sparse layout nothing zeroes the region.
                store_coef_at(p, 0);
                continue;
            }
            uint mag = 0u;
            if (mbits != 0) {
                mag = lite_get(boff, uint(mbits));
                boff += uint(mbits);
            }
            if (mag > kLiteMaxMag) { fail(kStatusBadSymbol); break; }
            uint sgn = lite_get(boff, 1u);
            boff += 1u;
            int a = int(mag) + 1;
            store_coef_at(p, sgn != 0u ? -a : a);
        }
    }
    barrier();

    if (tid == 0u) u_status.data[tile] = s_ok[0];
    if (pc.sparse != 0u)
        for (uint i = tid; i < kUnitLenWordsPerTile; i += kWorkgroupSize)
            u_ulen.data[g_ulen_off + i] = s_ulen[i];
}

// ---------------------------------------------------------------------------
void main() {
    // [entropy-lite] A specialisation constant, so this is dynamically
    // uniform and neither path's barriers leave uniform control flow.
    if (ENTROPY_MODE == kEntropyLiteFixed) {
        lite_main();
        return;
    }
    uint lid = gl_LocalInvocationID.x;
    // [marked edit] slot/lane from the LANES specialisation constant.  Threads
    // whose slot falls outside TILES_PER_GROUP idle but still hit every
    // barrier; they are clamped to slot 0 so no shared access goes out of
    // range, and `valid` keeps them from writing anything.
    uint slot_u = lid / LANES;
    bool in_group = slot_u < TILES_PER_GROUP;
    int slot = in_group ? int(slot_u) : 0;
    int lane = int(lid - slot_u * LANES);
    g_slot = slot;

    // --- shared table load -------------------------------------------------
    const uint kCumWords = uint(kNumTableSets * kNumCtx * kNumSym);
    for (uint i = lid; i < kCumWords; i += kWorkgroupSize)
        s_cum[i] = u_tables.data[i];
    for (uint i = lid; i < uint(kNumScans * kScanStride); i += kWorkgroupSize) {
        uint t = i / uint(kScanStride);
        uint p = i % uint(kScanStride);
        uint v = p;  // kScanRaster8 / kScanSmall are the identity
        if (t == uint(kScanZigzag8)) v = uint(kZigzag8[p]);
        else if (t == uint(kScanZigzag4)) v = (p < 16u) ? uint(kZigzag4[p]) : p;
        s_scan[i] = v;
    }
    if (in_group && lane == 0) {
        s_ok[slot] = kStatusOk;
        s_renorm[slot] = 0u;
        s_active[slot] = 0;
    }
    if (lid == 0u) s_any = 0u;
    barrier();

    uint tile = gl_WorkGroupID.x * TILES_PER_GROUP + slot_u;
    bool valid = in_group && tile < pc.num_tiles;

    // --- tile header -------------------------------------------------------
    uint hdr_off = 0u, bs_len = 0u;
    if (valid) {
        uint d = tile * kTileDescUints;
        hdr_off = u_tiles.data[d + kTdBitsOffset];
        bs_len = u_tiles.data[d + kTdBitsLength];
        // [marked edit] the descriptor names the destination region, so a
        // dispatch can cover any subset of the frame's tiles in any order.
        g_coef_off = u_tiles.data[d + kTdCoefOffset];
        g_cbf_off = u_tiles.data[d + kTdCbfOffset];
        g_ulen_off = u_tiles.data[d + kTdUnitLenOffset];
        if (lane == 0) s_mode_base[slot] = int(u_tiles.data[d + kTdModeOffset]);
    }

    if (valid && lane == 0) {
        uint w0 = load_u32le(hdr_off);
        uint w1 = load_u32le(hdr_off + 4u);
        int res_level = int((w1 >> kThResLevelShift) & kThResLevelMask);
        int chroma444 = int((w1 >> kThChroma444Shift) & kThChroma444Mask);
        int alpha_mode = int((w1 >> kThAlphaModeShift) & kThAlphaModeMask);
        uint table_set = (w1 >> kThTableSetShift) & kThTableSetMask;
        uint nsub_log2 = (w1 >> kThNsubLog2Shift) & kThNsubLog2Mask;
        s_tskip[slot] = int((w1 >> kThTskipShift) & kThTskipMask);
        s_tabbase[slot] = table_set * uint(kNumCtx * kNumSym);

        // Payload start accounts for the optional MV / alpha bytes, and the
        // payload is bounded by payload_len as well as by the tile length.
        uint pay = nxs_tile_payload_offset(hdr_off, w1);
        uint paylen = (w0 >> kThPayloadLenShift) & kThPayloadLenMask;
        s_pay[slot] = pay;
        uint tile_end = hdr_off + bs_len;
        uint pay_end = pay + paylen;
        s_end[slot] = pay_end < tile_end ? pay_end : tile_end;

        int np = nxs_coded_planes(int(pc.frame_nplanes), alpha_mode);
        s_np[slot] = np;
        // [v3] INTRA_DIR adds one mode unit per coded plane (SYNTAX.md 9.1).
        int extra = (pc.tools & kToolFlagIntraDir) != 0u
                        ? kUnitsPerPlaneExtraDir
                        : kUnitsPerPlaneExtra;
        int ub = 0, cb = 0;
        for (int p = 0; p < kMaxPlanes; ++p) {
            s_unit_base[slot * (kMaxPlanes + 1) + p] = ub;
            s_coef_base[slot * kMaxPlanes + p] = cb;
            if (p < np) {
                int nb = nxs_plane_size(p, res_level, chroma444) / kBlockSize;
                s_nb[slot * kMaxPlanes + p] = nb;
                int ndc = nb * nb;
                ub += extra + ndc;
                cb += ndc + ndc * kCoefPerBlock;
            } else {
                s_nb[slot * kMaxPlanes + p] = 0;
            }
        }
        s_unit_base[slot * (kMaxPlanes + 1) + kMaxPlanes] = ub;
        s_nunits[slot] = ub;
        // [marked edit] [REF] entropy.cpp decode_units():
        //   active = min(nlanes, nunits)
        // rANS states are transmitted for the active lanes only; the lane
        // machines still stride by nlanes.
        int nactive = int(LANES) < ub ? int(LANES) : ub;
        s_active[slot] = nactive;

        if (nxs_tile_header_reserved_bad(w0, w1) != 0 ||
            (1u << nsub_log2) != LANES ||
            pay + uint(nactive) * kInitBytesPerLane > s_end[slot]) {
            s_ok[slot] = kStatusBadHeader;
        }
    }
    barrier();

    // --- zero the tile's CBF, length and mode words -------------------------
    // [sparse] The coefficient region is NOT zeroed: every slot Pass B reads
    // is inside [0, LAST] of some unit and every one of those is written
    // below, explicit zeros included (a zero run inside a unit is stored, see
    // kPhLevel).  That is the whole of the write-side saving.
    if (valid) {
        if (pc.sparse == 0u) {
            for (uint i = uint(lane); i < pc.coef_stride; i += LANES)
                u_coef.data[g_coef_off + i] = int16_t(0);
        } else {
            for (uint i = uint(lane); i < kUnitLenWordsPerTile; i += LANES)
                s_ulen[uint(slot) * kUnitLenWordsPerTile + i] = 0u;
        }
        for (uint i = uint(lane); i < pc.cbf_words; i += LANES)
            u_cbf.data[g_cbf_off + i] = 0u;
        // [v3] The mode words are zeroed unconditionally, whether or not the
        // stream carries modes: mode 0 is the DC-plane predictor, so a zeroed
        // region is exactly "every block predicts as v1 did".
        for (uint i = uint(lane); i < kModeWordsPerTile; i += LANES)
            u_modes.data[uint(s_mode_base[slot]) + i] = 0u;
    }
    barrier();

    bool live = valid && s_ok[slot] == kStatusOk;

    // --- rANS init: LANES little-endian uint32 states, lane 0 first --------
    g_end = valid ? s_end[slot] : 0u;
    int nactive = valid ? s_active[slot] : 0;
    g_pos = (valid ? s_pay[slot] : 0u) + uint(nactive) * kInitBytesPerLane;
    g_nunits = valid ? s_nunits[slot] : 0;
    g_phase = kPhDone;
    // [marked edit] lanes at or above `active` carry no rANS state at all.
    if (live && lane < nactive) {
        g_state = load_u32le(s_pay[slot] + uint(lane) * kInitBytesPerLane);
        if (g_state < kRansL) s_ok[slot] = kStatusBadHeader;
        lane_init(lane);
    }
    barrier();
    live = live && s_ok[slot] == kStatusOk;
    if (!live) g_phase = kPhDone;

    // --- cluster mask for the ballot path ----------------------------------
    uvec4 cluster_mask = uvec4(0u);
    if (READ_PTR_MODE == kReadPtrBallot) {
        // [marked edit] LANES-wide cluster, LANES <= subgroupSize (the host
        // selects the LDS fallback otherwise).
        uint base = gl_SubgroupInvocationID & ~(LANES - 1u);
        uint bits = (LANES >= 32u) ? 0xffffffffu : ((1u << LANES) - 1u);
        cluster_mask[base >> 5u] = bits << (base & 31u);
    }

    // --- scheduling rounds --------------------------------------------------
    // The reference walks lanes 0..active-1 in order each round; a lane that is
    // finished simply emits nothing.  Byte consumption therefore follows
    // ascending lane order inside a round, which is exactly a prefix count
    // over the renormalisation ballot.
    uint round = 0u;
    for (;;) {
        int kind = 0, arg = 0;
        bool has_op = live && lane_next(kind, arg);

        uint value = 0u;
        uint x = g_state;
        bool needs = false;
        if (has_op) {
            uint slot1024 = x & kProbMask;
            uint f, c;
            if (kind == 0) {
                uint sym;
                decode_symbol(s_tabbase[slot], arg, slot1024, sym, f, c);
                value = sym;
            } else {
                uint sh = kProbBits - uint(arg);
                value = slot1024 >> sh;
                f = 1u << sh;
                c = value << sh;
            }
            x = f * (x >> kProbBits) + slot1024 - c;
            needs = x < kRansL;
        }

        // --- shared read pointer -------------------------------------------
        // Both modes must produce the same (prefix, total): the number of
        // renormalising lanes strictly below this one inside the tile's
        // 8-lane cluster, and the cluster's total.  Every barrier below is
        // unconditional so that control flow stays workgroup-uniform
        // whichever mode the specialisation constant selects.
        if (READ_PTR_MODE != kReadPtrBallot && needs)
            atomicOr(s_renorm[slot], 1u << uint(lane));  // LANES <= 32
        if (has_op) s_any = 1u;
        barrier();

        uint prefix = 0u, total = 0u;
        if (READ_PTR_MODE == kReadPtrBallot) {
            uvec4 b = subgroupBallot(needs) & cluster_mask;
            prefix = subgroupBallotExclusiveBitCount(b);
            total = subgroupBallotBitCount(b);
        } else {
            uint m = s_renorm[slot];
            prefix = bitCount(m & ((1u << uint(lane)) - 1u));
            total = bitCount(m);
        }

        if (needs) {
            uint at = g_pos + prefix * kRenormBytes;
            if (at + kRenormBytes > g_end) {
                fail(kStatusTruncated);
                has_op = false;
            } else {
                x = (x << 16u) | load_u16be(at);
            }
        }
        g_pos += total * kRenormBytes;

        if (has_op) {
            g_state = x;
            lane_feed(value);
        }

        bool cont = (s_any != 0u);
        barrier();                       // everyone has consumed s_any/s_renorm
        if (in_group && lane == 0) s_renorm[slot] = 0u;
        if (lid == 0u) s_any = 0u;
        barrier();                       // flags clear before the next round
        if (!cont) break;
        if (++round >= kMaxRounds) { fail(kStatusRoundOverflow); break; }
    }

    barrier();
    if (valid && lane == 0) u_status.data[tile] = s_ok[slot];
    // [sparse] Flush the tile's lengths, coalesced, now that every lane of the
    // tile has finished.
    if (valid && pc.sparse != 0u) {
        for (uint i = uint(lane); i < kUnitLenWordsPerTile; i += LANES)
            u_ulen.data[g_ulen_off + i] =
                s_ulen[uint(slot) * kUnitLenWordsPerTile + i];
    }
}
