/* nxvc/version.h -- generated by cmake/nxwarp_version.cmake.  Do not edit.
 *
 * Two numbers, two policies (see RELEASE.md):
 *
 *   NXVC_VERSION_MAJOR/MINOR/PATCH   the LIBRARY version.  SemVer over the
 *       C ABI in <nxvc/nxvc.h> and the C++ component headers.
 *
 *   NXVC_BITSTREAM_VERSION           the WIRE format version, paper 1.2.
 *       This is the value written into the stream header's `version` field.
 *       It moves only when the bitstream changes and is independent of the
 *       library version.  <nxvc/nxvc.h> defines NXVC_VERSION to the same
 *       number; they must agree, and the static assertion below enforces it
 *       whenever both headers are included.
 */
#ifndef NXVC_VERSION_H
#define NXVC_VERSION_H

#define NXVC_VERSION_MAJOR @NXVC_VERSION_MAJOR@
#define NXVC_VERSION_MINOR @NXVC_VERSION_MINOR@
#define NXVC_VERSION_PATCH @NXVC_VERSION_PATCH@

/* "X.Y.Z" */
#define NXVC_VERSION_STRING "@NXVC_VERSION@"

/* "X.Y.Z-<commits>-g<sha>[-dirty]" when built from a tagged git checkout,
 * otherwise identical to NXVC_VERSION_STRING. */
#define NXVC_VERSION_FULL_STRING "@NXVC_VERSION_FULL@"

/* Raw `git describe --tags --dirty --always` output, "" if unavailable. */
#define NXVC_VERSION_GIT_STRING "@NXVC_VERSION_GIT@"

/* Non-zero when the working tree had uncommitted changes at configure time. */
#define NXVC_VERSION_DIRTY @NXVC_VERSION_DIRTY_INT@

/* Encoded as (major * 10000 + minor * 100 + patch) for easy comparison. */
#define NXVC_VERSION_NUMBER \
    (NXVC_VERSION_MAJOR * 10000 + NXVC_VERSION_MINOR * 100 + NXVC_VERSION_PATCH)

/* Paper 1.2 stream header `version` field. */
#define NXVC_BITSTREAM_VERSION @NXWARP_BITSTREAM_VERSION@

/* If <nxvc/nxvc.h> was included first, check the two agree.  Guarded so this
 * header stays usable from C89, from GLSL preprocessing, and on its own. */
#if defined(NXVC_NXVC_H) && defined(NXVC_VERSION)
#if defined(__cplusplus)
static_assert(NXVC_VERSION == NXVC_BITSTREAM_VERSION,
              "nxvc.h NXVC_VERSION and the build's NXWARP_BITSTREAM_VERSION disagree");
#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
_Static_assert(NXVC_VERSION == NXVC_BITSTREAM_VERSION,
               "nxvc.h NXVC_VERSION and the build's NXWARP_BITSTREAM_VERSION disagree");
#endif
#endif

#endif /* NXVC_VERSION_H */
